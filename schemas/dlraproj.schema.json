                "const": "gameValidated"
              }
            }
          },
          "then": {
            "required": [
              "buildFingerprint",
              "captureFingerprint"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "transform": {
      "type": "object",
      "required": [
        "translation",
