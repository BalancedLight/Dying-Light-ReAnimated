            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "morphActivationThreshold": {
          "type": "number",
          "minimum": 0
        },
        "maximumActiveMorphTargets": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "clampMorphWeightsToRigBounds": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "fidelityTier"
            ],
            "properties": {
