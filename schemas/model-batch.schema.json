{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dl-reanimated.local/schemas/model-batch.schema.json",
  "title": "Reviewed DL1 model-package batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "id",
    "compiler",
    "items"
  ],
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset",
        "bindings"
      ],
      "properties": {
        "preset": {
          "$ref": "#/$defs/file"
        },
        "bindings": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "destinationEntityId"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "destinationEntityId": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      }
    }
  },
  "properties": {
    "format": {
      "const": "dl-reanimated-model-batch"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "compiler": {
      "$ref": "#/$defs/file"
    },
    "retailData0": {
      "anyOf": [
        {
          "$ref": "#/$defs/file"
        },
        {
          "type": "null"
        }
      ]
    },
    "compilerWorkingDirectory": {
      "type": [
        "string",
        "null"
      ]
    },
    "additionalToolInputs": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "package",
          "approved"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "package": {
            "$ref": "#/$defs/file"
          },
          "approved": {
            "type": "boolean",
            "default": false
          },
          "setup": {
            "$ref": "#/$defs/setup"
          }
        }
      }
    }
  }
}