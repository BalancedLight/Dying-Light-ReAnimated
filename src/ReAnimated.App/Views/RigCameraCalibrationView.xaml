<UserControl x:Class="ReAnimated.App.Views.RigCameraCalibrationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Margin="5">
  <TextBlock Text="Camera/helper frame calibration" FontWeight="SemiBold"/>
  <Expander Header="Add a missing camera from the reference" Margin="0,3,0,6">
   <StackPanel Margin="5">
    <TextBlock Text="{Binding CameraCreationStatus}" TextWrapping="Wrap" Margin="0,0,0,5"/>
    <TextBlock Text="Reference camera"/>
    <ComboBox ItemsSource="{Binding CameraTemplateChoices}" SelectedItem="{Binding CameraTemplateChoice}" DisplayMemberPath="Name"/>
    <TextBlock Text="Observed reference parent" Margin="0,4,0,0"/>
    <TextBlock Text="{Binding CameraTemplateChoice.ParentName, FallbackValue='-'}"/>
    <TextBlock Text="Target parent" Margin="0,4,0,2"/>
    <ComboBox ItemsSource="{Binding CameraCreationParents}" SelectedItem="{Binding CameraCreationParent}" DisplayMemberPath="Name" ToolTip="Choose explicitly when no unique name match exists."/>
    <Button Content="Preview new camera" Command="{Binding PreviewCameraCreationCommand}" HorizontalAlignment="Left" ToolTip="Uses the reference parent-local frame and offsets. Existing nodes are preserved; name collisions are rejected."/>
   </StackPanel>
  </Expander>
  <TextBlock Text="Camera to recalibrate"/>
  <ComboBox ItemsSource="{Binding CameraNodes}" SelectedItem="{Binding SelectedCameraNode}" DisplayMemberPath="Name" Margin="0,3,0,4"/>
  <TextBlock Text="Parent (read-only)"/>
  <TextBlock Text="{Binding CameraCurrentParent, FallbackValue='-'}" Margin="0,2,0,5"/>
  <TextBlock Text="Source channels"/>
  <TextBlock Text="{Binding CameraCurrentChannels, FallbackValue='-'}" TextWrapping="Wrap" Margin="0,2,0,5"/>
  <TextBlock Text="Local translation offset (metres)"/>
  <UniformGrid Columns="3"><TextBox Text="{Binding CameraOffsetX,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding CameraOffsetY,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding CameraOffsetZ,UpdateSourceTrigger=PropertyChanged}"/></UniformGrid>
  <TextBlock Text="Local rotation offset (degrees)" Margin="0,5,0,0"/>
  <UniformGrid Columns="3"><TextBox Text="{Binding CameraRotationX,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding CameraRotationY,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding CameraRotationZ,UpdateSourceTrigger=PropertyChanged}"/></UniformGrid>
  <WrapPanel Margin="0,6,0,4"><Button Content="Preview frame" Command="{Binding PreviewCameraCalibrationCommand}"/><Button Content="Cancel" Command="{Binding CancelCameraCalibrationCommand}"/><Button Content="Reset draft" Command="{Binding ResetCameraCalibrationCommand}"/></WrapPanel>
  <CheckBox Content="Enable camera review" IsChecked="{Binding CameraReviewEnabled}"/>
  <CheckBox Content="Review the selected animation" IsChecked="{Binding CameraAnimateReview}" Margin="0,4,0,0"/>
  <TextBlock Text="{Binding CameraPoseStatus}" TextWrapping="Wrap" Margin="0,3,0,4"/>
  <TextBlock Text="Preview lens: vertical FOV (degrees) / aspect"/>
  <UniformGrid Columns="2"><TextBox Text="{Binding CameraVerticalFov,UpdateSourceTrigger=LostFocus}"/><TextBox Text="{Binding CameraAspect,UpdateSourceTrigger=LostFocus}"/></UniformGrid>
  <TextBlock Text="Near / far clip distance (metres)" Margin="0,4,0,0"/>
  <UniformGrid Columns="2"><TextBox Text="{Binding CameraNearClip,UpdateSourceTrigger=LostFocus}"/><TextBox Text="{Binding CameraFarClip,UpdateSourceTrigger=LostFocus}"/></UniformGrid>
  <TextBlock Text="Frustum drawing depth (metres)" Margin="0,4,0,0"/>
  <TextBox Text="{Binding CameraFrustumDepth,UpdateSourceTrigger=LostFocus}"/>
  <CheckBox Content="Invert helper up axis" IsChecked="{Binding CameraInvertUp}" Margin="0,4,0,0"/>
  <TextBlock Text="{Binding CameraViewBasis}" TextWrapping="Wrap" Margin="0,3,0,0"/>
  <CheckBox Content="Look through this camera" IsChecked="{Binding CameraLookThrough}" Margin="0,4,0,0"/>
  <TextBlock Text="{Binding CameraLensStatus}" TextWrapping="Wrap" Margin="0,3,0,3"/>
  <TextBlock Text="{Binding CameraPreviewDirection}" TextWrapping="Wrap" Margin="0,4,0,0"/>
  <TextBlock Text="{Binding CameraPreviewRoll}" Margin="0,2,0,0"/>
  <CheckBox Content="I reviewed this camera/helper frame" IsChecked="{Binding CameraReviewed}" Margin="0,6,0,0"/>
  <Button Content="Apply reviewed frame" Command="{Binding ApplyCameraCalibrationCommand}" HorizontalAlignment="Left" Margin="0,5,0,5" ToolTip="Applies the local frame edit. Native camera role and lens behavior require separate validation."/>
  <TextBlock Text="{Binding CameraStatus}" TextWrapping="Wrap"/>
 </StackPanel>
</UserControl>
