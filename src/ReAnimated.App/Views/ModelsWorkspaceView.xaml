<UserControl x:Class="ReAnimated.App.Views.ModelsWorkspaceView"
             x:Name="WorkspaceRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ReAnimated.App.Controls"
             MinWidth="0"
             MinHeight="0">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="215" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="460" MinWidth="400" />
        </Grid.ColumnDefinitions>

        <Border x:Name="AuthoringSettingsPane"
                Grid.Column="0"
                Style="{StaticResource PaneBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Model" />
                    <Button Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            Command="{Binding ReturnToProjectModelsCommand}"
                            Content="Back to project models" />
                    <Button x:Name="ImportFbxButton"
                            Margin="0,4,0,4"
                            MinHeight="34"
                            Command="{Binding ImportFbxCommand}"
                            Content="{Binding ImportFbxActionLabel}"
                            AutomationProperties.Name="Import first FBX model">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasModel}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="OpenPackageButton"
                            Command="{Binding OpenPackageCommand}"
                            Content="Open model..."
                            Margin="0,0,0,8">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasModel}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding SavePackageCommand}" Content="Save model..." Margin="0,0,0,8"
                            Visibility="{Binding HasModel, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <ProgressBar Height="8"
                                 Margin="0,0,0,8"
                                 IsIndeterminate="True">
                        <ProgressBar.Style>
                            <Style TargetType="{x:Type ProgressBar}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <Button Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            Command="{Binding CancelCommand}"
                            Content="Cancel">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <StackPanel Visibility="{Binding HasModel, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Margin="0,6,0,2" Text="Model name" />
                        <TextBox AutomationProperties.Name="Model name"
                                 Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <TextBlock Margin="0,6,0,2" Text="Import rig" />
                    <ComboBox IsEnabled="{Binding CanChangeRigMode}"
                              ItemsSource="{Binding RigModeChoices}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Mode"
                              SelectedValue="{Binding SelectedRigMode, Mode=TwoWay}"
                              AutomationProperties.Name="Import rig"
                              ToolTip="Choose how to read the FBX rig. Pick Adapt or Repair in Setup after importing." />
                    <CheckBox Margin="3,9,3,0"
                              Content="Match DL1 texture origin (flip V)"
                              IsChecked="{Binding FlipTextureCoordinateV}" />

                    <Expander Margin="0,8,0,0" Header="Source files"
                              Visibility="{Binding HasModel, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Margin="2,5,2,2">
                            <Button Command="{Binding ImportFbxCommand}"
                                    Content="Reimport current FBX..." />
                            <Button Command="{Binding ImportNewFbxCommand}"
                                    Content="Add FBX as new model..."
                                    ToolTip="Import this FBX as a separate model." />
                            <Button Command="{Binding OpenPackageCommand}"
                                    Content="Open another model..." />
                        </StackPanel>
                    </Expander>

                    <Expander Margin="0,8,0,0" Header="DL1 resource identity" IsExpanded="False">
                        <!-- These settings decide the character's on-disk identity in a Developer Tools project. -->
                        <StackPanel Margin="2,5,2,2">
                            <TextBlock Margin="0,6,0,2" Text="Character ID" />
                            <TextBox Text="{Binding CharacterId, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Character ID"
                                     ToolTip="Folder name under data/characters in the Developer Tools project." />
                            <TextBlock Margin="0,6,0,2" Text="Model resource name" />
                            <TextBox Text="{Binding ResourceName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Model resource name"
                                     ToolTip="Base name of the emitted .msh / .chr / .bscr / .ascr files." />
                            <TextBlock Margin="0,6,0,2" Text="Surface name" />
                            <TextBox Text="{Binding SurfaceName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Surface name" />
                            <TextBlock Margin="0,6,0,2" Text="Animation bank" />
                            <TextBox Text="{Binding AnimationScriptAlias, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Animation bank"
                                     ToolTip="The animation bank this character drives. Point a player-model replacement at the base-game bank, for example anims_player." />
                            <TextBlock Margin="0,3,0,0"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{Binding AnimationScriptAliasSummary}"
                                       TextWrapping="Wrap" />
                            <CheckBox Margin="0,5,0,0"
                                      Content="Reference existing game animation bank"
                                      IsChecked="{Binding ReferenceExistingAnimationLibrary}"
                                      ToolTip="Emit only the model ASCR redirect. Stock clips remain unchanged; this option does not retarget their bone translations to a different rig. Preview motion before accepting compatibility." />
                        </StackPanel>
                    </Expander>
                    <Expander Margin="0,2,0,0" Header="Preview options" IsExpanded="False">
                        <StackPanel Margin="2,5,2,2">
                            <TextBlock Margin="0,5,0,2" Text="Preview mode" />
                            <ComboBox DisplayMemberPath="Label"
                                      ItemsSource="{Binding PreviewModeChoices}"
                                      SelectedItem="{Binding SelectedPreviewMode}"
                                      AutomationProperties.Name="Preview mode" />
                            <CheckBox Margin="0,5,0,0"
                                      Content="Use reviewed bone channels in preview"
                                      IsChecked="{Binding UseReviewedPolicyPreview}"
                                      IsEnabled="{Binding CanUseReviewedPolicyPreview}"
                                      ToolTip="Use saved position, rotation, and scale choices in the DL1 output preview. Game behavior may differ." />
                            <WrapPanel Margin="0,5,0,4">
                                <Button Command="{Binding FrameModelCommand}" Content="Frame model" />
                                <Button Command="{Binding ResetCameraCommand}" Content="Reset camera" />
                            </WrapPanel>
                            <WrapPanel>
                                <CheckBox Margin="3" Content="Mesh" IsChecked="{Binding ShowMeshes}" />
                                <CheckBox Margin="3" Content="Bones" IsChecked="{Binding ShowBones}" />
                                <CheckBox Margin="3" Content="Helpers" IsChecked="{Binding ShowHelpers}" />
                                <CheckBox Margin="3" Content="Cameras" IsChecked="{Binding ShowCameraHelpers}" />
                                <CheckBox Margin="3" Content="Props" IsChecked="{Binding ShowPropHelpers}" />
                            </WrapPanel>
                        </StackPanel>
                    </Expander>

                    <Border Margin="0,4,0,0"
                            Padding="8"
                            Background="{StaticResource PanelRaisedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            ToolTip="{Binding Summary}">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Right"
                                    Margin="8,0,0,0"
                                    Padding="6,2"
                                    Background="#33445B"
                                    CornerRadius="8">
                                <TextBlock FontSize="10"
                                           Foreground="{StaticResource TextBrush}"
                                           Text="{Binding Diagnostics.Count, StringFormat={}{0} diagnostics}" />
                            </Border>
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="{Binding BuildStatus}"
                                       TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="285" MinHeight="180" />
            </Grid.RowDefinitions>
            <views:ViewportPane x:Name="AuthoringViewportPane"
                                xmlns:views="clr-namespace:ReAnimated.App.Views"
                                DataContext="{Binding Viewport}" />
            <GridSplitter Grid.Row="1" Height="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
            <views:TimelinePanel x:Name="AuthoringTimelinePane"
                                 xmlns:views="clr-namespace:ReAnimated.App.Views"
                                  Grid.Row="2"
                                  DataContext="{Binding Timeline}" />
        </Grid>

        <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" />

        <Border Grid.Column="4" Style="{StaticResource PaneBorderStyle}">
            <TabControl x:Name="AuthoringInspectorTabs">
                <TabItem x:Name="AuthoringConformTab"
                         Header="Setup"
                         IsSelected="{Binding IsConformTabSelected, Mode=TwoWay}">
                    <views:RigConformanceView xmlns:views="clr-namespace:ReAnimated.App.Views"
                                              DataContext="{Binding Conformance}" />
                </TabItem>

                <TabItem x:Name="AuthoringRigTab" Header="Bones">
                    <views:RigHierarchyEditorView xmlns:views="clr-namespace:ReAnimated.App.Views" />
                </TabItem>

                <TabItem x:Name="AuthoringMaterialsTab" Header="Materials">
                    <Grid Margin="7">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListBox Grid.Row="0"
                                 ItemsSource="{Binding Materials}"
                                 SelectedItem="{Binding SelectedMaterial}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="3,4">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock FontSize="10"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding TextureSummary}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="1" Margin="0,7,0,0">
                            <TextBlock Text="Texture channel" />
                            <ComboBox Margin="0,2,0,5"
                                      ItemsSource="{Binding TextureSemantics}"
                                      SelectedItem="{Binding SelectedTextureSemantic}" />
                            <StackPanel Visibility="{Binding IsNormalTextureSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Source normal convention" />
                                <ComboBox Margin="0,2,0,5"
                                          ItemsSource="{Binding NormalMapConventions}"
                                          SelectedItem="{Binding SelectedNormalMapConvention}" />
                            </StackPanel>
                            <Button HorizontalAlignment="Left"
                                    Command="{Binding SelectTextureCommand}"
                                    Content="Choose texture..."
                                    ToolTip="Replaces the embedded FBX texture for the selected channel." />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem x:Name="AuthoringAnimationsTab" Header="Clips">
                    <views:ModelAnimationStacksView xmlns:views="clr-namespace:ReAnimated.App.Views" />
                </TabItem>

                <TabItem x:Name="AuthoringDiagnosticsTab"
                         Header="Issues">
                    <views:ModelDiagnosticsView xmlns:views="clr-namespace:ReAnimated.App.Views" />
                </TabItem>

            </TabControl>
        </Border>
    </Grid>
</UserControl>
