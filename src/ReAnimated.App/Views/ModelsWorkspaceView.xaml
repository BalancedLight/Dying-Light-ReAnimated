<UserControl x:Class="ReAnimated.App.Views.ModelsWorkspaceView"
             x:Name="WorkspaceRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ReAnimated.App.Controls"
             MinWidth="0"
             MinHeight="0">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="245" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="360" MinWidth="285" />
        </Grid.ColumnDefinitions>

        <Border x:Name="AuthoringSettingsPane"
                Grid.Column="0"
                Style="{StaticResource PaneBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Custom model" />
                    <TextBlock Margin="0,3,0,10"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Custom-model authoring is part of the project model library. Importing or previewing here cannot replace an animation target; assign models to immutable sources in Animations."
                               TextWrapping="Wrap" />
                    <Button Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            Command="{Binding ReturnToProjectModelsCommand}"
                            Content="Back to project models" />
                    <WrapPanel Margin="0,0,0,8">
                        <Button x:Name="ImportFbxButton"
                                Command="{Binding ImportFbxCommand}"
                                Content="Import FBX..." />
                        <Button x:Name="OpenPackageButton"
                                Command="{Binding OpenPackageCommand}"
                                Content="Open .dlrmodel..." />
                        <Button Command="{Binding SavePackageCommand}" Content="Save .dlrmodel..." />
                    </WrapPanel>

                    <ProgressBar Height="8"
                                 Margin="0,0,0,8"
                                 IsIndeterminate="True">
                        <ProgressBar.Style>
                            <Style TargetType="{x:Type ProgressBar}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <Button Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            Command="{Binding CancelCommand}"
                            Content="Cancel current operation" />

                    <TextBlock FontWeight="SemiBold" Text="Authoring identity" />
                    <TextBlock Margin="0,6,0,2" Text="Model name" />
                    <TextBox Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,6,0,2" Text="Rig treatment" />
                    <ComboBox IsEnabled="{Binding CanChangeRigMode}"
                              ItemsSource="{Binding RigModes}"
                              SelectedItem="{Binding SelectedRigMode}" />
                    <TextBlock Margin="0,3,0,8"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="ExactFbxRig preserves the imported hierarchy. StaticProp ignores skinning. Dl1HumanoidFit is an explicit retargeting authoring mode; it never silently renames custom bones."
                               TextWrapping="Wrap" />
                    <CheckBox Margin="3,9,3,0"
                              Content="Match DL1 texture origin (flip V)"
                              IsChecked="{Binding FlipTextureCoordinateV}" />

                    <Separator Margin="0,12" />
                    <!-- These four settings decide the character's on-disk
                         identity in a Developer Tools project. They were
                         editable on the view model but rendered nowhere, so
                         the animation bank a model points at was invisible. -->
                    <TextBlock FontWeight="SemiBold" Text="DL1 character identity" />
                    <TextBlock Margin="0,6,0,2" Text="Character ID (data/characters/&lt;id&gt;/)" />
                    <TextBox Text="{Binding CharacterId, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Folder name under data/characters in the Developer Tools project." />
                    <TextBlock Margin="0,6,0,2" Text="Model resource name" />
                    <TextBox Text="{Binding ResourceName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Base name of the emitted .msh / .chr / .bscr / .ascr files." />
                    <TextBlock Margin="0,6,0,2" Text="Surface name" />
                    <TextBox Text="{Binding SurfaceName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,6,0,2" Text="Animation script library (SCR)" />
                    <TextBox Text="{Binding AnimationScriptAlias, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="The animation bank this character drives. Point a player-model replacement at the base-game bank, for example anims_player." />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding AnimationScriptAliasSummary}"
                               TextWrapping="Wrap" />

                    <Separator Margin="0,12" />
                    <TextBlock FontWeight="SemiBold" Text="Preview" />
                    <TextBlock Margin="0,5,0,2" Text="Preview contract" />
                    <ComboBox DisplayMemberPath="Label"
                              ItemsSource="{Binding PreviewModeChoices}"
                              SelectedItem="{Binding SelectedPreviewMode}" />
                    <WrapPanel Margin="0,5,0,4">
                        <Button Command="{Binding FrameModelCommand}" Content="Frame model" />
                        <Button Command="{Binding ResetCameraCommand}" Content="Reset camera" />
                    </WrapPanel>
                    <WrapPanel>
                        <CheckBox Margin="3" Content="Mesh" IsChecked="{Binding ShowMeshes}" />
                        <CheckBox Margin="3" Content="Bones" IsChecked="{Binding ShowBones}" />
                        <CheckBox Margin="3" Content="Helpers" IsChecked="{Binding ShowHelpers}" />
                        <CheckBox Margin="3" Content="Cameras" IsChecked="{Binding ShowCameraHelpers}" />
                        <CheckBox Margin="3" Content="Props" IsChecked="{Binding ShowPropHelpers}" />
                    </WrapPanel>

                    <Border Margin="0,12,0,0"
                            Padding="8"
                            Background="#202A39"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                    </Border>
                    <Border Margin="0,6,0,0"
                            Padding="8"
                            Background="{StaticResource PanelRaisedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Right"
                                    Margin="8,0,0,0"
                                    Padding="6,2"
                                    Background="#33445B"
                                    CornerRadius="8">
                                <TextBlock FontSize="10"
                                           Foreground="{StaticResource TextBrush}"
                                           Text="{Binding Diagnostics.Count, StringFormat={}{0} diagnostics}" />
                            </Border>
                            <TextBlock Foreground="{StaticResource TextBrush}"
                                       Text="{Binding BuildStatus}"
                                       TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="285" MinHeight="180" />
            </Grid.RowDefinitions>
            <views:ViewportPane x:Name="AuthoringViewportPane"
                                xmlns:views="clr-namespace:ReAnimated.App.Views"
                                DataContext="{Binding Viewport}" />
            <GridSplitter Grid.Row="1" Height="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
            <views:TimelinePanel x:Name="AuthoringTimelinePane"
                                 xmlns:views="clr-namespace:ReAnimated.App.Views"
                                  Grid.Row="2"
                                  DataContext="{Binding Timeline}" />
        </Grid>

        <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" />

        <Border Grid.Column="4" Style="{StaticResource PaneBorderStyle}">
            <TabControl x:Name="AuthoringInspectorTabs">
                <TabItem x:Name="AuthoringRigTab" Header="Rig">
                    <Grid Margin="7">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="2,0,2,6"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Weighted nodes are deform bones. Connected unweighted nodes remain helpers; custom names and exact bind matrices are preserved."
                                   TextWrapping="Wrap" />
                        <DataGrid Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding Bones}"
                                  SelectedItem="{Binding SelectedBone}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="42" Binding="{Binding Index}" Header="#" />
                                <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="Bone / helper" />
                                <DataGridTextColumn Width="72" Binding="{Binding Role}" Header="Role" />
                                <DataGridCheckBoxColumn Width="55"
                                                        Binding="{Binding IsWeighted, Mode=OneWay}"
                                                        Header="Skin" />
                                <DataGridCheckBoxColumn Width="64"
                                                        Binding="{Binding IsAuthored, Mode=OneWay}"
                                                        Header="Authored" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="2" Margin="0,7,0,0">
                            <TextBlock FontWeight="SemiBold" Text="Helper and camera authoring" />
                            <TextBlock Margin="0,2,0,5"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Duplicate keeps imported deform hierarchy immutable. The new unweighted child begins at the selected node's global bind transform."
                                       TextWrapping="Wrap" />
                            <WrapPanel>
                                <ComboBox Width="92"
                                          ItemsSource="{Binding HelperKinds}"
                                          SelectedItem="{Binding SelectedHelperKind}" />
                                <TextBox Width="125"
                                         Margin="4,0"
                                         ToolTip="Optional helper name"
                                         Text="{Binding NewHelperName, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Command="{Binding DuplicateSelectedAsHelperCommand}"
                                        Content="Duplicate as Helper" />
                            </WrapPanel>
                            <WrapPanel Margin="0,5,0,0">
                                <Button Command="{Binding SelectPreviewCameraCommand}"
                                        Content="Use selected as camera..." />
                                <Button Command="{Binding UndoHelperEditCommand}"
                                        Content="Undo helper edit" />
                            </WrapPanel>
                            <TextBlock Margin="0,3,0,5"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{Binding PreviewCameraStatus}"
                                       TextWrapping="Wrap" />
                            <StackPanel IsEnabled="{Binding CanEditSelectedHelper}">
                                <TextBlock FontSize="10" Text="Local translation offset (X / Y / Z)" />
                                <controls:ResponsiveUniformGrid PreferredColumns="3" Margin="0,2,0,4">
                                    <TextBox Text="{Binding HelperTranslationX, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Margin="3,0" Text="{Binding HelperTranslationY, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Text="{Binding HelperTranslationZ, UpdateSourceTrigger=PropertyChanged}" />
                                </controls:ResponsiveUniformGrid>
                                <TextBlock FontSize="10" Text="Local rotation offset in degrees (X / Y / Z)" />
                                <controls:ResponsiveUniformGrid PreferredColumns="3" Margin="0,2,0,4">
                                    <TextBox Text="{Binding HelperRotationX, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Margin="3,0" Text="{Binding HelperRotationY, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Text="{Binding HelperRotationZ, UpdateSourceTrigger=PropertyChanged}" />
                                </controls:ResponsiveUniformGrid>
                                <Button HorizontalAlignment="Left"
                                        Command="{Binding ApplyHelperTransformCommand}"
                                        Content="Apply local offsets" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem x:Name="AuthoringConformTab"
                         Header="Conform"
                         IsSelected="{Binding IsConformTabSelected, Mode=TwoWay}">
                    <views:RigConformanceView xmlns:views="clr-namespace:ReAnimated.App.Views"
                                              DataContext="{Binding Conformance}" />
                </TabItem>

                <TabItem x:Name="AuthoringMaterialsTab" Header="Materials">
                    <Grid Margin="7">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="2,0,2,6"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Embedded FBX textures are used automatically. Override base color, normal, specular, or mask independently. Normal maps are repacked to DL1's alpha/green convention during build."
                                   TextWrapping="Wrap" />
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Materials}"
                                 SelectedItem="{Binding SelectedMaterial}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="3,4">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock FontSize="10"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding TextureSummary}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" Margin="0,7,0,0">
                            <TextBlock Text="Texture channel" />
                            <ComboBox Margin="0,2,0,5"
                                      ItemsSource="{Binding TextureSemantics}"
                                      SelectedItem="{Binding SelectedTextureSemantic}" />
                            <StackPanel Visibility="{Binding IsNormalTextureSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Source normal convention" />
                                <ComboBox Margin="0,2,0,5"
                                          ItemsSource="{Binding NormalMapConventions}"
                                          SelectedItem="{Binding SelectedNormalMapConvention}" />
                            </StackPanel>
                            <Button HorizontalAlignment="Left"
                                    Command="{Binding SelectTextureCommand}"
                                    Content="Choose texture..." />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem x:Name="AuthoringDiagnosticsTab"
                         Header="{Binding Diagnostics.Count, StringFormat=Diagnostics ({0})}">
                    <Grid Margin="7">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="2,0,2,6"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Import, texture, DL1-output, and repair diagnostics. Warnings remain visible until their underlying binding or build condition is resolved."
                                   TextWrapping="Wrap" />
                        <DataGrid Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding Diagnostics}">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="72" Binding="{Binding Severity}" Header="Severity" />
                                <DataGridTextColumn Width="150" Binding="{Binding Code}" Header="Code" />
                                <DataGridTextColumn Width="120" Binding="{Binding Subject}" Header="Subject" />
                                <DataGridTextColumn Width="*" Binding="{Binding Message}" Header="Message" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="AuthoringAnimationsTab" Header="Animation stacks">
                    <Grid Margin="7">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="2,0,2,6"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Every FBX animation stack is listed and selected by default. Names, cadence, root policy, and root bone are editable per stack."
                                   TextWrapping="Wrap" />
                        <DataGrid Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  ItemsSource="{Binding Animations}"
                                  SelectedItem="{Binding SelectedAnimation}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Width="42" Binding="{Binding Included, UpdateSourceTrigger=PropertyChanged}" Header="Use" />
                                <DataGridTextColumn Width="*" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Header="DL1 name" />
                                <DataGridTextColumn Width="58" Binding="{Binding FrameRateNumerator, UpdateSourceTrigger=PropertyChanged}" Header="FPS num" />
                                <DataGridTextColumn Width="58" Binding="{Binding FrameRateDenominator, UpdateSourceTrigger=PropertyChanged}" Header="FPS den" />
                                <DataGridTemplateColumn Width="100" Header="Root policy">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.RootMotionModes, ElementName=WorkspaceRoot}"
                                                      SelectedItem="{Binding RootMotionMode, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="100" Header="Root bone">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox IsEditable="True"
                                                      ItemsSource="{Binding DataContext.RootBoneNames, ElementName=WorkspaceRoot}"
                                                      Text="{Binding RootBoneName, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="2" Margin="0,7,0,0">
                            <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                       Text="{Binding SelectedAnimation.DecodeStatus}"
                                       TextWrapping="Wrap" />
                            <Button Margin="0,6,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding OpenSelectedAnimationInAnimateCommand}"
                                    Content="Play selected in Playback" />
                        </StackPanel>
                    </Grid>
                </TabItem>

            </TabControl>
        </Border>
    </Grid>
</UserControl>
