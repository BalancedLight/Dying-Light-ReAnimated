<UserControl x:Class="ReAnimated.App.Views.ModelAnimationStacksView"
             x:Name="AnimationStacksRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="0"
             MinHeight="0">
    <Grid Margin="7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="2,0,2,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="Create a clip at the rig bind pose, then add keys in Animate."
                       TextWrapping="Wrap" />
            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    Command="{Binding CreateAuthoredAnimationCommand}"
                    Content="New animation…" />
        </Grid>
        <DataGrid Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  ItemsSource="{Binding Animations}"
                  SelectedItem="{Binding SelectedAnimation}">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Width="42" Binding="{Binding Included, UpdateSourceTrigger=PropertyChanged}" Header="Use" />
                <DataGridTextColumn Width="80" Binding="{Binding OriginLabel}" IsReadOnly="True" Header="Origin" />
                <DataGridTextColumn Width="*" MinWidth="140" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Header="DL1 name" />
                <DataGridTextColumn Width="58" Binding="{Binding FrameRateNumerator, UpdateSourceTrigger=PropertyChanged}" Header="FPS num" />
                <DataGridTextColumn Width="58" Binding="{Binding FrameRateDenominator, UpdateSourceTrigger=PropertyChanged}" Header="FPS den" />
                <DataGridTemplateColumn Width="100" Header="Root policy">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.RootMotionModes, ElementName=AnimationStacksRoot}"
                                      SelectedItem="{Binding RootMotionMode, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="100" Header="Root bone">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox IsEditable="True"
                                      ItemsSource="{Binding DataContext.RootBoneNames, ElementName=AnimationStacksRoot}"
                                      Text="{Binding RootBoneName, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Margin="0,7,0,0">
            <TextBlock Foreground="{StaticResource MutedTextBrush}"
                       Text="{Binding SelectedAnimation.DecodeStatus}"
                       TextWrapping="Wrap" />
            <Button Margin="0,6,0,0"
                    HorizontalAlignment="Left"
                    Command="{Binding OpenSelectedAnimationInAnimateCommand}"
                    Content="Play selected clip" />
            <Button Margin="0,6,0,0" HorizontalAlignment="Left"
                    Command="{Binding PrepareSelectedAnimationCommand}" Content="Prepare animation" />
            <Expander Header="Review animation" Margin="0,6,0,0"
                      IsExpanded="{Binding Conformance.DerivedPreviewEnabled}">
                <views:RigDerivedMotionView xmlns:views="clr-namespace:ReAnimated.App.Views"
                                            DataContext="{Binding Conformance}" />
            </Expander>
        </StackPanel>
    </Grid>
</UserControl>
