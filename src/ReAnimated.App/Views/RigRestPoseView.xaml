<UserControl x:Class="ReAnimated.App.Views.RigRestPoseView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:ReAnimated.App.Views">
 <StackPanel Margin="5">
  <TextBlock Text="Joint rest-pose edit" FontWeight="SemiBold"/>
  <TextBlock Text="Joint"/><ComboBox ItemsSource="{Binding RestPoseNodes}" SelectedItem="{Binding RestPoseNode}" DisplayMemberPath="Name" Margin="0,3,0,6"/>
  <TextBlock Text="Surface operation"/><ComboBox ItemsSource="{Binding RestSurfaceChoices}" SelectedItem="{Binding RestSurfaceMode}" DisplayMemberPath="Label" Margin="0,3,0,6"/>
  <TextBlock Text="Child joints and helpers"/><ComboBox ItemsSource="{Binding RestDescendantChoices}" SelectedItem="{Binding RestDescendantMode}" DisplayMemberPath="Label" Margin="0,3,0,6"/>
  <TextBlock Text="Joint position in model coordinates (metres)" TextWrapping="Wrap"/><views:ContactVectorView DataContext="{Binding RestPosePosition}"/>
  <TextBlock Text="Rotation offset about the current frame (degrees)" TextWrapping="Wrap"/><views:ContactVectorView DataContext="{Binding RestPoseRotation}"/>
  <TextBlock Text="Positive scale multipliers in the current frame" TextWrapping="Wrap"/><views:ContactVectorView DataContext="{Binding RestPoseScale}"/>
  <WrapPanel Margin="0,5,0,6"><Button Content="Preview rest edit" Command="{Binding PreviewRestPoseCommand}"/><Button Content="Cancel" Command="{Binding CancelRestPoseCommand}"/><Button Content="Clear preview" Command="{Binding ClearRestPoseCommand}"/></WrapPanel>
  <CheckBox Content="Show draft rest edit" IsChecked="{Binding RestPosePreviewEnabled}"/>
  <TextBlock Text="{Binding RestPoseStatus}" TextWrapping="Wrap" Margin="0,5,0,6"/>
  <Button Content="Apply reviewed rest edit" Command="{Binding ApplyRestPoseCommand}" HorizontalAlignment="Left" ToolTip="Creates one undoable edit. Animation curves are retained; review motion and native binding after a rest-frame change. Locked guide/helper fields must be unlocked explicitly."/>
 </StackPanel>
</UserControl>
