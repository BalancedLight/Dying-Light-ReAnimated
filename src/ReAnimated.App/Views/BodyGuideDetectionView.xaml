<UserControl x:Class="ReAnimated.App.Views.BodyGuideDetectionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="0"><StackPanel Margin="4">
                            <CheckBox Content="Anatomical left follows +X" IsChecked="{Binding BodyLeftIsPositiveX}" Margin="0,5,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                                <TextBlock Text="Sampling resolution" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Width="55" Text="{Binding BodyDetectionResolution, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <WrapPanel>
                                <Button Content="Detect body guides" Command="{Binding DetectBodyCommand}" />
                                <Button Content="Cancel" Command="{Binding CancelBodyDetectionCommand}" Margin="5,0,0,0" />
                                <Button Content="Use draft guides" Command="{Binding UseBodyGuidesCommand}" Margin="5,0,0,0" />
                            </WrapPanel>
                            <TextBlock Text="{Binding BodyDetectionStatus}" TextWrapping="Wrap" Margin="0,7,0,7" />
                            <DataGrid ItemsSource="{Binding BodyProposals}" SelectedItem="{Binding SelectedBodyProposal}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MaxHeight="230">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Guide" Binding="{Binding Role}" Width="*" />
                                    <DataGridTextColumn Header="X" Binding="{Binding Position.X, StringFormat=F3}" Width="65" />
                                    <DataGridTextColumn Header="Y" Binding="{Binding Position.Y, StringFormat=F3}" Width="65" />
                                    <DataGridTextColumn Header="Z" Binding="{Binding Position.Z, StringFormat=F3}" Width="65" />
                                </DataGrid.Columns>
                            </DataGrid>
</StackPanel></UserControl>
