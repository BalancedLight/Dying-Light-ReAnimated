<UserControl x:Class="ReAnimated.App.Views.RigWeightEditingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="0">
    <StackPanel Margin="4,8,4,4">
        <WrapPanel Margin="0,0,0,6">
            <Button Content="Inspect weights" Command="{Binding InspectWeightsCommand}" Margin="0,0,6,0" />
            <Button Content="Cancel" Command="{Binding CancelWeightJobCommand}" />
        </WrapPanel>
        <TextBlock Text="{Binding WeightEditingStatus}" TextWrapping="Wrap" Margin="0,0,0,6" />
        <Expander Header="Edit weights" IsEnabled="{Binding CanCorrectWeights}" Margin="0,0,0,7">
        <StackPanel Margin="6,7,2,3">
            <TextBlock Text="Influence" />
            <ComboBox ItemsSource="{Binding WeightInfluences}" SelectedItem="{Binding SelectedWeightInfluence}" DisplayMemberPath="Name" Margin="0,2,0,5" />
            <CheckBox Content="Show influence heatmap" IsChecked="{Binding ShowWeightHeatmap}" />
            <TextBlock Text="Blue: 0 · Yellow: 0.5 · Red: 1. Preview shows pending changes."
                       TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,8" />
            <TextBlock Text="Component" />
            <ComboBox ItemsSource="{Binding WeightComponents}" SelectedItem="{Binding SelectedWeightComponent}" DisplayMemberPath="Name" Margin="0,2,0,5" />
            <TextBlock Text="Source point numbers (e.g. 0, 4, 10-20)" TextWrapping="Wrap" />
            <TextBox Text="{Binding WeightSourcePoints, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" />
            <CheckBox Content="Use every rendered point in this component" IsChecked="{Binding WholeWeightComponent}" Margin="0,0,0,5" />
            <WrapPanel>
                <Button Content="Lock influence on selection" Command="{Binding LockWeightInfluenceCommand}" Margin="0,0,6,4" />
                <Button Content="Unlock influence on selection" Command="{Binding UnlockWeightInfluenceCommand}" Margin="0,0,6,4" />
            </WrapPanel>
            <TextBlock Text="Locked influences keep their current weights, including zero."
                       TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,8" />
            <TextBlock Text="Correction" />
            <ComboBox ItemsSource="{Binding WeightOperations}" SelectedItem="{Binding WeightOperation}" DisplayMemberPath="Label" Margin="0,2,0,6" />
            <WrapPanel>
                <StackPanel Width="135" Margin="0,0,8,5"><TextBlock Text="Target weight (0–1)" /><TextBox Text="{Binding WeightTargetValue, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                <StackPanel Width="135" Margin="0,0,8,5"><TextBlock Text="Strength (0–1)" /><TextBox Text="{Binding WeightEditStrength, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                <StackPanel Width="135" Margin="0,0,8,5"><TextBlock Text="Smoothing iterations" /><TextBox Text="{Binding WeightSmoothIterations, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
            </WrapPanel>
            <TextBlock Text="Set to 1 for rigid weighting. Smoothing follows mesh edges. Up to four influences are kept per point; removed weight appears below."
                       TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,5" />
            <Expander Header="Mirror plane and influence pairing" Margin="0,4,0,6">
                <StackPanel Margin="4,5,4,4">
                    <CheckBox Content="Mirror set-weight edits and brush strokes" IsChecked="{Binding MirrorWeightEdits}" />
                    <TextBlock Text="Opposite influence (same bone for a center influence)" TextWrapping="Wrap" Margin="0,5,0,2" />
                    <ComboBox ItemsSource="{Binding WeightInfluences}" SelectedItem="{Binding WeightMirrorInfluence}" DisplayMemberPath="Name" />
                    <TextBlock Text="Plane origin in model metres" Margin="0,6,0,2" />
                    <WrapPanel>
                        <TextBox Width="80" Text="{Binding WeightMirrorOriginX, UpdateSourceTrigger=PropertyChanged}" ToolTip="Origin X" />
                        <TextBox Width="80" Text="{Binding WeightMirrorOriginY, UpdateSourceTrigger=PropertyChanged}" ToolTip="Origin Y" />
                        <TextBox Width="80" Text="{Binding WeightMirrorOriginZ, UpdateSourceTrigger=PropertyChanged}" ToolTip="Origin Z" />
                    </WrapPanel>
                    <TextBlock Text="Plane normal (X, Y, Z)" Margin="0,5,0,2" />
                    <WrapPanel>
                        <TextBox Width="80" Text="{Binding WeightMirrorNormalX, UpdateSourceTrigger=PropertyChanged}" ToolTip="Normal X" />
                        <TextBox Width="80" Text="{Binding WeightMirrorNormalY, UpdateSourceTrigger=PropertyChanged}" ToolTip="Normal Y" />
                        <TextBox Width="80" Text="{Binding WeightMirrorNormalZ, UpdateSourceTrigger=PropertyChanged}" ToolTip="Normal Z" />
                    </WrapPanel>
                    <TextBlock Text="Matching tolerance in metres" Margin="0,5,0,2" />
                    <TextBox Width="100" HorizontalAlignment="Left" Text="{Binding WeightMirrorTolerance, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Saving replaces prior pairings for these influences and updates the model's mirror plane."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,4" />
                    <Button Content="Save mirror settings" Command="{Binding SaveWeightMirroringCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Expander>
            <CheckBox Content="Paint weights in the viewport" IsChecked="{Binding WeightBrushEnabled}" Margin="0,4,0,4" />
            <WrapPanel><TextBlock Text="Brush radius (metres)" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBox Width="90" Text="{Binding WeightBrushRadius, UpdateSourceTrigger=PropertyChanged}" /></WrapPanel>
            <TextBlock Text="Paint in the source rest view. Drag with the left mouse button; release to apply or press Escape to cancel."
                       TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,7" />
            <WrapPanel>
                <Button Content="Preview correction" Command="{Binding PreviewWeightCorrectionCommand}" Margin="0,0,6,5" />
                <Button Content="Apply correction" Command="{Binding ApplyWeightCorrectionCommand}" Margin="0,0,6,5" />
            </WrapPanel>
        </StackPanel>
        </Expander>
        <Expander Header="Point review">
        <StackPanel Margin="5,6,2,3">
        <DataGrid ItemsSource="{Binding WeightPointReviews}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  Height="160" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Point" Binding="{Binding SourcePoint}" Width="55" />
                <DataGridCheckBoxColumn Header="Locked" Binding="{Binding InfluenceLocked}" Width="60" />
                <DataGridTextColumn Header="Before" Binding="{Binding Before}" Width="170" />
                <DataGridTextColumn Header="After" Binding="{Binding After}" Width="170" />
                <DataGridTextColumn Header="Removed weight" Binding="{Binding RemovedWeight, StringFormat=0.######}" Width="105" />
                <DataGridTextColumn Header="Initial bind loss" Binding="{Binding InitialBindingRemovedWeight, StringFormat=0.######}" Width="105" />
                <DataGridTextColumn Header="Source rounding" Binding="{Binding SourceRoundingError, StringFormat=0.########}" Width="105" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="Initial bind loss records weight removed during automatic binding. Source rounding records export precision loss. Use Undo to restore edits, then check the result in Joint stress poses."
                   TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
        </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
