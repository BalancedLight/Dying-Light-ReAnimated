<UserControl x:Class="ReAnimated.App.Views.RigGripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ReAnimated.App.Views">
    <StackPanel Margin="4">
        <TextBlock Text="Place hand grips from the fitted palms, then adjust the position and orientation for your prop."
                   TextWrapping="Wrap" Margin="0,0,0,6" />
        <WrapPanel>
            <Button Content="Place grips in palms" Command="{Binding FitHandGripsCommand}"
                    ToolTip="Keeps saved manual adjustments." />
            <Button Content="Recalibrate hand grips" Command="{Binding RecalibrateHandGripsCommand}"
                    ToolTip="Replace unlocked manual hand-grip adjustments using the current fitted palms." />
        </WrapPanel>
        <ComboBox ItemsSource="{Binding GripHelpers}" SelectedItem="{Binding SelectedGrip}"
                  DisplayMemberPath="Label" Margin="0,6,0,5" />
        <StackPanel IsEnabled="{Binding CanEditGripFrame}">
            <TextBlock Text="Position relative to the hand (metres, X / Y / Z)" TextWrapping="Wrap" />
            <views:ContactVectorView DataContext="{Binding GripTranslation}" />
            <TextBlock Text="Rotation relative to the hand (degrees, X / Y / Z)" TextWrapping="Wrap" />
            <views:ContactVectorView DataContext="{Binding GripRotation}" />
            <Button Content="Save grip adjustment" Command="{Binding ApplyGripFrameCommand}"
                    HorizontalAlignment="Left" />
        </StackPanel>
        <TextBlock Text="{Binding GripStatus}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Foreground="{StaticResource MutedTextBrush}" />
    </StackPanel>
</UserControl>
