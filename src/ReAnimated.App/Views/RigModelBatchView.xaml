<UserControl x:Class="ReAnimated.App.Views.RigModelBatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ReAnimated.App.Views"
             SnapsToDevicePixels="True">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="8">
      <TextBlock Text="Reviewed model batches" FontSize="16" FontWeight="SemiBold" />
      <TextBlock Text="Add model packages, review each one, then run the batch."
                 TextWrapping="Wrap" Margin="0,4,0,8" />

      <WrapPanel Margin="0,0,0,6">
        <Button Content="New batch" Command="{Binding NewBatchCommand}" />
        <Button Content="Open queue..." Command="{Binding LoadQueueCommand}" />
        <Button Content="Save queue..." Command="{Binding SaveQueueCommand}" />
        <Button Content="Add package..." Command="{Binding AddPackageCommand}" />
        <Button Content="Remove selected" Command="{Binding RemoveSelectedCommand}" />
        <Button Content="Refresh selected" Command="{Binding RefreshSelectedCommand}" />
      </WrapPanel>

      <ListBox ItemsSource="{Binding Items}"
               SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
               MaxHeight="280"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               IsEnabled="{Binding CanEdit}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="{Binding Name, FallbackValue='Unnamed package'}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding StateLabel, FallbackValue='Pending'}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SetupSummary}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
              </StackPanel>
              <CheckBox Grid.Column="1" Content="Approved" IsChecked="{Binding Approved, Mode=TwoWay}"
                        IsEnabled="{Binding IsEditable}" VerticalAlignment="Top" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Expander Header="Selected package details" Margin="0,8,0,0">
        <StackPanel Margin="6">
          <TextBlock Text="{Binding SelectedItem.Name, FallbackValue='No package selected'}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SelectedItem.Path, FallbackValue='No package path'}" TextWrapping="Wrap" Margin="0,3,0,0" />
          <TextBlock Text="SHA-256" Margin="0,5,0,0" />
          <TextBlock Text="{Binding SelectedItem.Sha256, FallbackValue='No hash recorded'}" TextWrapping="Wrap" />
          <TextBlock Text="State" Margin="0,5,0,0" />
          <TextBlock Text="{Binding SelectedItem.StateLabel, FallbackValue='Pending'}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SelectedItem.Message, FallbackValue='Select a package to inspect its recorded status.'}" TextWrapping="Wrap" Margin="0,3,0,0" />
        </StackPanel>
      </Expander>

      <Expander Header="Reusable setup" IsEnabled="{Binding CanEdit}" Margin="0,6,0,0"><views:ModelBatchSetupView/></Expander>

      <Expander Header="Build settings" IsEnabled="{Binding CanEdit}" Margin="0,6,0,0">
        <StackPanel Margin="6">
          <TextBlock Text="Compiler executable" />
          <DockPanel Margin="0,2,0,5">
            <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding SelectCompilerCommand}" />
            <TextBox Text="{Binding CompilerPath, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
          </DockPanel>
          <TextBlock Text="Retail Data0.pak (optional)" />
          <DockPanel Margin="0,2,0,5">
            <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding SelectRetailDataCommand}" />
            <TextBox Text="{Binding RetailData0Path, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
          </DockPanel>
          <TextBlock Text="Compiler working directory (optional)" />
          <DockPanel Margin="0,2,0,5">
            <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding SelectCompilerWorkCommand}" />
            <TextBox Text="{Binding CompilerWorkingDirectory, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
          </DockPanel>
          <TextBlock Text="Output directory" />
          <DockPanel Margin="0,2,0,0">
            <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding SelectOutputCommand}" />
            <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
          </DockPanel>
        </StackPanel>
      </Expander>

      <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}" Margin="0,9,0,0" Padding="0,7,0,0">
        <StackPanel>
          <WrapPanel>
            <Button Content="Run or resume batch" Command="{Binding RunCommand}" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" />
            <Button Content="Inspect receipt" Command="{Binding InspectReceiptCommand}" />
          </WrapPanel>
          <TextBlock Text="{Binding Status, FallbackValue='Ready'}" TextWrapping="Wrap" Margin="0,5,0,0" />
          <TextBlock TextWrapping="Wrap"><Run Text="Receipt: " /><Run Text="{Binding ReceiptPath, Mode=OneWay, FallbackValue='Not recorded'}" /></TextBlock>
          <TextBlock TextWrapping="Wrap"><Run Text="Manifest: " /><Run Text="{Binding ManifestPath, Mode=OneWay, FallbackValue='Not saved'}" /></TextBlock>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
