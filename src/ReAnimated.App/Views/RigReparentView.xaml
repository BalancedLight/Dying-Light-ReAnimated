<UserControl x:Class="ReAnimated.App.Views.RigReparentView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Margin="5">
  <TextBlock Text="Change a joint's parent" FontWeight="SemiBold"/>
  <TextBlock Text="Keep the joint, surface and attached helpers in their current rest positions while changing the parent relationship. Skin palettes and animation tracks follow stable bone identities when row order changes." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,7"/>
  <TextBlock Text="Joint or source helper"/><ComboBox ItemsSource="{Binding HierarchyNodes}" SelectedItem="{Binding HierarchyNode}" DisplayMemberPath="Name" Margin="0,3,0,5"/>
  <TextBlock Text="{Binding HierarchyCurrentParent, StringFormat='Current parent: {0}'}" TextWrapping="Wrap" Margin="0,0,0,6"/>
  <TextBlock Text="New parent"/><ComboBox ItemsSource="{Binding HierarchyParents}" SelectedItem="{Binding HierarchyParent}" DisplayMemberPath="Name" Margin="0,3,0,6"/>
  <WrapPanel><Button Content="Preview parent change" Command="{Binding PreviewHierarchyCommand}"/><Button Content="Cancel" Command="{Binding CancelHierarchyCommand}"/><Button Content="Clear" Command="{Binding ClearHierarchyCommand}"/></WrapPanel>
  <CheckBox Content="Show draft hierarchy" IsChecked="{Binding HierarchyPreviewEnabled}" Margin="0,5,0,5"/>
  <TextBlock Text="Grey shows the previous parent link; cyan shows the proposed link." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
  <TextBlock Text="{Binding HierarchyStatus}" TextWrapping="Wrap" Margin="0,5,0,6"/>
  <Button Content="Apply reviewed parent change" Command="{Binding ApplyHierarchyCommand}" HorizontalAlignment="Left"/>
  <TextBlock Text="Changing ancestry changes how local animation curves behave. Their original values are retained; review motion and native parent requirements before export acceptance. Source helper locks remain enforced." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
 </StackPanel>
</UserControl>
