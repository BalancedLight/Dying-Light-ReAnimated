<UserControl x:Class="ReAnimated.App.Views.GeneratedSkinBindingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="0">
    <StackPanel Margin="4">
        <TextBlock Text="Generated rigs can retain current weights, bind automatically, or assign components rigidly. Save choices before binding." TextWrapping="Wrap" Margin="0,0,0,6" />
        <ItemsControl ItemsSource="{Binding BodyComponents}" IsEnabled="{Binding CanEditBodyComponentChoices}">
            <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,6">
                <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
                <WrapPanel>
                    <ComboBox Width="150" Margin="0,2,6,4" DisplayMemberPath="Label" SelectedValuePath="Mode" SelectedValue="{Binding BindingMode}" ItemsSource="{Binding DataContext.BodyBindingModes, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <ComboBox Width="155" Margin="0,2,0,4" SelectedItem="{Binding RigidBoneRoleId}" ItemsSource="{Binding DataContext.BodyBindingRoles, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="Rigid assignment role" />
                </WrapPanel>
            </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <WrapPanel><Button Content="Save binding choices" Command="{Binding SaveBodyComponentsCommand}" /><Button Content="Bind selected geometry" Command="{Binding BindBodyGeometryCommand}" /><Button Content="Cancel job" Command="{Binding CancelBodyAuthoringCommand}" /></WrapPanel>
        <WrapPanel Margin="0,5,0,4"><TextBlock Text="Weight falloff" VerticalAlignment="Center" Margin="0,0,7,0" /><TextBox Width="70" Text="{Binding BindingFalloffPower, UpdateSourceTrigger=LostFocus}" /></WrapPanel>
        <TextBlock Text="{Binding BodyAuthoringStatus}" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
