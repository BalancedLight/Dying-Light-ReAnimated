<UserControl x:Class="ReAnimated.App.Views.ViewportPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:renderer="clr-namespace:ReAnimated.Renderer.D3D11;assembly=ReAnimated.Renderer.D3D11"
             MinWidth="220"
             MinHeight="180">
    <Border Style="{StaticResource PaneBorderStyle}">
        <!-- All WPF controls intentionally sit in rows outside the HwndHost airspace. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource PanelRaisedBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="9,0" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                    <TextBlock FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding FidelityLabel}" />
                </StackPanel>
                <Border Grid.Column="1"
                        Margin="4"
                        Padding="7,2"
                        Background="#3C2F1C"
                        CornerRadius="9"
                        ToolTip="Software rendering fallback is active">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=RenderSurface, Path=IsUsingWarp}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontSize="10" Foreground="{StaticResource WarningBrush}" Text="WARP" />
                </Border>
            </Grid>

            <renderer:D3D11RenderHost x:Name="RenderSurface"
                                      Grid.Row="1"
                                      SceneSource="{Binding SceneSource}"
                                      Focusable="True" />

            <Border Grid.Row="1"
                    MaxWidth="520"
                    Margin="24"
                    Padding="14,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="#DD331A1D"
                    BorderBrush="{StaticResource ErrorBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DiagnosticOverlay}"
                                         Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Foreground="{StaticResource ErrorBrush}"
                           FontWeight="SemiBold"
                           Text="{Binding DiagnosticOverlay}"
                           TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="1"
                  IsHitTestVisible="False">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCameraViewActive}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="12"
                        Padding="7,3"
                        Background="#99151A22"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="3">
                    <TextBlock Foreground="{StaticResource AccentBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Text="EYE CAMERA" />
                </Border>
                <Grid Width="26" Height="26"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Border Width="1" Height="26"
                            Background="#99DDE8F0" />
                    <Border Width="26" Height="1"
                            Background="#99DDE8F0" />
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Background="#151A22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="8,0"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding ElementName=RenderSurface, Path=StatusText}" />
                <TextBlock Grid.Column="1"
                           Margin="5,0"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="L orbit · M pan · wheel zoom"
                           ToolTip="Left-drag orbits. Middle-drag pans. The mouse wheel zooms. An evaluated EyeCamera or movie camera locks only the pane that uses it." />
                <TextBlock Grid.Column="2"
                           Margin="8,0"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding ElementName=RenderSurface, Path=FramesPerSecond, StringFormat={}{0:F0} fps}" />
            </Grid>

            <TextBlock Grid.Row="3"
                       Padding="8,4"
                       Background="#331A1D"
                       Foreground="{StaticResource ErrorBrush}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Text="{Binding ElementName=RenderSurface, Path=Diagnostics[0]}">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=RenderSurface, Path=Diagnostics.Count}"
                                         Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Border>
</UserControl>
