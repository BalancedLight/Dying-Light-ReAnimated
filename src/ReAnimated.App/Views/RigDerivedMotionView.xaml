<UserControl x:Class="ReAnimated.App.Views.RigDerivedMotionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Margin="5">
  <TextBlock Text="Derive compatible motion" FontWeight="SemiBold"/>
  <TextBlock Text="Original FBX source clip"/><ComboBox ItemsSource="{Binding DerivedSources}" SelectedItem="{Binding DerivedSource}" DisplayMemberPath="Name" Margin="0,3,0,6"/>
  <TextBlock Text="Derived clip name"/><TextBox Text="{Binding DerivedName, UpdateSourceTrigger=PropertyChanged}"/>
  <TextBlock Text="Sample-rate multiplier (1 to 8)" Margin="0,5,0,0"/><TextBox Text="{Binding DerivedSampleMultiplier, UpdateSourceTrigger=PropertyChanged}"/>
  <WrapPanel Margin="0,5,0,5"><Button Content="Derive and measure" Command="{Binding DeriveMotionCommand}"/><Button Content="Cancel" Command="{Binding CancelDerivedMotionCommand}"/><Button Content="Clear" Command="{Binding ClearDerivedMotionCommand}"/></WrapPanel>
  <CheckBox Content="Preview the derived clip" IsChecked="{Binding DerivedPreviewEnabled}"/>
  <WrapPanel Margin="0,5,0,5"><Button Content="Play / pause preview" Command="{Binding StudioWorkspace.Timeline.TogglePlaybackCommand}"/><Button Content="Stop" Command="{Binding StudioWorkspace.Timeline.StopCommand}"/></WrapPanel>
  <TextBlock Text="{Binding DerivedMotionStatus}" TextWrapping="Wrap" Margin="0,5,0,6"/>
<Button Content="Save as a separate clip" Command="{Binding SaveDerivedMotionCommand}" HorizontalAlignment="Left" ToolTip="Saves a separate sampled clip and leaves the source intact. Review shear and interpolation errors; root policy remains an export setting, and graph/event or runtime contact/IK parity is not established here."/>
 </StackPanel>
</UserControl>
