<UserControl x:Class="ReAnimated.App.Views.RigContactView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:ReAnimated.App.Views">
 <StackPanel Margin="5">
  <TextBlock Text="Sole contact" FontWeight="SemiBold"/>
  <TextBlock Text="Choose one foot and its shoe. Cyan shows the sampled footprint; orange shows the draft bounds; green shows the draft bottom plane. Axes are X right, Y up and Z forward. Native role calibration is a separate review." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,7"/>
  <TextBlock Text="Helper to create or update"/><ComboBox ItemsSource="{Binding ContactHelpers}" SelectedItem="{Binding ContactHelper}" DisplayMemberPath="Name" Margin="0,3,0,6"/>
  <TextBlock Text="Direct parent — select the foot bone"/><ComboBox ItemsSource="{Binding ContactParents}" SelectedItem="{Binding ContactParent}" DisplayMemberPath="Name" Margin="0,3,0,6"/>
  <TextBlock Text="Shoe geometry component"/><ComboBox ItemsSource="{Binding ContactComponents}" SelectedItem="{Binding ContactComponent}" DisplayMemberPath="Name" Margin="0,3,0,6"/>
  <CheckBox Content="Limit to points influenced by this foot and its children" IsChecked="{Binding ContactUseFootWeights}"/>
  <TextBlock Text="Minimum normalized foot weight (0–1)" Margin="0,4,0,0"/><TextBox Text="{Binding ContactMinimumWeight, UpdateSourceTrigger=PropertyChanged}"/>
  <TextBlock Text="Original control-point numbers (comma-separated; empty uses all matching points)" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBox Text="{Binding ContactSourcePoints, UpdateSourceTrigger=PropertyChanged}"/>
  <Expander Header="Fit directions and sampling" IsExpanded="True" Margin="0,6,0,5"><StackPanel>
   <TextBlock Text="Model-space up"/><views:ContactVectorView DataContext="{Binding ContactUp}"/>
   <TextBlock Text="Model-space forward (also resolves direction sign)" TextWrapping="Wrap"/><views:ContactVectorView DataContext="{Binding ContactForward}"/>
   <ComboBox ItemsSource="{Binding ContactAxisChoices}" SelectedItem="{Binding ContactAxes}" DisplayMemberPath="Label" Margin="0,0,0,5"/>
   <ComboBox ItemsSource="{Binding ContactOriginChoices}" SelectedItem="{Binding ContactOrigin}" DisplayMemberPath="Label" Margin="0,0,0,5"/>
   <TextBlock Text="Bottom band as a fraction of shoe height (0–1)" TextWrapping="Wrap"/><TextBox Text="{Binding ContactBottomBand, UpdateSourceTrigger=PropertyChanged}"/>
  </StackPanel></Expander>
  <WrapPanel><Button Content="Fit contact draft" Command="{Binding FitContactCommand}"/><Button Content="Cancel" Command="{Binding CancelContactCommand}"/><Button Content="Clear preview" Command="{Binding ClearContactCommand}"/></WrapPanel>
  <TextBlock Text="{Binding ContactStatus}" TextWrapping="Wrap" Margin="0,6,0,7"/>
  <StackPanel IsEnabled="{Binding HasContactPreview}">
   <TextBlock Text="Exported helper name (exact spelling)"/><TextBox Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}"/>
   <TextBlock Text="Role identity" Margin="0,4,0,0"/><TextBox Text="{Binding ContactRole, UpdateSourceTrigger=PropertyChanged}"/>
   <TextBlock Text="Offset in fitted axes (metres)" Margin="0,6,0,0"/><views:ContactVectorView DataContext="{Binding ContactOffset}"/>
   <TextBlock Text="Rotation about fitted axes (degrees, X/Y/Z)" TextWrapping="Wrap"/><views:ContactVectorView DataContext="{Binding ContactRotation}"/>
   <TextBlock Text="Bounds center in contact coordinates (metres)" TextWrapping="Wrap"/><views:ContactVectorView DataContext="{Binding ContactBoundsCenter}"/>
   <TextBlock Text="Bounds half-extents (positive metres)"/><views:ContactVectorView DataContext="{Binding ContactHalfExtents}"/>
  </StackPanel>
  <Button Content="Apply reviewed contact" Command="{Binding ApplyContactCommand}" HorizontalAlignment="Left"/>
 </StackPanel>
</UserControl>
