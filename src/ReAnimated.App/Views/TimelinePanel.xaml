<UserControl x:Class="ReAnimated.App.Views.TimelinePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PaneBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource PanelRaisedBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="4,0">
                    <Button Command="{Binding StepBackwardCommand}" Content="◀|" ToolTip="Previous frame" />
                    <Button Command="{Binding TogglePlaybackCommand}"
                            Content="{Binding PlaybackLabel}"
                            MinWidth="58" />
                    <Button Command="{Binding StopCommand}" Content="■" ToolTip="Stop" />
                    <Button Command="{Binding StepForwardCommand}" Content="|▶" ToolTip="Next frame" />
                    <Button Command="{Binding AddKeyframeCommand}" Content="+ Key" />
                </StackPanel>
                <Slider Grid.Column="1"
                        Margin="10,0"
                        VerticalAlignment="Center"
                        Minimum="{Binding StartFrame}"
                        Maximum="{Binding EndFrame}"
                        Value="{Binding CurrentFrame, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock VerticalAlignment="Center" Text="Frame " />
                    <TextBox Width="54"
                             Text="{Binding CurrentFrame, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              Content="Loop"
                              IsChecked="{Binding IsLooping}" />
                </StackPanel>
            </Grid>

            <TabControl Grid.Row="1">
                <TabItem Header="Dope sheet">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Margin="8,4"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="DOPE SHEET / CHANNELS" />
                        <ItemsControl ItemsSource="{Binding Tracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="8,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Name}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="4,0,8,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding Channel}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Canvas Width="{Binding CanvasWidth}" Height="160" Background="#11161E">
                        <ItemsControl Width="{Binding CanvasWidth}"
                                      Height="22"
                                      ItemsSource="{Binding FrameMarkers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="{x:Type ContentPresenter}">
                                    <Setter Property="Canvas.Left" Value="{Binding PixelX}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock FontSize="9"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding Frame}" />
                                        <Border Width="1" Height="138" Background="#27313D" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl Width="{Binding CanvasWidth}"
                                      Height="160"
                                      ItemsSource="{Binding VisibleKeyframes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="{x:Type ContentPresenter}">
                                    <Setter Property="Canvas.Left" Value="{Binding PixelX}" />
                                    <Setter Property="Canvas.Top" Value="{Binding TrackY}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Polygon Width="10"
                                             Height="10"
                                             Fill="{StaticResource AccentBrush}"
                                             Points="5,0 10,5 5,10 0,5"
                                             ToolTip="{Binding Track, StringFormat=Key: {0}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Canvas.Left="{Binding CurrentFramePixelX}"
                                Width="2"
                                Height="160"
                                Background="{StaticResource ErrorBrush}" />
                    </Canvas>
                </ScrollViewer>
            </Grid>
                </TabItem>
                <TabItem Header="Curves">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,1,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Margin="8,4"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="AUTHORED CURVES" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Curves}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="22">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="8"
                                                            Height="8"
                                                            Margin="4,0,0,0"
                                                            Background="{Binding Color}"
                                                            CornerRadius="4" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="6,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="10"
                                                               Text="{Binding Name}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Column="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <Canvas Width="{Binding CanvasWidth}"
                                    Height="160"
                                    Background="#11161E">
                                <ItemsControl Width="{Binding CanvasWidth}"
                                              Height="22"
                                              ItemsSource="{Binding FrameMarkers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="{x:Type ContentPresenter}">
                                            <Setter Property="Canvas.Left"
                                                    Value="{Binding PixelX}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock FontSize="9"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding Frame}" />
                                                <Border Width="1"
                                                        Height="138"
                                                        Background="#27313D" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl Width="{Binding CanvasWidth}"
                                              Height="160"
                                              ItemsSource="{Binding CurveSegments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Line X1="{Binding X1}"
                                                  Y1="{Binding Y1}"
                                                  X2="{Binding X2}"
                                                  Y2="{Binding Y2}"
                                                  Stroke="{Binding Color}"
                                                  StrokeThickness="1.5"
                                                  ToolTip="{Binding Track}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl Width="{Binding CanvasWidth}"
                                              Height="160"
                                              ItemsSource="{Binding CurvePoints}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="{x:Type ContentPresenter}">
                                            <Setter Property="Canvas.Left"
                                                    Value="{Binding PixelX}" />
                                            <Setter Property="Canvas.Top"
                                                    Value="{Binding PixelY}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="7"
                                                     Height="7"
                                                     Margin="-3.5"
                                                     Fill="{Binding Color}">
                                                <Ellipse.ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Track}" />
                                                        <TextBlock Text="{Binding Frame, StringFormat=Frame {0:N2}}" />
                                                        <TextBlock Text="{Binding Value, StringFormat=Value {0:G6}}" />
                                                    </StackPanel>
                                                </Ellipse.ToolTip>
                                            </Ellipse>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Canvas.Left="{Binding CurrentFramePixelX}"
                                        Width="2"
                                        Height="160"
                                        Background="{StaticResource ErrorBrush}" />
                            </Canvas>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
