<UserControl x:Class="ReAnimated.App.Views.TimelinePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ReAnimated.App.Views"
             Focusable="True"
             PreviewKeyDown="TimelinePanel_OnPreviewKeyDown"
             Loaded="TimelinePanel_OnLoaded"
             PreviewMouseWheel="TimelinePanel_OnPreviewMouseWheel"
             SizeChanged="TimelinePanel_OnSizeChanged">
    <Border Style="{StaticResource PaneBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" Background="{StaticResource PanelRaisedBrush}" Margin="2">
                <Button Command="{Binding StepBackwardCommand}" Content="|&lt;" ToolTip="Previous frame" />
                <Button Command="{Binding TogglePlaybackCommand}" Content="{Binding PlaybackLabel}" MinWidth="55" />
                <Button Command="{Binding StopCommand}" Content="Stop" />
                <Button Command="{Binding StepForwardCommand}" Content="&gt;|" ToolTip="Next frame" />
                <Button Command="{Binding AddKeyframeCommand}" Content="+ Key" ToolTip="Add a key to the selected track" />
                <TextBlock Text="Frame" VerticalAlignment="Center" Margin="8,0,4,0" />
                <TextBox Width="58" Text="{Binding PositionFrame, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" />
                <TextBlock Margin="4,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="{Binding EndFrame, StringFormat=/ {0:N0}}" />
                <CheckBox Margin="8,0" VerticalAlignment="Center" Content="Loop" IsChecked="{Binding IsLooping}" />
            </WrapPanel>

            <DockPanel Grid.Row="1" Margin="6,2,6,4" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding FitTimelineCommand}" Content="Fit" ToolTip="Fit the clip" />
                    <Button Command="{Binding ZoomOutCommand}" Content="−" Width="28" MinWidth="28" Padding="4,2" ToolTip="Zoom out" />
                    <Button Command="{Binding ZoomInCommand}" Content="+" Width="28" MinWidth="28" Padding="4,2" ToolTip="Zoom in" />
                </StackPanel>
                <ComboBox DockPanel.Dock="Right" Width="112" Margin="4,2" ItemsSource="{Binding TrackScopeOptions}" SelectedItem="{Binding SelectedTrackScope}" />
                <TextBox MinWidth="70" Margin="0,2,4,2" ToolTip="Find a track" Text="{Binding TrackSearchText, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <Border Grid.Row="3" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="6,3">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="Create edit layer" Command="{Binding CreateEditLayerCommand}" Visibility="{Binding CanCreateEditLayer, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TrackAccessLabel}" Foreground="{StaticResource MutedTextBrush}" Margin="8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedTrackLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding SelectedTrackLabel}" />
                    </DockPanel>
                    <WrapPanel PreviewKeyDown="KeyEditor_OnPreviewKeyDown" PreviewTextInput="KeyEditor_OnPreviewTextInput" DataObject.Pasting="KeyEditor_OnPasting" Visibility="{Binding HasSelectedKey, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Frame" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox x:Name="KeyFrameInput" Width="65" Text="{Binding KeyFrameText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditSelectedKey}" />
                        <TextBlock Text="Value" VerticalAlignment="Center" Margin="8,0,4,0" />
                        <TextBox x:Name="KeyValueInput" MinWidth="94" MaxWidth="164" Text="{Binding KeyValueText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding KeyValueEdit, StringFormat=G17}" IsEnabled="{Binding CanEditKeyValue}" />
                        <Button Content="Apply" Command="{Binding ApplyKeyEditCommand}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=KeyFrameInput, Path=(Validation.HasError)}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=KeyValueInput, Path=(Validation.HasError)}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                            </Style.Triggers></Style></Button.Style>
                        </Button>
                        <Button Content="Delete" Command="{Binding DeleteKeyCommand}" />
                        <CheckBox Content="Snap" IsChecked="{Binding SnapKeyFrames}" VerticalAlignment="Center" Margin="8,0" />
                    </WrapPanel>
                    <TextBlock Text="{Binding KeyEditFeedback}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <TabControl x:Name="TimelineTabs"
                        Grid.Row="2"
                        SelectionChanged="TimelineTabs_OnSelectionChanged">
                <TabItem Header="Dope sheet">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Background="{StaticResource PanelBackgroundBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,1,1">
                                <Grid Margin="8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="10"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="CHANNEL" />
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="KEYS" />
                                </Grid>
                            </Border>
                            <ListBox x:Name="DopeChannelList"
                                     Grid.Row="1"
                                     BorderThickness="0,0,1,0"
                                     ItemsSource="{Binding VisibleTracks}"
                                     SelectedItem="{Binding SelectedTrack}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.ScrollChanged="DopeChannelList_OnScrollChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Height" Value="28" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,0,7,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}" />
                                                <TextBlock FontSize="9"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding Channel}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Group}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="10"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="{Binding KeyCountLabel}"
                                                       ToolTip="{Binding KeyPresentationLabel}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <ScrollViewer x:Name="DopeSheetScroll"
                                      Grid.Column="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      ScrollChanged="DopeSheetScroll_OnScrollChanged">
                            <Canvas x:Name="DopeSheetCanvas"
                                    Width="{Binding CanvasWidth}"
                                    Height="{Binding DopeSheetCanvasHeight}"
                                    Background="#11161E"
                                    Cursor="SizeWE"
                                    LostMouseCapture="KeyCanvas_OnLostMouseCapture"
                                    MouseLeftButtonDown="TimelineCanvas_OnMouseLeftButtonDown"
                                    MouseLeftButtonUp="TimelineCanvas_OnMouseLeftButtonUp"
                                    MouseMove="TimelineCanvas_OnMouseMove">
                                <ItemsControl Width="{Binding CanvasWidth}"
                                              Height="{Binding DopeSheetCanvasHeight}"
                                              ItemsSource="{Binding FrameMarkers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding PixelX}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Height="24"
                                                           FontSize="9"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding Frame}" />
                                                <Border Width="1"
                                                        Height="{Binding DataContext.TimelineGridHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Background="#27313D" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl Width="{Binding CanvasWidth}"
                                              Height="{Binding DopeSheetCanvasHeight}"
                                              ItemsSource="{Binding VisibleKeyframes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding PixelX}" />
                                            <Setter Property="Canvas.Top" Value="{Binding TrackY}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Polygon Points="5,0 10,5 5,10 0,5" Tag="{Binding}" MouseLeftButtonDown="KeyMarker_OnMouseLeftButtonDown" Cursor="Hand">
                                                <Polygon.Style>
                                                    <Style TargetType="Polygon">
                                                        <Setter Property="Width" Value="5" />
                                                        <Setter Property="Height" Value="5" />
                                                        <Setter Property="Margin" Value="-2.5" />
                                                        <Setter Property="Fill" Value="#6F8298" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Stroke" Value="White"/><Setter Property="StrokeThickness" Value="1.5"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelectedTrack}"
                                                                         Value="True">
                                                                <Setter Property="Width" Value="10" />
                                                                <Setter Property="Height" Value="10" />
                                                                <Setter Property="Margin" Value="-5" />
                                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Polygon.Style>
                                                <Polygon.ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Track}" />
                                                        <TextBlock Text="{Binding Frame, StringFormat=Source frame {0:0.###}}" />
                                                    </StackPanel>
                                                </Polygon.ToolTip>
                                            </Polygon>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding EventSpans}" Width="{Binding CanvasWidth}" Height="{Binding DopeSheetCanvasHeight}" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding PixelX}"/><Setter Property="Canvas.Top" Value="{Binding TrackY}"/></Style></ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate><DataTemplate><Border Width="{Binding Width}" Height="22" Background="#224AC8A0" CornerRadius="3"/></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding EventMarkers}" Width="{Binding CanvasWidth}" Height="{Binding DopeSheetCanvasHeight}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding PixelX}"/><Setter Property="Canvas.Top" Value="{Binding TrackY}"/></Style></ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Tag="{Binding}" Background="{Binding Color}" CornerRadius="2" MinWidth="10" Height="12" Margin="-5,0,0,0" ToolTip="{Binding ToolTip}" MouseLeftButtonDown="EventMarker_OnMouseLeftButtonDown" Cursor="SizeWE">
                                                <Border.Style><Style TargetType="Border"><Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="White"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                <TextBlock Text="{Binding Count}" FontSize="9" Foreground="#11161E" Margin="2,0"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border IsHitTestVisible="False" Canvas.Left="{Binding CurrentFramePixelX}"
                                        Width="2"
                                        Height="{Binding DopeSheetCanvasHeight}"
                                        Background="{StaticResource ErrorBrush}" />
                            </Canvas>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="Curves">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,1,0"
                                Background="{StaticResource PanelBackgroundBrush}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="8,6">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding SelectedTrackLabel}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SelectedTrackLabel}" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontSize="10"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding CurveStatusLabel}" />
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ListBox ItemsSource="{Binding Curves}" SelectedItem="{Binding SelectedCurve}" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="25" Margin="8,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="14" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="9"
                                                            Height="9"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding Color}"
                                                            CornerRadius="5" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="5,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding OwnerLabel}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <ScrollViewer x:Name="CurveScroll"
                                      Grid.Column="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      ScrollChanged="CurveScroll_OnScrollChanged">
                            <Canvas x:Name="CurveCanvas"
                                    Width="{Binding CanvasWidth}"
                                    Height="{Binding CurveCanvasHeight}"
                                    Background="#11161E"
                                    Cursor="SizeWE"
                                    LostMouseCapture="KeyCanvas_OnLostMouseCapture"
                                    MouseLeftButtonDown="TimelineCanvas_OnMouseLeftButtonDown"
                                    MouseLeftButtonUp="TimelineCanvas_OnMouseLeftButtonUp"
                                    MouseMove="TimelineCanvas_OnMouseMove">
                                <ItemsControl Width="{Binding CanvasWidth}"
                                              Height="{Binding CurveCanvasHeight}"
                                              ItemsSource="{Binding FrameMarkers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding PixelX}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Height="24"
                                                           FontSize="9"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding Frame}" />
                                                <Border Width="1"
                                                        Height="{Binding DataContext.CurveGridHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Background="#27313D" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl Width="{Binding CanvasWidth}"
                                              Height="{Binding CurveCanvasHeight}"
                                              ItemsSource="{Binding CurveSegments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Line X1="{Binding X1}"
                                                  Y1="{Binding Y1}"
                                                  X2="{Binding X2}"
                                                  Y2="{Binding Y2}"
                                                  Stroke="{Binding Color}"
                                                  StrokeThickness="1.5"
                                                  ToolTip="{Binding Track}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl Width="{Binding CanvasWidth}"
                                              Height="{Binding CurveCanvasHeight}"
                                              ItemsSource="{Binding CurvePoints}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding PixelX}" />
                                            <Setter Property="Canvas.Top" Value="{Binding PixelY}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Ellipse Tag="{Binding}" MouseLeftButtonDown="CurvePoint_OnMouseLeftButtonDown" Cursor="Hand" Width="9"
                                                     Height="9"
                                                     Margin="-4.5"
                                                     Fill="{Binding Color}">
                                                <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="StrokeThickness" Value="0"/><Setter Property="Stroke" Value="White"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="StrokeThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                                <Ellipse.ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Track}" />
                                                        <TextBlock Text="{Binding Frame, StringFormat=Frame {0:N2}}" />
                                                        <TextBlock Text="{Binding Value, StringFormat=Value {0:G6}}" />
                                                    </StackPanel>
                                                </Ellipse.ToolTip>
                                            </Ellipse>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border IsHitTestVisible="False" Canvas.Left="{Binding CurrentFramePixelX}"
                                        Width="2"
                                        Height="{Binding CurveCanvasHeight}"
                                        Background="{StaticResource ErrorBrush}" />
                            </Canvas>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
