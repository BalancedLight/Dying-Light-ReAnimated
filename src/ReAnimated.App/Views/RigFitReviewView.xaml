<UserControl x:Class="ReAnimated.App.Views.RigFitReviewView"
             x:Name="ConformRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ReAnimated.App.Views"
             MinWidth="0"
             MinHeight="0"
             Background="#191E27"
             Foreground="{StaticResource TextBrush}">
    <UserControl.Resources>
        <Style x:Key="SeverityTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Caution">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Missing">
                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="7" Background="#191E27">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">

            <!-- 1: Target -->
            <Grid Background="#191E27">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Stage}" Value="Target">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ScrollViewer Background="#191E27" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Target skeleton" />
                    <TextBlock Margin="0,2,0,6"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="Choose a skeleton from your installed game." />
                    <TextBlock Margin="0,4,0,2" Text="Profile" />
                    <TextBox Text="{Binding TemplateProfileName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="The player profile uses the third-person skeleton; the first-person resource shares it." />
                    <Button Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding ResolveTemplateCommand}"
                            Content="Resolve target skeleton" />
                    <Border Margin="0,10,0,0"
                            Padding="8"
                            Background="{StaticResource PanelRaisedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <TextBlock Text="{Binding TemplateStatus}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 2: Mapping -->
            <Grid Background="#191E27">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Stage}" Value="Mapping">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,6">
                    <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="Map source bones to the target" />
                    <Button Content="{Binding AutomaticMatchingLabel}"
                            Command="{Binding RerunAutomaticMatchingCommand}"
                            HorizontalAlignment="Left" Margin="0,0,0,6"
                            ToolTip="Replace manual bone choices with automatic suggestions. Undo restores the previous choices." />
                    <StackPanel Margin="0,0,0,5">
                        <Button Content="Undo last mapping change"
                                Command="{Binding UndoLastMappingChangeCommand}"
                                HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding MappingEditStatus}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <CheckBox Content="Use body shape to suggest matches"
                              IsChecked="{Binding UseGeometryCorrespondence}"
                              ToolTip="Use skin weights, joint positions, and hierarchy alongside names when proposing mappings."
                              Visibility="{Binding IsAdvancedSetupMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <CheckBox Content="Keep unmatched FBX bones"
                              IsChecked="{Binding KeepExtraBones}"
                              ToolTip="Stock clips do not move these bones. Kept bones retain their weights; removing them folds weights into the nearest parent." />
                    <TextBlock Text="{Binding MappingReviewMessage}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Button Content="Accept suggested matches" Command="{Binding AcceptMappingProposalsCommand}"
                            HorizontalAlignment="Left" Margin="0,4,0,0" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap">
                        <Run Text="Mapped" /><Run Text=" " /><Run Text="{Binding MappedCount, Mode=OneWay}" />
                        <Run Text=" · synthesized " /><Run Text="{Binding SynthesizedCount, Mode=OneWay}" />
                        <Run Text=" · retained " /><Run Text="{Binding ExtraCount, Mode=OneWay}" />
                        <Run Text=" · dropped " /><Run Text="{Binding DroppedCount, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0"
                               Text="Motion root moves the whole rig. Map pelvis and limbs separately."
                               ToolTip="Changing the motion root alone will not resolve missing pelvis or limb mappings."
                               TextWrapping="Wrap" />
                </StackPanel>
                <DataGrid Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          FrozenColumnCount="1"
                          HeadersVisibility="Column"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ItemsSource="{Binding VisibleMappings}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAmbiguous}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NeedsSourceMatch}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="155"
                                            Binding="{Binding DisplayName}"
                                            Header="Target bone"
                                            IsReadOnly="True" />
                        <DataGridTemplateColumn Width="155" Header="FBX bone">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding SourceName}">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanChooseSource}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ComboBox ItemsSource="{Binding Candidates}"
                                                  SelectedItem="{Binding SelectedSourceName, Mode=OneWay}"
                                                  SelectionChanged="OnMappingSourceSelectionChanged"
                                                  ToolTip="{Binding SelectedSourceName}"
                                                  Visibility="{Binding CanChooseSource, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Width="85"
                                            Binding="{Binding Disposition}"
                                            Header="Result"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Width="58"
                                            Binding="{Binding Confidence}"
                                            Header="Score"
                                            IsReadOnly="True" />
                    </DataGrid.Columns>
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <TextBlock Margin="8,2"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{Binding Evidence}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding DataContext.IsAdvancedSetupMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>
            </Grid>

            <!-- 3: Scale -->
            <Grid Background="#191E27">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Stage}" Value="Scale">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Scale and proportions" />
                    <TextBlock Margin="0,2,0,6"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="Fitting changes the rest pose. Preview a stock clip or derive motion for this rig to check the result." />
                    <StackPanel Visibility="{Binding IsAdvancedSetupMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Margin="0,4,0,2" Text="Limb proportions" />
                    <ComboBox DisplayMemberPath="Label"
                              ItemsSource="{Binding FitModeChoices}"
                              SelectedItem="{Binding SelectedFitModeChoice}"
                              ToolTip="This chooses source or DL1-reference segment lengths. Stock motion still needs a separate compatibility check." />
                    <TextBlock Margin="0,4,0,8"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="DL1 proportions can change the silhouette. Check animation playback after choosing either option." />
                    <TextBlock Margin="0,4,0,2" Text="Solve scale from" />
                    <ComboBox DisplayMemberPath="Label"
                              ItemsSource="{Binding ScaleModeChoices}"
                              SelectedItem="{Binding SelectedScaleModeChoice}" />
                    <TextBlock Margin="0,6,0,2" Text="Manual scale" />
                    <TextBox IsEnabled="{Binding IsManualScale}"
                             Text="{Binding ManualScale, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Margin="0,8,0,2" Text="Conformance strength" />
                    <Slider Maximum="1"
                            Minimum="0"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="True"
                            Value="{Binding ConformanceStrength}" />
                    <TextBlock FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="0 keeps this model's limb lengths; 1 matches the DL1 reference at the chosen scale." />
                    </StackPanel>
                    <TextBlock Margin="0,5,0,0" Text="Review the fitted proportions before placing joints." TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Row="1"
                        Margin="0,10,0,0"
                        Padding="8"
                        Background="{StaticResource PanelRaisedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3">
                    <TextBlock Text="{Binding ScaleSummary}" TextWrapping="Wrap" />
                </Border>
                <DataGrid Grid.Row="2"
                          Margin="0,8,0,0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding RegionFits}"
                          Visibility="{Binding IsAdvancedSetupMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*" Binding="{Binding Region}" Header="Region" />
                        <DataGridTextColumn Width="52" Binding="{Binding SampleCount}" Header="Samples" />
                        <DataGridTextColumn Width="70" Binding="{Binding Ratio, StringFormat=F3}" Header="Fits at" />
                        <DataGridTextColumn Width="70" Binding="{Binding RelativeErrorAtSolvedScale, StringFormat=P0}" Header="Off by" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- 4: Refine -->
            <Grid Background="#191E27">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Stage}" Value="Refine">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,6">
                    <TextBlock FontWeight="SemiBold" Text="Place the joints" />
                    <TextBlock Margin="0,2,0,4"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="Select a joint, then drag a colored axis in the viewport. Children follow the joint." />
                    <CheckBox Content="Mirror edits to the opposite side"
                              IsChecked="{Binding MirrorEdits}"
                              Visibility="{Binding IsAdvancedSetupMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="10"
                               Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding SelectedLandmark.Instruction}" />
                    <Button Command="{Binding StudioWorkspace.FrameSelectedConformanceJointCommand}"
                            Content="Zoom to joint"
                            HorizontalAlignment="Left"
                            Margin="0,5,0,0" />
                    <WrapPanel Margin="0,5,0,0">
                        <Button Command="{Binding UndoLastJointPlacementCommand}"
                                Content="Undo last move"
                                ToolTip="Ctrl+Z also undoes the last joint move while Place joints is open." />
                        <Button Command="{Binding ResetBoneCommand}" Content="Reset this joint" />
                        <Button Margin="4,0,0,0"
                                Command="{Binding ResetAllCommand}"
                                Content="Reset all" />
                    </WrapPanel>
                </StackPanel>
                <DataGrid Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding Landmarks}"
                          SelectedItem="{Binding SelectedLandmark}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*" Binding="{Binding Label}" Header="Joint" />
                        <DataGridTemplateColumn Width="66" Header="Fit">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource SeverityTextStyle}"
                                               Text="{Binding Severity}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridCheckBoxColumn Width="52"
                                                Binding="{Binding IsAdjusted}"
                                                Header="Moved" />
                        <DataGridTextColumn Width="150" Binding="{Binding Summary}" Header="Detail" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- 5: Verify -->
            <Grid Background="#191E27">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Stage}" Value="Verify">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Verify against a stock clip" />
                    <TextBlock Margin="0,2,0,6"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="Unmatched bones will not receive motion from the stock clip. Review the channel settings and check proportions in Editor and Player." />
                    <WrapPanel>
                        <Button HorizontalAlignment="Left"
                                Command="{Binding VerifyWithRetailClipCommand}"
                                Content="Check a DL1 animation..." />
                        <Button Margin="6,0,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding ApplyConformanceCommand}"
                                Content="Apply fit to model" />
                    </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <TextBlock Text="{Binding VerificationHeadline}" TextWrapping="Wrap" />
                    <Expander Header="Motion details" Margin="0,6,0,0" Visibility="{Binding IsAdvancedSetupMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding Verification.Summary}" TextWrapping="Wrap" Margin="5" />
                    </Expander>
                </StackPanel>
                <ListBox Grid.Row="2"
                         Margin="0,8,0,0"
                         ItemsSource="{Binding Warnings}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="{StaticResource WarningBrush}"
                                       FontSize="10"
                                       Text="{Binding}"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,8,0,0"
                Padding="8"
                Background="{StaticResource PanelRaisedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="3">
            <TextBlock Text="{Binding SolveStatus}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
