<UserControl x:Class="ReAnimated.App.Views.GuidedModelSetupView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:ReAnimated.App.Views">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="MODEL SETUP" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
   <UniformGrid Columns="4" Margin="0,10,0,20">
    <TextBlock Text="1 Import"/><TextBlock Text="2 Adjust"/><TextBlock Text="3 Preview"/><TextBlock Text="4 Export"/>
   </UniformGrid>
   <TextBlock Text="{Binding GuidedStepTitle}" FontSize="23" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding ModelName}" Margin="0,8,0,0" TextWrapping="Wrap"
    Visibility="{Binding HasModel, Converter={StaticResource BooleanToVisibilityConverter}}"/>
   <TextBlock Text="{Binding GuidedRigSummary}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,16">
   <StackPanel>
    <TextBlock Text="{Binding GuidedStatus}" TextWrapping="Wrap" FontSize="14"/>
    <Button Content="Open saved model…" Command="{Binding OpenPackageCommand}" Margin="0,15,0,0"
     Visibility="{Binding IsGuidedImport, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    <Button Content="Change skeleton…" Command="{Binding GuidedChooseSkeletonCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"
     Visibility="{Binding IsGuidedAdjust, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    <CheckBox Content="Adjust joints" Margin="0,16,0,8" IsChecked="{Binding GuidedShowJoints}"
     Visibility="{Binding IsGuidedAdjust, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    <StackPanel Margin="0,12,0,0" Visibility="{Binding IsGuidedUnriggedPreparation, Converter={StaticResource BooleanToVisibilityConverter}}">
     <TextBlock Text="Review body joints" FontWeight="SemiBold" />
     <TextBlock Text="Choose a marker, then drag its colored handle. Build the rig when the markers match your model." TextWrapping="Wrap" Margin="0,6,0,8" />
     <ComboBox ItemsSource="{Binding GuidedBodyProposals}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedGuidedBodyProposal}" />
     <CheckBox Content="Mirror left and right" IsChecked="{Binding Conformance.MirrorBodyGuide}" Margin="0,12,0,6" />
     <Button Content="Undo move" Command="{Binding Conformance.UndoBodyGuideEditCommand}" HorizontalAlignment="Left" />
     <Expander Header="Detection details" Margin="0,12,0,0">
      <TextBlock Text="{Binding GuidedBodyDetectionStatus}" TextWrapping="Wrap" Margin="0,6,0,0" />
     </Expander>
    </StackPanel>
    <StackPanel Visibility="{Binding ShowGuidedJointControls, Converter={StaticResource BooleanToVisibilityConverter}}">
     <TextBlock Text="Select a joint, then drag its colored handle in the viewport." TextWrapping="Wrap"/>
     <TextBlock Text="Body" Margin="0,12,0,3"/>
     <ComboBox ItemsSource="{Binding Conformance.Landmarks}" DisplayMemberPath="Label" SelectedItem="{Binding Conformance.SelectedLandmark}"/>
     <TextBlock Text="Hands" Margin="0,12,0,3"/>
     <ComboBox ItemsSource="{Binding Conformance.FittedFingerJoints}" DisplayMemberPath="Label" SelectedItem="{Binding Conformance.SelectedFittedFingerJoint}"/>
     <CheckBox Content="Mirror left and right" IsChecked="{Binding Conformance.MirrorEdits}" Margin="0,12,0,6"/>
     <WrapPanel><Button Content="Frame joint" Command="{Binding FrameSelectedConformanceJointCommand}"/>
      <Button Content="Undo move" Command="{Binding Conformance.UndoLastJointPlacementCommand}"/></WrapPanel>
    </StackPanel>
    <TextBlock Text="{Binding Conformance.MappingEditStatus}" TextWrapping="Wrap" Margin="0,8,0,0"
     Foreground="{StaticResource WarningBrush}">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding Conformance.HasGuidedMappingConflict}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
       <DataTrigger Binding="{Binding IsGuidedAdjust}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      </Style.Triggers>
     </Style></TextBlock.Style>
    </TextBlock>
    <ItemsControl ItemsSource="{Binding Conformance.GuidedMappingReviewRows}" Margin="0,12,0,0">
     <ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers><DataTrigger Binding="{Binding IsGuidedAdjust}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
     </Style></ItemsControl.Style>
     <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,10">
      <TextBlock Text="{Binding DisplayName}"/><ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedSourceName}" IsEnabled="{Binding CanChooseSource}"/>
     </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <Expander Header="Review assigned bone matches" Margin="0,10,0,0"
     Visibility="{Binding IsGuidedAdjust, Converter={StaticResource BooleanToVisibilityConverter}}">
     <StackPanel Margin="0,6,0,0">
      <TextBlock Text="Change an existing match here to free a source bone for a missing target. Each choice is checked before it is kept."
       TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
      <ItemsControl ItemsSource="{Binding Conformance.GuidedEditableMappingRows}">
       <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,8">
        <TextBlock Text="{Binding DisplayName}" />
        <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedSourceName}"
         IsEnabled="{Binding CanChooseSource}" />
         <TextBlock Text="{Binding GeneratedMotionRootSummary}" TextWrapping="Wrap" Margin="0,4,0,0"
          Foreground="{StaticResource MutedTextBrush}" Visibility="{Binding HasGeneratedMotionRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />
       </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </Expander>
         <TextBlock Text="Next: apply the reviewed fit, then preview movement. Animation-channel and LOD choices are checked before building in Export."
      TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}"
      Visibility="{Binding IsGuidedAdjust, Converter={StaticResource BooleanToVisibilityConverter}}" />
<TextBlock Text="{Binding GuidedFeaturesSummary}" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
    <StackPanel Margin="0,12,0,0"
     Visibility="{Binding IsGuidedPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
     <StackPanel x:Name="GuidedPreviewReviewPanel" DataContext="{Binding GuidedPreviewReviewContext}">
      <StackPanel.Style>
       <Style TargetType="StackPanel">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding HasGuidedPreviewReviewDraft}" Value="True">
          <Setter Property="Visibility" Value="Visible"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </StackPanel.Style>
      <TextBlock Text="Extra bones stay attached" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding GuidedExtraBonePreservationSummary}"
       TextWrapping="Wrap" Margin="0,6,0,8"/>
      <TextBlock Text="The stock animation moves their parents. Extras keep their current shape; separate cloth or hair movement uses its own setup."
       TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"/>
      <Button Content="Keep extra bones and play"
       Command="{Binding PreserveGuidedExtraBonesAndPlayCommand}"
       Margin="0,4,0,8" MinHeight="34"/>
      <StackPanel Visibility="{Binding HasGuidedExtraBoneExceptions, Converter={StaticResource BooleanToVisibilityConverter}}">
       <TextBlock Text="Motion choices to resolve" FontWeight="SemiBold" Margin="0,8,0,6"/>
       <ItemsControl ItemsSource="{Binding GuidedExtraBoneExceptions}">
        <ItemsControl.ItemTemplate><DataTemplate>
         <Border Padding="8" Margin="0,0,0,8" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
          <StackPanel>
           <TextBlock Text="{Binding TargetBone}" FontWeight="SemiBold" TextWrapping="Wrap"/>
           <TextBlock Text="{Binding ContextSummary}" TextWrapping="Wrap" Margin="0,4,0,6" Foreground="{StaticResource MutedTextBrush}"/>
          </StackPanel>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
      <Button Content="Review mapped bones…"
       Command="{Binding OpenGuidedMappingReviewCommand}"
       HorizontalAlignment="Left" Margin="0,0,0,8"/>
      <Expander Header="Extra bone details" IsExpanded="False" Margin="0,4,0,8">
       <StackPanel>
        <TextBlock Text="Optional: override individual rest-shape choices here." TextWrapping="Wrap" Margin="0,6,0,8"/>
        <ItemsControl ItemsSource="{Binding RequiredTargetBindReviews}">
         <ItemsControl.ItemTemplate><DataTemplate>
          <Border Padding="8" Margin="0,0,0,8" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
           <StackPanel>
            <TextBlock Text="{Binding TargetBone}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ContextSummary}" TextWrapping="Wrap" Margin="0,4,0,6" Foreground="{StaticResource MutedTextBrush}"/>
            <CheckBox Content="Keep rest shape and follow parent"
             IsChecked="{Binding IsReviewed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             IsEnabled="{Binding CanReview}"/>
            <TextBlock Text="{Binding ReviewState}" FontSize="11" Margin="0,4,0,0"/>
           </StackPanel>
          </Border>
         </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="Use reviewed choices and play" Command="{Binding ApplyGuidedPreviewReviewCommand}" Margin="0,4,0,0" MinHeight="34"/>
       </StackPanel>
      </Expander>
      <Button Content="Set up cloth or hair motion…"
       Command="{Binding OpenGuidedSecondaryMotionSetupCommand}"
       Margin="0,8,0,0" MinHeight="30"/>
     </StackPanel>
    </StackPanel>
    <Expander Header="Preview morphs" Margin="0,12,0,0" Visibility="{Binding HasGuidedMorphs, Converter={StaticResource BooleanToVisibilityConverter}}">
     <StackPanel Margin="0,8,0,0">
      <ComboBox ItemsSource="{Binding GuidedMorphs}" DisplayMemberPath="Name" SelectedItem="{Binding GuidedSelectedMorph}"/>
      <Slider Margin="0,10,0,10" Minimum="-1" Maximum="1" Value="{Binding GuidedSelectedMorph.Weight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <Button Content="Reset morph preview" Command="{Binding ResetGuidedMorphsCommand}" HorizontalAlignment="Left"/>
     </StackPanel>
    </Expander>
    <WrapPanel Margin="0,16,0,0" Visibility="{Binding IsGuidedExport, Converter={StaticResource BooleanToVisibilityConverter}}">
     <Button Content="Save editable model…" Command="{Binding SavePackageCommand}"/>
     <Button Content="Export options" Command="{Binding OpenProjectExportCommand}"/>
    </WrapPanel>
    <StackPanel Margin="0,16,0,0" Visibility="{Binding IsGuidedExport, Converter={StaticResource BooleanToVisibilityConverter}}">
     <TextBlock Text="First-person and third-person models" FontWeight="SemiBold" />
     <TextBlock Text="{Binding FppTppSummary}" TextWrapping="Wrap" Margin="0,4,0,8" />
     <Button Content="Generate FPP and TPP views" Command="{Binding PrepareFppTppCommand}" Margin="0,0,0,6" />
     <Expander Header="FPP surface choices" IsExpanded="False" Margin="0,0,0,8">
      <StackPanel>
       <TextBlock Text="Automatic hides head-weighted faces. Keep or hide a whole surface to override that choice; TPP always keeps the full character." TextWrapping="Wrap" Margin="0,6,0,8" />
       <ItemsControl ItemsSource="{Binding FppSurfaceVisibilityRows}">
        <ItemsControl.ItemTemplate><DataTemplate>
         <StackPanel Margin="0,0,0,8">
          <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
          <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
         </StackPanel>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </Expander>
     <Button Content="Build both model packages…" Command="{Binding BuildFppTppPackagesCommand}" Margin="0,0,0,12" />
     <TextBlock Text="Animation takes" FontWeight="SemiBold" />
     <TextBlock Text="These checkboxes choose source takes for a local animation library. Unchecking a take does not remove it from the original FBX. The stock-motion Preview step uses a retail clip and does not add that clip to this package."
                TextWrapping="Wrap" Margin="0,4,0,8" Foreground="{StaticResource MutedTextBrush}" />
     <ItemsControl ItemsSource="{Binding Animations}"
                   Visibility="{Binding HasGuidedAnimationTakes, Converter={StaticResource BooleanToVisibilityConverter}}">
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <StackPanel Margin="0,2,0,2">
         <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding Included, Mode=TwoWay}"
                   IsEnabled="{Binding DataContext.CanSelectGuidedLocalAnimationTakes, RelativeSource={RelativeSource AncestorType=UserControl}}" />
         <TextBlock Text="{Binding SourceName}" Margin="22,0,0,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock Text="{Binding GuidedAnimationPackageSummary}" TextWrapping="Wrap" Margin="0,6,0,0" />
     <StackPanel Margin="0,10,0,0" Visibility="{Binding ShowGuidedAnimationAliasInput, Converter={StaticResource BooleanToVisibilityConverter}}">
      <TextBlock Text="Animation-script identity" FontWeight="SemiBold" />
      <TextBox Text="{Binding AnimationScriptAlias, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"
               ToolTip="Optional. When omitted, the model resource name is used for this package if moving takes are included." />
     </StackPanel>
     <StackPanel Margin="0,12,0,0" Visibility="{Binding GuidedChannelPolicyReviewRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
      <TextBlock Text="Channel and LOD review is required before export" FontWeight="SemiBold" />
      <TextBlock Text="{Binding GuidedChannelPolicyReviewSummary}" TextWrapping="Wrap" Margin="0,4,0,6" />
      <Expander Header="Review channel owners, emitted channels and LOD" IsExpanded="True">
       <views:RigChannelPolicyView DataContext="{Binding Conformance}" />
      </Expander>
     </StackPanel>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2">
   <ProgressBar Height="5" IsIndeterminate="True" Margin="0,0,0,10" Visibility="{Binding IsGuidedBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
   <Button Content="{Binding GuidedPrimaryLabel}" Command="{Binding GuidedPrimaryCommand}" MinHeight="42" FontSize="15"/>
   <DockPanel Margin="0,12,0,0">
    <Button Content="Back" Command="{Binding GuidedBackCommand}" DockPanel.Dock="Left"/>
    <Button Content="Project models" Command="{Binding ReturnToProjectModelsCommand}" DockPanel.Dock="Left" Margin="6,0,0,0"/>
    <CheckBox Content="Advanced" IsChecked="{Binding Conformance.IsAdvancedSetupMode}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
   </DockPanel>
  </StackPanel>
 </Grid>
</UserControl>
