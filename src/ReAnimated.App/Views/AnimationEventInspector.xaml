<UserControl x:Class="ReAnimated.App.Views.AnimationEventInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ReAnimated.App.ViewModels">
    <StackPanel Background="{StaticResource PanelBackgroundBrush}">
        <WrapPanel Margin="4,2">
            <Button Content="Edit events" Click="OpenEditor_OnClick">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsStandalone, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
            </Button>
            <CheckBox Content="Events" IsChecked="{Binding ShowLanes}" VerticalAlignment="Center" Margin="4,0"/>
            <TextBlock Text="Sequence" VerticalAlignment="Center" Margin="4,0" />
            <ComboBox Width="190" ItemsSource="{Binding Sequences}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedSequence}" />
            <Button Content="Import" Command="{Binding ImportCommand}" />
            <Button Content="Export script" Command="{Binding ExportSourceCommand}" />
            <Button Content="New sequence" Command="{Binding NewSequenceCommand}" />
            <Button Content="+ Event" Command="{Binding AddEventCommand}" />
            <Button Content="Duplicate" Command="{Binding DuplicateCommand}" />
            <Button Content="Delete" Command="{Binding DeleteCommand}" />
            <TextBlock Text="Snap" VerticalAlignment="Center" Margin="8,0,4,0" />
            <ComboBox Width="85" ItemsSource="{Binding SnapOptions}" SelectedItem="{Binding Snap}" />
            <TextBox Width="150" Margin="6,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Find events" />
        </WrapPanel>
        <Expander Header="Events" IsExpanded="True" Visibility="{Binding HasEvents, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="8,0">
            <Grid MaxHeight="250">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                <TextBlock Text="Select an event" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <WrapPanel Margin="0,3">
                            <TextBlock Text="Type" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <ComboBox Width="180" ItemsSource="{Binding Definitions}" SelectedItem="{Binding SelectedDefinition}" DisplayMemberPath="DisplayName" IsTextSearchEnabled="True" />
                            <TextBlock Text="ID" VerticalAlignment="Center" Margin="5,0" />
                            <TextBox Width="150" Text="{Binding IdText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Symbol or ID" />
                            <TextBlock Text="Frame" VerticalAlignment="Center" Margin="5,0" />
                            <TextBox Width="80" Text="{Binding FrameText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Slot" VerticalAlignment="Center" Margin="5,0" />
                            <TextBox Width="65" Text="{Binding SlotText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Delivery" VerticalAlignment="Center" Margin="5,0" />
                            <ComboBox Width="100" ItemsSource="{Binding DeliveryOptions}" SelectedItem="{Binding Delivery}" />
                            <Button Content="Apply" Command="{Binding ApplyCommand}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding TimingLabel}" Foreground="{StaticResource MutedTextBrush}" Margin="0,2" />
                        <WrapPanel>
                            <ComboBox Width="180" ItemsSource="{Binding ActionDefinitions}" SelectedItem="{Binding SelectedActionDefinition}" DisplayMemberPath="DisplayName" />
                            <Button Content="+ Action" Command="{Binding AddActionCommand}" />
                            <Button Content="Audition" Command="{Binding AuditionCommand}" />
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding Actions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding DisplayName}" Margin="0,2" IsExpanded="True">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding Arguments}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,2,8,2">
                                                            <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                                            <Grid>
                                                                <TextBox Width="145" Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}">
                                                                    <TextBox.Style><Style TargetType="TextBox"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsBoolean}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsSelector}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
                                                                </TextBox>
                                                                <CheckBox IsChecked="{Binding BooleanValue}" Visibility="{Binding IsBoolean, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                <ComboBox Width="145" ItemsSource="{Binding SelectorChoices}" SelectedItem="{Binding SelectorValue}" Visibility="{Binding IsSelector, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <WrapPanel><Button Content="↑" Command="{Binding UpCommand}"/><Button Content="↓" Command="{Binding DownCommand}"/><Button Content="Remove" Command="{Binding RemoveCommand}"/></WrapPanel>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Expander Header="Details" Margin="0,3"><StackPanel><TextBlock Text="{Binding Details}" TextWrapping="Wrap"/><WrapPanel><TextBlock Text="Preview slot" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBox Width="70" Text="{Binding PreviewSlotText, UpdateSourceTrigger=PropertyChanged}"/></WrapPanel></StackPanel></Expander>
                    </StackPanel>
                </ScrollViewer>
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="{StaticResource BorderBrush}" />
                <ListBox Grid.Column="2" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedEvent}" SelectionChanged="EventList_OnSelectionChanged" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding ToolTip}" TextTrimming="CharacterEllipsis" /></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Expander>
        <Expander Header="Range" Margin="8,0">
            <WrapPanel>
                <TextBlock Text="Start" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Width="70" Text="{Binding RangeStart, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="End" VerticalAlignment="Center" Margin="8,0,4,0"/><TextBox Width="70" Text="{Binding RangeEnd, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="FPS" VerticalAlignment="Center" Margin="8,0,4,0"/><TextBox Width="60" Text="{Binding FPS, UpdateSourceTrigger=PropertyChanged}"/>
                <ComboBox Width="160" Margin="8,0,0,0" ItemsSource="{Binding RetimeOptions}" SelectedItem="{Binding Retime}"/>
                <Button Content="Review" Command="{Binding ReviewRangeCommand}"/><Button Content="Apply range" Command="{Binding ApplyRangeCommand}"/>
            </WrapPanel>
        </Expander>
        <TextBlock Text="{Binding Status}" Margin="8,2" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
        <Expander Header="Preview log" Margin="8,0"><ListBox ItemsSource="{Binding Log}" MaxHeight="100" /></Expander>
    </StackPanel>
</UserControl>
