<UserControl x:Class="ReAnimated.App.Views.RigConformanceView"
             x:Name="ConformRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="0"
             MinHeight="0">
    <UserControl.Resources>
        <Style x:Key="StageChipStyle" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
        </Style>
        <Style x:Key="SeverityTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Caution">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Missing">
                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Margin="2,0,2,6"
                   Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap"
                   Text="Converts this model's rig onto Dying Light's skeleton so stock animations resolve. The imported rig is never rewritten in place; the conversion is re-derived from the decisions below and can be reopened." />

        <!-- Stage strip -->
        <DockPanel Grid.Row="1" Margin="0,0,0,7" LastChildFill="False">
            <Border Style="{StaticResource StageChipStyle}">
                <TextBlock FontSize="10" Text="1 Target" />
            </Border>
            <Border Style="{StaticResource StageChipStyle}">
                <TextBlock FontSize="10" Text="2 Mapping" />
            </Border>
            <Border Style="{StaticResource StageChipStyle}">
                <TextBlock FontSize="10" Text="3 Scale" />
            </Border>
            <Border Style="{StaticResource StageChipStyle}">
                <TextBlock FontSize="10" Text="4 Refine" />
            </Border>
            <Border Style="{StaticResource StageChipStyle}">
                <TextBlock FontSize="10" Text="5 Verify" />
            </Border>
            <Button DockPanel.Dock="Right"
                    Command="{Binding NextStageCommand}"
                    Content="Next &#x203A;" />
            <Button DockPanel.Dock="Right"
                    Margin="0,0,4,0"
                    Command="{Binding PreviousStageCommand}"
                    Content="&#x2039; Back" />
        </DockPanel>

        <Border Grid.Row="1"
                Margin="0,34,0,7"
                Padding="8"
                Background="#33301A"
                BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Visibility="{Binding HasMissingCoreRoles, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Foreground="{StaticResource WarningBrush}"
                       FontSize="10"
                       Text="{Binding MissingCoreRolesMessage}"
                       TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2">

            <!-- 1: Target -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Stage}" Value="Target">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Target skeleton" />
                    <TextBlock Margin="0,2,0,6"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="Read from your own installed game. Nothing retail is bundled with this tool; the skeleton is resolved on demand and cached for this session only." />
                    <TextBlock Margin="0,4,0,2" Text="Profile" />
                    <TextBox Text="{Binding TemplateProfileName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="The bounded template profile. 'player' resolves player_1_tpp; the FPP resource shares that skeleton exactly." />
                    <Button Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding ResolveTemplateCommand}"
                            Content="Resolve target skeleton" />
                    <Border Margin="0,10,0,0"
                            Padding="8"
                            Background="{StaticResource PanelRaisedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <TextBlock Text="{Binding TemplateStatus}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 2: Mapping -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Stage}" Value="Mapping">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,6">
                    <CheckBox Content="Keep source bones with no DL1 counterpart"
                              IsChecked="{Binding KeepExtraBones}"
                              ToolTip="Kept bones retain their skin weights and simply rest at bind, since stock clips carry no descriptor for them. Unchecking folds their weights into the nearest surviving ancestor." />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap">
                        <Run Text="Mapped" /><Run Text=" " /><Run Text="{Binding MappedCount, Mode=OneWay}" />
                        <Run Text=" · synthesized " /><Run Text="{Binding SynthesizedCount, Mode=OneWay}" />
                        <Run Text=" · retained " /><Run Text="{Binding ExtraCount, Mode=OneWay}" />
                        <Run Text=" · dropped " /><Run Text="{Binding DroppedCount, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <DataGrid Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          ItemsSource="{Binding Mappings}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAmbiguous}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*"
                                            Binding="{Binding Name}"
                                            Header="DL1 name"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Width="88"
                                            Binding="{Binding Disposition}"
                                            Header="Disposition"
                                            IsReadOnly="True" />
                        <DataGridTemplateColumn Width="150" Header="Source bone">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding SourceName}">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanChooseSource}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ComboBox ItemsSource="{Binding Candidates}"
                                                  SelectedItem="{Binding SelectedSourceName, UpdateSourceTrigger=PropertyChanged}"
                                                  Visibility="{Binding CanChooseSource, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Width="52"
                                            Binding="{Binding Confidence}"
                                            Header="Conf."
                                            IsReadOnly="True" />
                    </DataGrid.Columns>
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <TextBlock Margin="8,2"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{Binding Evidence}"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>
            </Grid>

            <!-- 3: Scale -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Stage}" Value="Scale">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Scale and proportions" />
                    <TextBlock Margin="0,2,0,6"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="DL1 clips key absolute bone translation, so conforming to DL1 proportions is what keeps a stock animation from stretching the mesh. Where your model genuinely differs, that shows up below rather than being hidden." />
                    <TextBlock Margin="0,4,0,2" Text="Limb proportions" />
                    <ComboBox DisplayMemberPath="Label"
                              ItemsSource="{Binding FitModeChoices}"
                              SelectedItem="{Binding SelectedFitModeChoice}"
                              ToolTip="Bone directions always come from DL1's rest pose - that is what makes stock clips play correctly. This chooses whether segment lengths come from DL1 too." />
                    <TextBlock Margin="0,4,0,8"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="Matching DL1 exactly plays stock animations undistorted but shifts the character's limb proportions toward Crane's. Keeping this model's proportions preserves its silhouette, but clips key per-bone translation so limbs still stretch during playback." />
                    <TextBlock Margin="0,4,0,2" Text="Solve scale from" />
                    <ComboBox DisplayMemberPath="Label"
                              ItemsSource="{Binding ScaleModeChoices}"
                              SelectedItem="{Binding SelectedScaleModeChoice}" />
                    <TextBlock Margin="0,6,0,2" Text="Manual scale" />
                    <TextBox IsEnabled="{Binding IsManualScale}"
                             Text="{Binding ManualScale, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Margin="0,8,0,2" Text="Conformance strength" />
                    <Slider Maximum="1"
                            Minimum="0"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="True"
                            Value="{Binding ConformanceStrength}" />
                    <TextBlock FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="1 imposes DL1 rest proportions so stock clips play as authored. 0 keeps your model's own segment lengths, which binds more cleanly but lets stock clips stretch the character." />
                </StackPanel>
                <Border Grid.Row="1"
                        Margin="0,10,0,0"
                        Padding="8"
                        Background="{StaticResource PanelRaisedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3">
                    <TextBlock Text="{Binding ScaleSummary}" TextWrapping="Wrap" />
                </Border>
                <DataGrid Grid.Row="2"
                          Margin="0,8,0,0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding RegionFits}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*" Binding="{Binding Region}" Header="Region" />
                        <DataGridTextColumn Width="52" Binding="{Binding SampleCount}" Header="Samples" />
                        <DataGridTextColumn Width="70" Binding="{Binding Ratio, StringFormat=F3}" Header="Fits at" />
                        <DataGridTextColumn Width="70" Binding="{Binding RelativeErrorAtSolvedScale, StringFormat=P0}" Header="Off by" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- 4: Refine -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Stage}" Value="Refine">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,6">
                    <TextBlock FontWeight="SemiBold" Text="Place the joints" />
                    <TextBlock Margin="0,2,0,4"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="Pick a step, then drag its axis gizmo in the viewport. Children follow the joint you move. Structural DL1 helpers are placed from the template and cannot be dragged." />
                    <CheckBox Content="Mirror edits to the opposite side"
                              IsChecked="{Binding MirrorEdits}" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="10"
                               Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding SelectedLandmark.Instruction}" />
                </StackPanel>
                <DataGrid Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding Landmarks}"
                          SelectedItem="{Binding SelectedLandmark}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*" Binding="{Binding Label}" Header="Joint" />
                        <DataGridTemplateColumn Width="66" Header="Fit">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource SeverityTextStyle}"
                                               Text="{Binding Severity}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridCheckBoxColumn Width="52"
                                                Binding="{Binding IsAdjusted}"
                                                Header="Moved" />
                        <DataGridTextColumn Width="150" Binding="{Binding Summary}" Header="Detail" />
                    </DataGrid.Columns>
                </DataGrid>
                <WrapPanel Grid.Row="2" Margin="0,7,0,0">
                    <Button Command="{Binding ResetBoneCommand}" Content="Reset this joint" />
                    <Button Margin="4,0,0,0"
                            Command="{Binding ResetAllCommand}"
                            Content="Reset all" />
                </WrapPanel>
            </Grid>

            <!-- 5: Verify -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Stage}" Value="Verify">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Verify against a stock clip" />
                    <TextBlock Margin="0,2,0,6"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="Chrome resolves animation tracks by name hash, so an unresolved descriptor is a bone the game will not drive. Coverage is the check that catches a broken conversion; displacement then says whether the mesh survives the pose." />
                    <Button HorizontalAlignment="Left"
                            Command="{Binding VerifyWithRetailClipCommand}"
                            Content="Choose a DL1 animation and verify..." />
                </StackPanel>
                <Border Grid.Row="1"
                        Margin="0,10,0,0"
                        Padding="8"
                        Background="{StaticResource PanelRaisedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3">
                    <TextBlock Text="{Binding Verification.Summary, FallbackValue='No clip verified yet.', TargetNullValue='No clip verified yet.'}"
                               TextWrapping="Wrap" />
                </Border>
                <ListBox Grid.Row="2"
                         Margin="0,8,0,0"
                         ItemsSource="{Binding Warnings}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="{StaticResource WarningBrush}"
                                       FontSize="10"
                                       Text="{Binding}"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="3"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding ApplyConformanceCommand}"
                        Content="Apply conformance to this model" />
            </Grid>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,8,0,0"
                Padding="8"
                Background="{StaticResource PanelRaisedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="3">
            <TextBlock Text="{Binding SolveStatus}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
