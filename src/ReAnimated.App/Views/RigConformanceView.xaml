<UserControl x:Class="ReAnimated.App.Views.RigConformanceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:ReAnimated.App.Views" MinWidth="0" MinHeight="0">
 <Grid Margin="7">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <ListBox ItemsSource="{Binding StudioStages}" SelectedItem="{Binding SelectedStudioStage}" DisplayMemberPath="Label" IsEnabled="{Binding CanNavigateStudio}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
   <WrapPanel Margin="0,4,0,4"><Button Content="&#x2039; Previous stage" Command="{Binding PreviousStudioStageCommand}" Margin="0,0,5,0"/><Button Content="Next stage &#x203A;" Command="{Binding NextStudioStageCommand}"/></WrapPanel>
  </StackPanel>
  <StackPanel Grid.Row="1" Margin="0,0,0,7"><TextBlock Text="{Binding StudioStagePurpose}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding StudioSourceSummary}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/></StackPanel>
  <Grid Grid.Row="2">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsStudioImport, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel>
    <TextBlock Text="{Binding StudioSessionSummary}" TextWrapping="Wrap" Margin="0,0,0,7"/>
    <ComboBox ItemsSource="{Binding StudioEntryChoices}" SelectedItem="{Binding SelectedStudioEntry}" DisplayMemberPath="Label"/>
    <Button Content="Start studio session" Command="{Binding StartStudioCommand}" HorizontalAlignment="Left" Margin="0,5,0,8"/>
    <TextBlock Text="{Binding StudioProfileSummary}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"/>
    <views:RigComponentSelectionView/>
   </StackPanel></ScrollViewer>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsStudioDetect, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel>
    <views:BodyGuideDetectionView Visibility="{Binding HasBodyAuthoringSource, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    <StackPanel Visibility="{Binding HasRiggedStudioSource, Converter={StaticResource BooleanToVisibilityConverter}}">
     <TextBlock Text="Existing-rig correspondence" FontWeight="SemiBold"/>
     <TextBlock Text="Resolve a reference from the indexed installation, then inspect geometry, hierarchy and name evidence in Fit. This does not establish runtime helper completeness." TextWrapping="Wrap" Margin="0,4,0,5"/>
     <CheckBox Content="Use geometry and hierarchy for correspondence" IsChecked="{Binding UseGeometryCorrespondence}"/>
     <TextBox Text="{Binding TemplateProfileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,4"/>
     <Button Content="Resolve reference skeleton" Command="{Binding ResolveTemplateCommand}" HorizontalAlignment="Left"/>
     <TextBlock Text="{Binding TemplateStatus}" TextWrapping="Wrap" Margin="0,5,0,5"/>
     <Button Content="Review mapping in Fit" Command="{Binding OpenRiggedMappingCommand}" HorizontalAlignment="Left"/>
    </StackPanel>
    <Expander Header="Eye geometry and source setup" Margin="0,8,0,0"><views:RigEyeView/></Expander>
    <Expander Header="Local hand detection and review" Margin="0,8,0,0"><views:RigLocalHandView/></Expander>
    <TextBlock Text="Broader eye geometry and deformation challenges remain incomplete. Proposal strength is not a calibrated quality or runtime pass." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
   </StackPanel></ScrollViewer>
   <Grid Visibility="{Binding IsStudioFit, Converter={StaticResource BooleanToVisibilityConverter}}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasBodyAuthoringSource, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel>
     <Expander Header="Parent relationships" Margin="0,0,0,7"><views:RigReparentView/></Expander>
     <Expander Header="Joint rest-pose editing" Margin="0,0,0,7"><views:RigRestPoseView/></Expander>
     <views:BodyGuideFitView/><TextBlock Text="{Binding BodyAuthoringStatus}" TextWrapping="Wrap" Margin="0,6,0,5"/>
     <WrapPanel><Button Content="Build draft body rig" Command="{Binding BuildBodyRigCommand}"/><Button Content="Cancel job" Command="{Binding CancelBodyAuthoringCommand}"/></WrapPanel>
     <Expander Header="Local hand fitting" IsExpanded="True" Margin="0,8,0,0"><views:RigLocalHandView/></Expander>
     <TextBlock Text="Generated-joint editing currently uses saved guides and undo/rebuild. General joint, chain and rest/rebind tools remain incomplete." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0"/>
    </StackPanel></ScrollViewer>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasImportedRiggedStudioSource, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel>
     <Expander Header="Parent relationships" Margin="0,0,0,7"><views:RigReparentView/></Expander>
     <Expander Header="Joint rest-pose editing" Margin="0,0,0,7"><views:RigRestPoseView/></Expander>
     <views:RigFitReviewView MinHeight="650"/>
     <Expander Header="Local hand fitting" Margin="0,8,0,0"><views:RigLocalHandView/></Expander>
    </StackPanel></ScrollViewer>
   </Grid>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsStudioHelpers, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel>
    <TextBlock Text="{Binding StudioProfileSummary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
    <Expander Header="Rig Doctor contact repair" IsExpanded="True" Margin="0,0,0,7"><views:RigDoctorView/></Expander>
    <TextBlock Text="Fit sole contacts from selected geometry or use the hierarchy editor for helper creation and local edits. Complete native role calibration remains in progress." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,7"/>
    <Expander Header="Parent relationships" Margin="0,0,0,7"><views:RigReparentView/></Expander>
    <Expander Header="Eye pivots and gaze helpers" Margin="0,0,0,7"><views:RigEyeView/></Expander>
    <Expander Header="Sole contact fitting" IsExpanded="True"><views:RigContactView/></Expander>
    <views:RigHierarchyEditorView DataContext="{Binding StudioWorkspace}" MinHeight="420"/>
    <Expander Header="Channel ownership and LOD" Margin="0,7,0,0"><views:RigChannelPolicyView/></Expander>
   </StackPanel></ScrollViewer>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsStudioSkin, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel>
    <TextBlock Text="Binding requires a rig. Generated rigs use the binding tools; imported rigs retain current weights unless explicitly corrected." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"/>
    <Expander Header="Generated binding" Visibility="{Binding HasGeneratedBodyRig, Converter={StaticResource BooleanToVisibilityConverter}}"><views:GeneratedSkinBindingView/></Expander>
    <views:RigWeightEditingView Visibility="{Binding HasWeightEditingSource, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    <Expander Header="Joint stress poses and morph review" Margin="0,8,0,0"><views:RigStressReviewView/></Expander>
   </StackPanel></ScrollViewer>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsStudioAnimate, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel>
    <Expander Header="Derive motion for the current rig" IsExpanded="True" Margin="0,0,0,8"><views:RigDerivedMotionView/></Expander>
    <TextBlock Text="Source animation stacks" FontWeight="SemiBold"/>
    <views:ModelAnimationStacksView DataContext="{Binding StudioWorkspace}" MinHeight="260"/>
    <Button Content="Choose a stock clip for fitted-model review…" Command="{Binding VerifyWithRetailClipCommand}" HorizontalAlignment="Left" Margin="0,7,0,5"/>
    <TextBlock Text="{Binding Verification.Summary, FallbackValue='No fitted-model stock clip review.', TargetNullValue='No fitted-model stock clip review.'}" TextWrapping="Wrap"/>
    <Expander Header="Transient stress and morph review" Margin="0,8,0,0"><views:RigStressReviewView/></Expander>
    <Expander Header="Native size studies" Margin="0,8,0,0"><views:RigNativeScaleStudyView DataContext="{Binding StudioWorkspace.NativeScaleStudy}"/></Expander>
    <TextBlock Text="Descriptor/pose review is separate from graph events, contacts, equipment and live runtime behavior. Full strategy/contact comparison remains incomplete." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0"/>
   </StackPanel></ScrollViewer>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsStudioVerify, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel>
    <TextBlock Text="Evidence history" FontWeight="SemiBold"/>
    <TextBlock Text="Recorded receipts retain their original scope. This table does not certify that a prior profile, build, provider or actor still matches." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,5"/>
    <ItemsControl ItemsSource="{Binding StudioFacetHistory}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="6" Margin="0,0,0,5"><StackPanel>
     <TextBlock Text="{Binding Facet}" FontWeight="SemiBold"/><TextBlock Text="{Binding RecordedResult, StringFormat='Recorded result: {0}'}"/><TextBlock Text="{Binding Context}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
    </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <views:ModelDiagnosticsView DataContext="{Binding StudioWorkspace}" MinHeight="230"/>
    <WrapPanel DataContext="{Binding StudioWorkspace}" Margin="0,7,0,5"><Button Content="Save model" Command="{Binding SavePackageCommand}"/><Button Content="Build native package…" Command="{Binding BuildCompletePackageCommand}"/></WrapPanel>
    <TextBlock Text="{Binding StudioWorkspace.BuildStatus}" TextWrapping="Wrap"/>
    <TextBlock Text="Compilation and read-back are offline evidence. Provider/load identity and live scenarios require separate validation before delivery is accepted." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0"/>
   </StackPanel></ScrollViewer>
  </Grid>
  <Border Grid.Row="3" Background="{StaticResource PanelRaisedBrush}" Padding="7" Margin="0,7,0,0"><StackPanel>
   <TextBlock Text="{Binding StudioReviewSummary}" TextWrapping="Wrap"/><Button Content="Record authoring review of this stage" Command="{Binding RecordStudioReviewCommand}" HorizontalAlignment="Left" Margin="0,5,0,0"/>
  </StackPanel></Border>
 </Grid>
</UserControl>
