<Window x:Class="ReAnimated.App.Infrastructure.OperationFailureReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="820"
        Height="600"
        MinWidth="560"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="SummaryTextBlock"
                   Margin="0,0,0,12"
                   FontSize="16"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />

        <TextBox x:Name="DetailsTextBox"
                 Grid.Row="1"
                 Padding="10"
                 AcceptsReturn="True"
                 FontFamily="Consolas"
                 HorizontalScrollBarVisibility="Auto"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" />

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Foreground="#888888"
                       Text="Every item is also preserved in Diagnostics and the session log." />
            <Button Grid.Column="1"
                    MinWidth="90"
                    Margin="0,0,8,0"
                    Click="Copy_Click"
                    Content="Copy all" />
            <Button Grid.Column="2"
                    MinWidth="90"
                    IsCancel="True"
                    IsDefault="True"
                    Content="OK" />
        </Grid>
    </Grid>
</Window>
