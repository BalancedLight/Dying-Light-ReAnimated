<Window x:Class="ReAnimated.App.Infrastructure.DevelopmentNoticeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Welcome to ReAnimated" Width="520" SizeToContent="Height"
    ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="22">
        <TextBlock Text="Before you begin" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap"
            Text="ReAnimated is in early development. Expect errors, bugs, and unfinished features." />
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
            Text="Despite ReAnimating the dead, this isn't a miracle product. You'll still need to set up and use its outputs in the Developer Tools editor or game, and may need to fix issues yourself, such as bad rigs, skin weights, or other asset problems." />
        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap">
            <Hyperlink Foreground="{StaticResource AccentBrush}"
                NavigateUri="https://dldt.miraheze.org/wiki/" RequestNavigate="Wiki_RequestNavigate">Dying
                Light Developer Tools wiki</Hyperlink>
            <Run Text=" — help with using the editor and Developer Tools." />
        </TextBlock>
        <CheckBox x:Name="DontShowAgain" Margin="0,22,0,0"
            Content="I understand, don't show this again" />
        <TextBlock x:Name="ErrorMessage" Margin="0,8,0,0" TextWrapping="Wrap"
            Foreground="{StaticResource ErrorBrush}" Visibility="Collapsed" />
        <Button Content="Continue" MinWidth="90" HorizontalAlignment="Right"
            Margin="0,16,0,0" IsDefault="True" Click="Continue_Click" />
    </StackPanel>
</Window>