<Window x:Class="ReAnimated.App.Infrastructure.MotionAccumulatorSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a motion-accumulator bone"
        Width="520"
        Height="460"
        MinWidth="420"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="17"
                       FontWeight="SemiBold"
                       Text="{Binding TitleText}" />
            <TextBlock Margin="0,4,0,10"
                       Foreground="#A9B7C8"
                       Text="MotionAccumulator moves this animation's travel and heading off the skeletal root and onto a separate track. This rig carries no 0xCCC3CDDF accumulator of its own, so choose the bone that should receive it. Cancelling leaves the root policy unchanged; applying it without an accumulator would discard the movement."
                       TextWrapping="Wrap" />
        </StackPanel>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding CandidateBoneNames}"
                 SelectedItem="{Binding SelectedBoneName}"
                 MouseDoubleClick="Choose_DoubleClick" />

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Foreground="#A9B7C8"
                       Text="{Binding SelectionSummary}"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button MinWidth="92"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Content="Cancel" />
                <Button MinWidth="110"
                        IsDefault="True"
                        Click="Choose_Click"
                        Content="Use bone" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
