<Window x:Class="ReAnimated.App.Infrastructure.RecoverySaveFailureDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Save recovery" Width="460" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <StackPanel Margin="18">
  <TextBlock Text="Recovery could not be saved." FontSize="17" FontWeight="SemiBold" />
  <Expander Header="Details" Margin="0,12,0,16">
   <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="0,6,0,0" />
  </Expander>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Retry" Click="Retry_Click" IsDefault="True" Margin="0,0,6,0" />
   <Button Content="Save elsewhere…" Click="SaveElsewhere_Click" Margin="0,0,6,0" />
   <Button Content="Cancel" IsCancel="True" />
  </StackPanel>
 </StackPanel>
</Window>
