<Window x:Class="ReAnimated.App.Infrastructure.AnimationLibraryEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign animation SCR"
        Width="1120"
        Height="760"
        MinWidth="840"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock FontSize="17"
                       FontWeight="SemiBold"
                       Text="Animation script assignment" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="Choose one owning type-322 SCR for this target variant. Imports are ordered and retail entries are exact fingerprinted references."
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="10"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold"
                               Text="Project animation libraries" />
                    <ListBox Grid.Row="1"
                             Margin="0,8,0,8"
                             DisplayMemberPath="Summary"
                             ItemsSource="{Binding Libraries}"
                             SelectedItem="{Binding SelectedLibrary, Mode=TwoWay}" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Click="NewLibrary_Click"
                                Content="New library" />
                        <Button Click="RemoveLibrary_Click"
                                Content="Remove" />
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ResizeDirection="Columns" />

            <Border Grid.Column="2"
                    Padding="12"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid IsEnabled="{Binding HasSelectedLibrary}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="0.7*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="Display name" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding SelectedLibrary.DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="3"
                                   VerticalAlignment="Center"
                                   Text="Type-322 resource" />
                        <TextBox Grid.Column="4"
                                 ToolTip="Extensionless SCR resource name"
                                 Text="{Binding SelectedLibrary.ResourceName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="3"
                                   Grid.ColumnSpan="2"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding SelectedLibrary.DlcConventionMessage}"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="Library mode" />
                        <StackPanel Grid.Column="1">
                            <ComboBox DisplayMemberPath="Label"
                                      ItemsSource="{Binding SelectedLibrary.ModeOptions}"
                                      SelectedItem="{Binding SelectedLibrary.SelectedMode, Mode=TwoWay}" />
                            <TextBlock Margin="2,3,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{Binding SelectedLibrary.ModeDescription}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="3"
                                   VerticalAlignment="Top"
                                   Margin="0,6,0,0"
                                   Text="Sequence collisions" />
                        <StackPanel Grid.Column="4">
                            <ComboBox DisplayMemberPath="Label"
                                      ItemsSource="{Binding SelectedLibrary.CollisionOptions}"
                                      SelectedItem="{Binding SelectedLibrary.SelectedCollision, Mode=TwoWay}" />
                            <TextBlock Margin="2,3,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{Binding SelectedLibrary.CollisionDescription}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="4"
                                    Margin="0,10,0,0"
                                    Visibility="{Binding SelectedLibrary.IsExistingExtension, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Fingerprint-verified base script" />
                            <ComboBox Margin="0,4,0,0"
                                      DisplayMemberPath="Label"
                                      ItemsSource="{Binding SelectedLibrary.ExistingScriptOptions}"
                                      SelectedItem="{Binding SelectedLibrary.SelectedExistingScript, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock FontWeight="SemiBold"
                                   Text="Ordered script imports" />
                        <Grid Grid.Row="1" Margin="0,6,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox DisplayMemberPath="Summary"
                                      ItemsSource="{Binding Libraries}"
                                      SelectedItem="{Binding SelectedProjectImport, Mode=TwoWay}" />
                            <Button Grid.Column="1"
                                    Click="AddProjectImport_Click"
                                    Content="Add project import" />
                            <ComboBox Grid.Column="3"
                                      DisplayMemberPath="Label"
                                      ItemsSource="{Binding RetailScripts}"
                                      SelectedItem="{Binding SelectedRetailImport, Mode=TwoWay}" />
                            <Button Grid.Column="4"
                                    Click="AddRetailImport_Click"
                                    Content="Add retail import" />
                        </Grid>
                        <DataGrid Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  ItemsSource="{Binding SelectedLibrary.Imports}"
                                  SelectedItem="{Binding SelectedImport, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Kind"
                                                    Binding="{Binding Kind}"
                                                    Width="125"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Header="Script"
                                                    Binding="{Binding ResourceName}"
                                                    Width="180"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Header="Name"
                                                    Binding="{Binding DisplayName}"
                                                    Width="*"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Header="Identity"
                                                    Binding="{Binding Evidence}"
                                                    Width="180"
                                                    IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="3"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button Click="MoveImportUp_Click"
                                    Content="Move up" />
                            <Button Click="MoveImportDown_Click"
                                    Content="Move down" />
                            <Button Click="RemoveImport_Click"
                                    Content="Remove import" />
                        </StackPanel>
                    </Grid>

                    <GridSplitter Grid.Row="3"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="{StaticResource BorderBrush}"
                                  ResizeDirection="Rows" />

                    <Grid Grid.Row="4" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock FontWeight="SemiBold"
                                   Text="Generated SCR source preview" />
                        <TextBox Grid.Row="1"
                                 Margin="0,6,0,0"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 FontFamily="Consolas"
                                 HorizontalScrollBarVisibility="Auto"
                                 IsReadOnly="True"
                                 Text="{Binding GeneratedSourcePreview}"
                                 VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="10"
                Background="{StaticResource PanelRaisedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="Clip assignment" />
                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding SequenceName}" />
                <TextBlock Grid.Column="3"
                           VerticalAlignment="Center"
                           Text="Target-specific ANM2" />
                <TextBox Grid.Column="4"
                         Margin="10,0,0,0"
                         Text="{Binding OutputAnm2Name, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Foreground="{StaticResource ErrorBrush}"
                       Text="{Binding ValidationMessage}"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button MinWidth="92"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Content="Cancel" />
                <Button MinWidth="140"
                        IsDefault="True"
                        Click="Assign_Click"
                        Content="Save SCR assignment" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
