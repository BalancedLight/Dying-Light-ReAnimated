<Window x:Class="ReAnimated.App.Infrastructure.AnimationTargetSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add animation targets"
        Width="820"
        Height="520"
        MinWidth="640"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="17"
                       FontWeight="SemiBold"
                       Text="{Binding TitleText}" />
            <TextBlock Margin="0,4,0,10"
                       Foreground="#A9B7C8"
                       Text="Check additional project models. Existing variants stay assigned and can only be removed from the Animations library. Static models cannot be targets."
                       TextWrapping="Wrap" />
        </StackPanel>

        <DataGrid Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Add" Width="52">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center"
                                      IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanSelect}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Model" Binding="{Binding Name}" Width="210" IsReadOnly="True" />
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="180" IsReadOnly="True" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="170" IsReadOnly="True" />
                <DataGridTextColumn Header="Rig contract" Binding="{Binding Contract}" Width="*" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Foreground="#A9B7C8"
                       Text="{Binding SelectionSummary}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button MinWidth="92"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Content="Cancel" />
                <Button MinWidth="110"
                        IsDefault="True"
                        Click="Add_Click"
                        Content="Add checked" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
