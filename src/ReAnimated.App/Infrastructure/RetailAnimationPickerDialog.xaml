<Window x:Class="ReAnimated.App.Infrastructure.RetailAnimationPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a stock animation"
        Width="700"
        Height="560"
        MinWidth="520"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Search stock animations" FontWeight="SemiBold" Margin="0,0,0,6" />
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <ComboBox DockPanel.Dock="Right"
                      Width="140"
                      Margin="8,0,0,0"
                      ItemsSource="{Binding ProviderFilters}"
                      SelectedItem="{Binding SelectedProviderFilter}"
                      AutomationProperties.Name="Animation source" />
            <TextBox x:Name="SearchBox"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Search stock animations" />
        </DockPanel>
        <ListBox x:Name="Candidates"
                 Grid.Row="2"
                 ItemsSource="{Binding VisibleAssets}"
                 SelectionChanged="OnSelectionChanged"
                 MouseDoubleClick="OnCandidateDoubleClick"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 AutomationProperties.Name="Stock animations">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,5">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Kind}" FontSize="10" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding LogicalPath}"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="3"
                   Margin="0,7,0,0"
                   Text="{Binding ResultSummary}"
                   Foreground="{StaticResource MutedTextBrush}" />
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,9,0,0">
            <Button x:Name="ChooseButton"
                    Content="Use selected animation"
                    IsEnabled="False"
                    IsDefault="True"
                    Click="OnChooseClicked"
                    MinWidth="150" />
            <Button Content="Cancel"
                    IsCancel="True"
                    MinWidth="72"
                    Margin="7,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
