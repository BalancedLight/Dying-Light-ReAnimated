<Window x:Class="ReAnimated.App.Infrastructure.NewAnimationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New animation"
        Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="17" FontWeight="SemiBold" Text="New animation" />
        <TextBlock Grid.Row="1"
                   Margin="0,4,0,12"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="Starts at the rig bind pose. Add movement in Animate."
                   TextWrapping="Wrap" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Name" />
                <TextBox x:Name="NameInput" Margin="0,3,0,10" />
                <TextBlock Text="Duration (seconds)" />
                <TextBox x:Name="DurationInput" Margin="0,3,0,0" Text="1" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="FPS" />
                <TextBox x:Name="FrameRateNumeratorInput" Margin="0,3,0,10" Text="30" />
                <TextBlock Text="FPS denominator" />
                <TextBox x:Name="FrameRateDenominatorInput" Margin="0,3,0,0" Text="1" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="ValidationMessage"
                   Grid.Row="3"
                   Margin="0,9,0,0"
                   Foreground="{StaticResource ErrorBrush}"
                   TextWrapping="Wrap" />
        <StackPanel Grid.Row="4"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="78" Margin="0,0,8,0" Content="Create" IsDefault="True" Click="Create_Click" />
            <Button MinWidth="78" Content="Cancel" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
