<Window x:Class="ReAnimated.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="clr-namespace:ReAnimated.App.Behaviors"
        xmlns:controls="clr-namespace:ReAnimated.App.Controls"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:vm="clr-namespace:ReAnimated.App.ViewModels"
        xmlns:views="clr-namespace:ReAnimated.App.Views"
         mc:Ignorable="d"
         Title="{Binding WindowTitle}"
         Icon="Assets/DLReAnimated.ico"
         Width="1600"
        Height="980"
        MinWidth="1180"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Close"
                        Executed="OnCloseCommandExecuted" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewWorkspaceCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenWorkspaceCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveWorkspaceCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Space" Command="{Binding Timeline.TogglePlaybackCommand}" />
    </Window.InputBindings>
    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top"
              Background="#0F131A"
              Foreground="{StaticResource TextBrush}">
            <MenuItem Header="_File">
                <MenuItem Command="{Binding NewWorkspaceCommand}" Header="_New workspace" InputGestureText="Ctrl+N" />
                <MenuItem Command="{Binding OpenWorkspaceCommand}" Header="_Open…" InputGestureText="Ctrl+O" />
                <MenuItem Command="{Binding SaveWorkspaceCommand}" Header="_Save project" InputGestureText="Ctrl+S" />
                <MenuItem Command="{Binding ImportAnimationCommand}" Header="_Import FBX / ANM2..." />
                <MenuItem Command="{Binding ImportMimicAnimationCommand}" Header="Import _mimic ANM2..." />
                <MenuItem Command="{Binding ImportFacialFbxCommand}" Header="Import _facial FBX for review..." />
                <MenuItem Header="_Export DL1 ANM2">
                    <MenuItem Command="{Binding ExportBodyCommand}" Header="_Body..." />
                    <MenuItem Command="{Binding ExportMimicCommand}" Header="_Mimic..." />
                    <MenuItem Command="{Binding ExportBodyAndMimicCommand}" Header="Body + _mimic..." />
                </MenuItem>
                <Separator />
                <MenuItem Command="{Binding AssetBrowser.IndexGameCommand}" Header="_Refresh asset catalog…" />
                <MenuItem Header="Project R_Pack roots">
                    <MenuItem Command="{Binding AddAdditionalRpackRootCommand}"
                              Header="_Add project-relative folder…" />
                    <MenuItem Command="{Binding RemoveAdditionalRpackRootCommand}"
                              Header="_Remove selected folder" />
                </MenuItem>
                <Separator />
                <MenuItem Command="ApplicationCommands.Close" Header="E_xit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Command="{Binding UndoCommand}" Header="_Undo" InputGestureText="Ctrl+Z" />
                <MenuItem Command="{Binding RedoCommand}" Header="_Redo" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Command="{Binding Timeline.AddKeyframeCommand}" Header="Add _keyframe" />
            </MenuItem>
            <MenuItem Header="_Viewport">
                <MenuItem Command="{Binding ResetCameraCommand}" Header="_Reset camera" />
                <MenuItem Command="{Binding FrameSelectionCommand}" Header="_Frame scene" />
                <MenuItem Header="_Keep framed"
                          IsCheckable="True"
                          IsChecked="{Binding KeepFramed}"
                          ToolTip="Keep refitting the camera to the animated subject. Orbiting still works because framing preserves the view direction; panning and dollying are overridden by the next refit." />
                <MenuItem Command="{Binding OpenBoneEditorCommand}"
                          Header="_Edit bones"
                          ToolTip="Open Retarget/Edit, select the Skeleton tree and Inspector, and choose the first editable deform bone." />
                <MenuItem Header="_Link cameras" IsCheckable="True" IsChecked="{Binding IsViewportsLinked}" />
                <Separator />
                <MenuItem Header="Show _mesh surfaces"
                          IsCheckable="True"
                          IsChecked="{Binding ShowMeshes}" />
                <MenuItem Header="Show _skeleton overlay"
                          IsCheckable="True"
                          IsChecked="{Binding ShowSkeletonOverlay}" />
                <Separator />
                <MenuItem Header="Show deform _bones"
                          IsCheckable="True"
                          IsChecked="{Binding ShowDeformBones}" />
                <MenuItem Header="Show _helpers"
                          IsCheckable="True"
                          IsChecked="{Binding ShowHelpers}" />
                <MenuItem Header="Show _camera helpers"
                          IsCheckable="True"
                          IsChecked="{Binding ShowCameraHelpers}" />
                <MenuItem Header="Show _prop / pivot helpers"
                          IsCheckable="True"
                          IsChecked="{Binding ShowPropHelpers}" />
                <Separator />
                <MenuItem Header="Show bone local _axes"
                          IsCheckable="True"
                          IsChecked="{Binding ShowBoneLocalAxes}" />
                <MenuItem Header="Show current deformed _bounds"
                          IsCheckable="True"
                          IsChecked="{Binding ShowDeformedBounds}" />
                <MenuItem Header="_Highlight selected retail mesh"
                          IsCheckable="True"
                          IsChecked="{Binding HighlightSelectedMeshes}" />
                <MenuItem Header="Show _root-motion trail"
                          IsCheckable="True"
                          IsChecked="{Binding ShowRootMotionTrail}"
                          ToolTip="Samples the authoritative exportable pipeline on a cancellable worker; preview-only procedural motion is excluded." />
            </MenuItem>
            <MenuItem Header="_Window">
                <MenuItem Header="_Workspace">
                    <MenuItem Command="{Binding SelectWorkspaceCommand}"
                              CommandParameter="Models"
                              Header="_Models"
                              IsChecked="{Binding IsModelsWorkspace, Mode=OneWay}"
                              ToolTip="Browse base-game models, preview without changing variants, and import project-owned custom FBX models." />
                    <MenuItem Command="{Binding SelectWorkspaceCommand}"
                              CommandParameter="Animations"
                              Header="_Animations"
                              IsChecked="{Binding IsAnimationsWorkspace, Mode=OneWay}"
                              ToolTip="Choose immutable sources and create model-specific target variants." />
                    <MenuItem Command="{Binding SelectWorkspaceCommand}"
                              CommandParameter="Playback"
                              Header="_Playback"
                              IsChecked="{Binding IsPlaybackWorkspace, Mode=OneWay}"
                              ToolTip="Play the active target variant; draft mappings preview visibly but cannot export." />
                    <MenuItem Command="{Binding SelectWorkspaceCommand}"
                              CommandParameter="Retarget/Edit"
                              Header="_Retarget / Edit"
                              IsChecked="{Binding IsRetargetWorkspace, Mode=OneWay}" />
                    <MenuItem Command="{Binding SelectWorkspaceCommand}"
                              CommandParameter="Export"
                              Header="_Export"
                              IsChecked="{Binding IsExportWorkspace, Mode=OneWay}" />
                </MenuItem>
                <Separator />
                <MenuItem Command="{Binding ToggleDiagnosticsDrawerCommand}"
                          Header="_Jobs / diagnostics" />
                <MenuItem x:Name="DockPanesMenu"
                          Header="_Panes"
                          SubmenuOpened="OnDockPanesMenuOpened" />
                <MenuItem Header="_Reset current workflow layout"
                          Click="OnResetDockLayoutClick" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Command="{Binding ShowFidelityDetailsCommand}"
                          Header="DL1 _fidelity status" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom"
                   Background="#0F131A"
                   BorderBrush="{StaticResource BorderBrush}"
                   BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <StatusBarItem Visibility="{Binding HasAnimationOperationFailure, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button Command="{Binding ShowAnimationOperationDiagnosticsCommand}"
                        Content="Open diagnostics"
                        ToolTip="Open the structured failure details; the previous animation session was retained." />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding AssetBrowser.IndexedAssetCount, StringFormat={}{0:N0} catalog assets}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Foreground="{StaticResource WarningBrush}"
                           Text="DL1 only · live D3D11 authoring preview" />
            </StatusBarItem>
        </StatusBar>

        <Grid x:Name="EditorRootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Running-job indicator. The Jobs drawer is hidden outside the
                 animation workspaces, so exports and project loads used to run
                 with no visible feedback at all. This spans every row and sits
                 above WorkflowDockManager (ZIndex 500). It is deliberately not
                 a modal: only the card itself is hit-testable, so the rest of
                 the window stays usable while work runs. -->
            <Border x:Name="ActiveJobIndicator"
                    Grid.RowSpan="4"
                    Panel.ZIndex="600"
                    Width="360"
                    Padding="14"
                    Margin="0,0,0,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource PanelRaisedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding HasActiveJob, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Text="{Binding ActiveJob.Name}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding ActiveJob.Stage}"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar Height="10"
                                 Margin="0,8,0,0"
                                 Maximum="100"
                                 Value="{Binding ActiveJob.Progress, Mode=OneWay}" />
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                Command="{Binding ActiveJob.CancelCommand}"
                                Content="Cancel" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding ActiveJob.State}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="0"
                    MinHeight="46"
                    Padding="5,3"
                    Background="{StaticResource PanelRaisedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid x:Name="PrimaryToolbarLayout"
                      VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0"
                               VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="5,2">
                        <TextBlock Margin="0,0,5,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Workflow" />
                        <ToggleButton Command="{Binding SelectWorkspaceCommand}"
                                      CommandParameter="Models"
                                      Content="Models"
                                      ToolTip="Browse base-game models, preview without changing variants, and import project-owned custom FBX models."
                                      IsChecked="{Binding IsModelsWorkspace, Mode=OneWay}" />
                        <ToggleButton Command="{Binding SelectWorkspaceCommand}"
                                      CommandParameter="Animations"
                                      Content="Animations"
                                      ToolTip="Choose immutable sources and create model-specific target variants."
                                      IsChecked="{Binding IsAnimationsWorkspace, Mode=OneWay}" />
                        <ToggleButton Command="{Binding SelectWorkspaceCommand}"
                                      CommandParameter="Playback"
                                      Content="Playback"
                                      ToolTip="Play the active target variant; draft mappings preview visibly but cannot export."
                                      IsChecked="{Binding IsPlaybackWorkspace, Mode=OneWay}" />
                        <ToggleButton Command="{Binding SelectWorkspaceCommand}"
                                      CommandParameter="Retarget/Edit"
                                      Content="Retarget / Edit"
                                      IsChecked="{Binding IsRetargetWorkspace, Mode=OneWay}" />
                        <ToggleButton Command="{Binding SelectWorkspaceCommand}"
                                      CommandParameter="Export"
                                      Content="Export"
                                      IsChecked="{Binding IsExportWorkspace, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,2"
                                Visibility="{Binding IsAnimationAuthoringWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Root policy" />
                        <ComboBox Width="112"
                                   Margin="6,0"
                                   ItemsSource="{Binding RootMotionModes}"
                                   SelectedItem="{Binding SelectedRootMotionMode}"
                                   ToolTip="Saved per animation. Recorded keeps decoded tracks, InPlace removes travel, Bip01 transfers locomotion to the selected skeletal root, and MotionAccumulator authors the DL1 accumulator policy." />
                        <TextBlock Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Root bone" />
                        <ComboBox Width="100"
                                  Margin="6,0"
                                  ItemsSource="{Binding RootBoneCandidates}"
                                  SelectedItem="{Binding SelectedRootBoneName}"
                                  ToolTip="Saved on this animation target variant and shared by preview and export." />
                        <TextBlock Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Preview" />
                        <ComboBox Width="112"
                                  Margin="6,0"
                                  ItemsSource="{Binding PreviewModes}"
                                  SelectedItem="{Binding SelectedPreviewMode}"
                                  ToolTip="Raw shows decoded/authored data without runtime emulation. DL1 profile enables the selected versioned body, FPP, or movie authoring context." />
                        <ToggleButton Content="Accumulate"
                                      IsChecked="{Binding PreviewMotionAccumulationEnabled}"
                                      ToolTip="Preview the auxiliary 0xCCC3CDDF accumulator as actor/world translation and yaw. Skeletal locals and export data remain recorded and untouched." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,2"
                                Visibility="{Binding IsAnimationWorkspaceSurfaceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    </StackPanel>
                    </WrapPanel>
                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Margin="4,2"
                                Visibility="{Binding IsAnimationAuthoringWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Command="{Binding Timeline.StepBackwardCommand}" Content="◀|" />
                        <Button Command="{Binding Timeline.TogglePlaybackCommand}"
                                Content="{Binding Timeline.PlaybackLabel}"
                                MinWidth="56" />
                        <Button Command="{Binding Timeline.StepForwardCommand}" Content="|▶" />
                        <ToggleButton Margin="8,0,0,0"
                                      Content="FPP camera"
                                      IsChecked="{Binding IsFppPlaybackEnabled}"
                                      Visibility="{Binding IsPlaybackWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      ToolTip="Toggle the active model's selected evaluated preview camera without changing animation data." />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="8,6,8,0"
                    Padding="10,7"
                    Background="{StaticResource PanelRaisedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Visibility="{Binding HasRecoverySnapshot, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Command="{Binding RestoreRecoveryCommand}" Content="Restore" />
                        <Button Command="{Binding DismissRecoveryCommand}" Content="Dismiss" />
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"
                               Text="A recoverable workspace snapshot is available from the previous session." />
                </DockPanel>
            </Border>

            <Grid x:Name="AnimationWorkspaceSurface"
                  Grid.Row="2"
                  Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RetargetExplorerColumn" Width="0" MinWidth="0" MaxWidth="0" />
                    <ColumnDefinition x:Name="RetargetExplorerSplitterColumn" Width="0" />
                    <ColumnDefinition x:Name="RetargetViewportColumn" Width="*" />
                    <ColumnDefinition x:Name="RetargetEditorSplitterColumn" Width="0" />
                    <ColumnDefinition x:Name="RetargetEditorColumn" Width="0" MinWidth="0" MaxWidth="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="RetargetViewportRow" Height="2*" MinHeight="140" />
                    <RowDefinition Height="6" />
                    <RowDefinition x:Name="RetargetEditorRow" Height="3*" MinHeight="220" />
                    <RowDefinition Height="6" />
                    <RowDefinition x:Name="RetargetBottomDockRow" Height="1.35*" MinHeight="90" />
                </Grid.RowDefinitions>

                <Border x:Name="ModelsWorkflowSurface"
                        Grid.ColumnSpan="5"
                        Grid.RowSpan="5"
                        Panel.ZIndex="35"
                        Margin="0"
                        Padding="12"
                        Background="#F0121821"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{Binding IsModelsWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="285" MinWidth="240" MaxWidth="360" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" MinWidth="0" MaxWidth="520" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" MinWidth="480" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ModelsProjectLibraryPane"
                                Style="{StaticResource PaneBorderStyle}">
                            <Grid Margin="9">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Project models" />
                                <TextBlock Grid.Row="1" Margin="0,3,0,7"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="Project-owned model references. Selecting a row never assigns it to an animation; targets are chosen in Animations."
                                           TextWrapping="Wrap" />
                                <ListBox Grid.Row="2"
                                         ItemsSource="{Binding ProjectModelLibrary}"
                                         PreviewMouseRightButtonDown="OnListBoxPreviewMouseRightButtonDown"
                                         SelectedItem="{Binding SelectedProjectModel}"
                                         Tag="{Binding}">
                                    <ListBox.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Command="{Binding EditSelectedProjectModelCommand}" Header="_Edit selected..." />
                                            <MenuItem Command="{Binding UseSelectedProjectModelAsSourceCommand}" Header="Use as _source" />
                                            <Separator />
                                            <MenuItem Command="{Binding RemoveSelectedProjectModelCommand}" Header="_Remove from project" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="3,5">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                <TextBlock FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Source}" />
                                                <TextBlock FontSize="10" Foreground="{StaticResource AccentBrush}" Text="{Binding Contract}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="3">
                                    <WrapPanel Margin="0,5,0,0">
                                        <Button Command="{Binding ImportCustomModelCommand}"
                                                Content="Import FBX..."
                                                ToolTip="Import a custom model into this project without changing the active animation target." />
                                        <Button Command="{Binding OpenCustomModelPackageCommand}"
                                                Content="Open .dlrmodel..."
                                                ToolTip="Add a portable custom-model package to this project." />
                                        <Button Command="{Binding EditSelectedProjectModelCommand}"
                                                Content="Edit selected..."
                                                ToolTip="Open the selected project-owned custom model for editing. Retail references remain preview-only." />
                                        <Button Command="{Binding RemoveSelectedProjectModelCommand}"
                                                Content="Remove selected"
                                                ToolTip="Remove the selected model from this project, with any animation targets that point at it. Custom models and base-game references alike; nothing on disk is deleted." />
                                    </WrapPanel>
                                    <TextBlock Margin="0,5,0,0" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="Imported custom models and checked embedded stacks enter the project immediately, including before the first Save." TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />
                        <Expander x:Name="ModelsRetailBrowserPane"
                                  Grid.Column="2"
                                  HorizontalContentAlignment="Stretch"
                                  Header="Base-game model browser"
                                  IsExpanded="True"
                                  ToolTip="Collapse the retail catalog to give the model preview more room.">
                        <Border Style="{StaticResource PaneBorderStyle}">
                            <Grid Margin="9">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Command="{Binding AssetBrowser.IndexGameCommand}"
                                            Content="{Binding AssetBrowser.CatalogActionLabel}" />
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="Retail catalog" />
                                </DockPanel>
                                <TextBlock Grid.Row="1" Margin="0,3,0,7"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="Filter retail models, preview them in isolation, or add an exact fingerprinted reference to this project. Preview never changes the active variant target."
                                           TextWrapping="Wrap" />
                                <Grid Grid.Row="2" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding AssetBrowser.SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter by model name, path, provider, or profile" />
                                    <ComboBox Grid.Column="1" Margin="6,0,0,0" ItemsSource="{Binding AssetBrowser.ProviderFilters}" SelectedItem="{Binding AssetBrowser.SelectedProviderFilter}" />
                                </Grid>
                                <Grid Grid.Row="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ListBox ItemsSource="{Binding AssetBrowser.VisibleAssets}"
                                             SelectedItem="{Binding AssetBrowser.SelectedAsset}"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="3,5">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                    <TextBlock FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="{Binding LogicalPath}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="10" Foreground="{StaticResource AccentBrush}" Text="{Binding ProfileSummary}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <WrapPanel Grid.Row="1" Margin="0,7,0,0">
                                        <Button Command="{Binding PreviewSelectedAssetCommand}" Content="Preview selected" />
                                        <Button Command="{Binding AddSelectedModelToProjectCommand}" Content="Add to project" />
                                        <Button Command="{Binding ExportSelectedBrowserMeshToFbxCommand}" Content="Export mesh FBX..." />
                                        <TextBlock Margin="8,5,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding AssetBrowser.ResultSummary}" />
                                    </WrapPanel>
                                </Grid>
                            </Grid>
                        </Border>
                        </Expander>
                        <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" />
                        <Border x:Name="ModelsPreviewPane"
                                Grid.Column="4"
                                Style="{StaticResource PaneBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Margin="9,7,9,6">
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="Model preview" />
                                    <TextBlock Margin="0,3,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="Selection-only preview. The active animation source and every target variant remain unchanged."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <views:ViewportPane Grid.Row="1"
                                                    DataContext="{Binding TargetViewport}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Animations is a library workspace, not a second playback
                     editor. The compact source preview leaves the majority of
                     the surface to a sortable, virtualized source/variant
                     table. This surface owns its own viewport so no splitter
                     state is shared with Playback or Retarget/Edit. -->
                <Border x:Name="AnimationsWorkflowSurface"
                        Grid.ColumnSpan="5"
                        Grid.RowSpan="5"
                        Panel.ZIndex="36"
                        Padding="10"
                        Background="#F0121821"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{Binding IsAnimationsWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="AnimationsPreviewRow"
                                           Height="210"
                                           MinHeight="120"
                                           MaxHeight="520" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="*" MinHeight="230" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <DockPanel x:Name="AnimationsActionsPane"
                                       Margin="0,0,0,7">
                                <WrapPanel DockPanel.Dock="Right">
                                    <ToggleButton Content="Base-game animations"
                                                  IsChecked="{Binding IsRetailAnimationBrowserVisible}"
                                                  ToolTip="Search the indexed retail type-320 catalog and add a base-game clip to this project." />
                                    <Button Command="{Binding ImportAnimationCommand}"
                                            Content="Import animation..." />
                                    <Button Command="{Binding AddAnimationTargetsCommand}"
                                            Content="Add target to selected clip..."
                                            ToolTip="Create target variants only for the selected immutable animation source." />
                                    <Button Command="{Binding AssignAnimationLibraryCommand}"
                                            Content="Assign SCR..." />
                                    <Button Command="{Binding ActivateSelectedAnimationCommand}"
                                            Content="Play" />
                                    <Button Command="{Binding SelectWorkspaceCommand}"
                                            CommandParameter="Retarget/Edit"
                                            Content="Retarget / edit" />
                                    <Button Command="{Binding RenameSelectedAnimationCommand}"
                                            Content="Rename" />
                                    <Button Command="{Binding DuplicateSelectedAnimationCommand}"
                                            Content="Duplicate" />
                                    <Button Command="{Binding RemoveSelectedAnimationCommand}"
                                            Content="Remove" />
                                </WrapPanel>
                                <StackPanel>
                                    <TextBlock FontSize="17"
                                               FontWeight="SemiBold"
                                               Text="Animation library" />
                                    <TextBlock Margin="0,2,12,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="Sources stay immutable. Assign one or more project models, then review only the variants whose rigs actually differ."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Importing a raw ANM2 from this surface asks
                                 for a source model. Without the prompt here
                                 the request was only visible on the base-game
                                 browser, so the import stalled with no way to
                                 answer it. -->
                            <ContentControl Content="{Binding}"
                                            ContentTemplate="{StaticResource SourceModelPickerTemplate}"
                                            Visibility="{Binding IsExplorerSourceModelPickerActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" MinWidth="360" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" MinWidth="280" />
                            </Grid.ColumnDefinitions>
                            <views:ViewportPane x:Name="AnimationsSourcePreviewPane"
                                                DataContext="{Binding SourceViewport}" />

                            <!-- Registered as its own dock pane, the way
                                 Playback registers playback.timeline. Nesting
                                 it around the viewport does not work: the dock
                                 controller detaches the viewport by name and
                                 would leave the transport behind. -->
                            <views:TimelinePanel x:Name="AnimationsSourceTimelinePane"
                                                 DataContext="{Binding Timeline}" />
                            <GridSplitter Grid.Column="1"
                                          Width="6"
                                          HorizontalAlignment="Stretch"
                                          Panel.ZIndex="100"
                                          Background="#516173"
                                          Cursor="SizeWE"
                                          ResizeBehavior="PreviousAndNext"
                                          ResizeDirection="Columns"
                                          ShowsPreview="False"
                                          ToolTip="Drag to resize the animation preview and details." />
                            <Border x:Name="AnimationsDetailsPane"
                                    Grid.Column="2"
                                    Padding="12"
                                    Style="{StaticResource PaneBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="15"
                                               FontWeight="SemiBold"
                                               Text="{Binding SelectedAnimationLibraryItem.Name, TargetNullValue=Select an animation}" />
                                    <TextBlock Grid.Row="1"
                                               Margin="0,5,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding SelectedAnimationLibraryItem.OriginModel, StringFormat=Origin: {0}, TargetNullValue=Origin: none}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2"
                                               Margin="0,3,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding SelectedAnimationLibraryItem.TargetModel, StringFormat=Target: {0}, TargetNullValue=Target: unassigned}"
                                               TextWrapping="Wrap" />
                                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                                        <TextBlock Foreground="{StaticResource AccentBrush}"
                                                   Text="{Binding SelectedAnimationLibraryItem.BindingState, TargetNullValue=Source only}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding SelectedAnimationLibraryItem.PrimaryScript, StringFormat=SCR: {0}, TargetNullValue=SCR: not assigned}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   Text="{Binding SelectedAnimationLibraryItem.Diagnostics}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Row="4"
                                            HorizontalAlignment="Left"
                                            Command="{Binding ActivateSelectedAnimationCommand}"
                                            Content="Play selected in Playback" />
                                </Grid>
                            </Border>
                        </Grid>

                        <GridSplitter Grid.Row="2"
                                      Height="6"
                                      HorizontalAlignment="Stretch"
                                      Panel.ZIndex="100"
                                      Background="#516173"
                                      Cursor="SizeNS"
                                      ResizeBehavior="PreviousAndNext"
                                      ResizeDirection="Rows"
                                      ShowsPreview="False"
                                      ToolTip="Drag to resize the preview and animation library." />

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="320" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="RetailAnimationBrowserPane"
                                    Margin="0,0,0,0"
                                    Padding="10"
                                    Style="{StaticResource PaneBorderStyle}"
                                    Visibility="{Binding IsRetailAnimationBrowserVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Command="{Binding AssetBrowser.IndexGameCommand}"
                                                Content="{Binding AnimationBrowser.CatalogActionLabel}" />
                                        <TextBlock FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Text="Base-game animation browser" />
                                    </DockPanel>
                                    <TextBlock Grid.Row="1"
                                               Margin="0,3,0,7"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="Retail type-320 clips and type-322 animation scripts. Adding either records an exact fingerprinted reference and never modifies the retail asset."
                                               TextWrapping="Wrap" />
                                    <Grid Grid.Row="2" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding AnimationBrowser.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Filter by animation name, path, or provider" />
                                        <ComboBox Grid.Column="1"
                                                  Margin="6,0,0,0"
                                                  ItemsSource="{Binding AnimationBrowser.ProviderFilters}"
                                                  SelectedItem="{Binding AnimationBrowser.SelectedProviderFilter}" />
                                    </Grid>

                                    <!-- Both prompts are hosted here so the add
                                         flow can finish on the surface that
                                         started it. Without them an ambiguous
                                         source model or a conflicting SCR
                                         timing is a dead end. -->
                                    <StackPanel Grid.Row="3">
                                        <ContentControl Content="{Binding}"
                                                        ContentTemplate="{StaticResource SourceModelPickerTemplate}"
                                                        Visibility="{Binding IsExplorerSourceModelPickerActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Border Margin="0,0,0,5"
                                                Padding="6"
                                                Background="{StaticResource PanelRaisedBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Visibility="{Binding IsExplorerAnimationTimingPickerActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock Foreground="{StaticResource TextBrush}"
                                                           Text="{Binding ExplorerAnimationTimingPrompt}"
                                                           TextWrapping="Wrap" />
                                                <ComboBox Margin="0,5,0,4"
                                                          DisplayMemberPath="SelectionLabel"
                                                          ItemsSource="{Binding ExplorerAnimationTimingChoices}"
                                                          SelectedItem="{Binding SelectedExplorerAnimationTiming}" />
                                                <WrapPanel>
                                                    <Button Command="{Binding ConfirmExplorerAnimationTimingCommand}"
                                                            Content="Use timing and play" />
                                                    <Button Command="{Binding CancelExplorerAnimationTimingCommand}"
                                                            Content="Cancel" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <Grid Grid.Row="4">
                                        <ListBox ItemsSource="{Binding AnimationBrowser.VisibleAssets}"
                                                 SelectedItem="{Binding AnimationBrowser.SelectedAsset}"
                                                 ScrollViewer.CanContentScroll="True"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="3,5">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                        <TextBlock FontSize="10"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   Text="{Binding Kind}" />
                                                        <TextBlock FontSize="10"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   Text="{Binding LogicalPath}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Margin="8"
                                                   VerticalAlignment="Top"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding AnimationBrowser.EmptyResultMessage}"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AnimationBrowser.HasFilteredAssets}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <WrapPanel Grid.Row="5" Margin="0,7,0,0">
                                        <Button Command="{Binding AddSelectedRetailAnimationCommand}"
                                                Content="Add to project &amp; play"
                                                ToolTip="Decode this clip against the current source model, add it to the project once, and start playback." />
                                        <Button Command="{Binding AddSelectedRetailAnimationScriptCommand}"
                                                Content="Add script to project"
                                                ToolTip="Fingerprint the selected type-322 AnimationScr and make it available to Extend existing script and retail-import choices." />
                                        <TextBlock Margin="8,5,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding AnimationBrowser.ResultSummary}" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                            <GridSplitter Grid.Column="1"
                                          Width="6"
                                          HorizontalAlignment="Stretch"
                                          Panel.ZIndex="100"
                                          Background="#516173"
                                          Cursor="SizeWE"
                                          ResizeBehavior="PreviousAndNext"
                                          ResizeDirection="Columns"
                                          ShowsPreview="False"
                                          ToolTip="Drag to resize the base-game animation browser."
                                          Visibility="{Binding IsRetailAnimationBrowserVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Border x:Name="AnimationsLibraryPane"
                                Grid.Column="2"
                                Style="{StaticResource PaneBorderStyle}">
                            <DataGrid x:Name="AnimationLibraryTable"
                                      AlternationCount="2"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="True"
                                      CanUserResizeColumns="True"
                                      CanUserSortColumns="True"
                                      EnableColumnVirtualization="True"
                                      EnableRowVirtualization="True"
                                      FrozenColumnCount="2"
                                      HorizontalScrollBarVisibility="Auto"
                                      ItemsSource="{Binding AnimationLibrary}"
                                      MouseDoubleClick="OnAnimationLibraryDoubleClick"
                                      SelectedItem="{Binding SelectedAnimationLibraryItem}"
                                      SelectionMode="Single"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                    PreviewMouseRightButtonDown="OnDataGridPreviewMouseRightButtonDown"
                                    Tag="{Binding}">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Command="{Binding OpenSelectedAnimationCommand}" Header="_Open" />
                                            <MenuItem Command="{Binding ActivateSelectedAnimationCommand}" Header="_Activate" />
                                            <Separator />
                                            <MenuItem Command="{Binding AddAnimationTargetsCommand}" Header="Add _target to selected clip..." />
                                            <MenuItem Command="{Binding RenameSelectedAnimationCommand}" Header="_Rename" />
                                            <MenuItem Command="{Binding DuplicateSelectedAnimationCommand}" Header="_Duplicate" />
                                            <MenuItem Command="{Binding RebindSelectedAnimationSourceCommand}" Header="Re_bind source" />
                                            <Separator />
                                            <MenuItem Command="{Binding RevealSelectedAnimationSourceCommand}" Header="Re_veal source" />
                                            <MenuItem Command="{Binding RemoveSelectedAnimationCommand}" Header="Re_move" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="230" MinWidth="160" Header="Animation">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <Border Margin="0,0,0,5"
                                                            Padding="6,3"
                                                            Background="#1C2A35"
                                                            BorderBrush="#39536A"
                                                            BorderThickness="0,0,0,1">
                                                        <Border.Style>
                                                            <Style TargetType="{x:Type Border}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowVariantGroupHeader}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontWeight="SemiBold"
                                                                   Text="{Binding VariantGroupLabel, StringFormat=Source: {0}}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding OriginModel, StringFormat=Origin: {0}}" />
                                                    </Border>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                    <TextBlock FontSize="9"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               Text="{Binding BindingState}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Width="190" MinWidth="130" Binding="{Binding OriginModel}" Header="Origin model / rig" IsReadOnly="True" />
                                    <DataGridTextColumn Width="190" MinWidth="130" Binding="{Binding TargetModel}" Header="Target model" IsReadOnly="True" />
                                    <DataGridTextColumn Width="150" MinWidth="110" Binding="{Binding BindingState}" Header="Binding" IsReadOnly="True" />
                                    <DataGridTextColumn Width="110" Binding="{Binding Cadence}" Header="Timing" IsReadOnly="True" />
                                    <DataGridTextColumn Width="105" Binding="{Binding Roles}" Header="Roles" IsReadOnly="True" />
                                    <DataGridTemplateColumn Width="128" Header="Root policy">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox BorderThickness="0"
                                                          Background="Transparent"
                                                          ItemsSource="{Binding RootMotionModes}"
                                                          SelectedItem="{Binding RootMotionMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          ToolTip="Saved on this animation. Recorded keeps decoded tracks, InPlace removes travel, Bip01 transfers locomotion to the skeletal root, and MotionAccumulator writes travel and heading to a separate accumulator track." />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="118" Header="Root bone">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox BorderThickness="0"
                                                          Background="Transparent"
                                                          ItemsSource="{Binding RootBoneCandidates}"
                                                          SelectedItem="{Binding RootBoneName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          ToolTip="Saved on this animation and shared by preview and export." />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Width="170" MinWidth="120" Binding="{Binding PrimaryScript}" Header="Primary SCR" IsReadOnly="True" />
                                    <DataGridTextColumn Width="220" MinWidth="140" Binding="{Binding EffectiveScripts}" Header="Imported SCRs" IsReadOnly="True" />
                                    <DataGridCheckBoxColumn Width="72" Binding="{Binding IncludeInPackage}" Header="Export" />
                                    <DataGridTextColumn Width="2*" MinWidth="180" Binding="{Binding Diagnostics}" Header="Status" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Playback is intentionally focused: one authoritative
                     target viewport and one timeline, with no library or
                     retarget inspector consuming the available width. -->
                <Border x:Name="PlaybackWorkflowSurface"
                        Grid.ColumnSpan="5"
                        Grid.RowSpan="5"
                        Panel.ZIndex="37"
                        Padding="10"
                        Background="#F0121821"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{Binding IsPlaybackWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="300" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="270" MinHeight="190" MaxHeight="430" />
                        </Grid.RowDefinitions>
                        <Border x:Name="PlaybackContextPane"
                                Margin="0,0,0,6"
                                Padding="10,7"
                                Background="#171D25"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Right">
                                    <ToggleButton Content="FPP camera"
                                                  IsChecked="{Binding IsFppPlaybackEnabled}" />
                                    <TextBlock Margin="8,5,4,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="Camera bone"
                                               Visibility="{Binding IsFppPlaybackEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ComboBox Width="160"
                                              ItemsSource="{Binding TargetPreviewCameraBoneOptions}"
                                              SelectedItem="{Binding SelectedTargetPreviewCameraBone}"
                                              ToolTip="Choose which target rig bone anchors the FPP preview. Auto-detect prefers EyeCamera, then the camera.eye role, then the head or neck."
                                              Visibility="{Binding IsFppPlaybackEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Button Command="{Binding SelectWorkspaceCommand}"
                                            CommandParameter="Animations"
                                            Content="Choose animation" />
                                    <Button Command="{Binding SelectWorkspaceCommand}"
                                            CommandParameter="Retarget/Edit"
                                            Content="Retarget / edit" />
                                </WrapPanel>
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold">
                                        <Run Text="{Binding ActiveAnimationLabel, Mode=OneWay}" />
                                        <Run Text="  |  " />
                                        <Run Text="{Binding TargetBindingStatusText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock FontSize="10" Foreground="{StaticResource MutedTextBrush}">
                                        <Run Text="Origin: " />
                                        <Run Text="{Binding ActiveSourceModelLabel, Mode=OneWay}" />
                                        <Run Text="  ->  Target: " />
                                        <Run Text="{Binding ActiveTargetModelLabel, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Margin="0,3,0,0"
                                               FontSize="10"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding FppPlaybackCameraStatus, Mode=OneWay}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding IsFppPlaybackEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Grid x:Name="PlaybackViewportGrid" Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="PlaybackFppCameraColumn" Width="0" MinWidth="0" MaxWidth="0" />
                                <ColumnDefinition x:Name="PlaybackFppSplitterColumn" Width="0" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- DataContext is assigned in code-behind: this
                                 pane is detached on every FPP toggle and an
                                 inherited binding returns null after that. -->
                            <views:ViewportPane x:Name="PlaybackFppViewportPane"
                                                Grid.Column="0" />
                            <GridSplitter Grid.Column="1"
                                          Width="6"
                                          HorizontalAlignment="Stretch"
                                          Panel.ZIndex="100"
                                          Background="#516173"
                                          Cursor="SizeWE"
                                          ResizeBehavior="PreviousAndNext"
                                          ResizeDirection="Columns"
                                          ShowsPreview="False"
                                          ToolTip="Drag to resize the FPP camera and external orbit panes." />
                            <views:ViewportPane x:Name="PlaybackTargetViewportPane"
                                                Grid.Column="2"
                                                DataContext="{Binding TargetViewport}" />
                        </Grid>
                        <GridSplitter Grid.Row="2"
                                      Height="6"
                                      HorizontalAlignment="Stretch"
                                      Panel.ZIndex="100"
                                      Background="#516173"
                                      Cursor="SizeNS"
                                      ResizeBehavior="PreviousAndNext"
                                      ResizeDirection="Rows"
                                      ShowsPreview="False"
                                      ToolTip="Drag to resize the playback viewport and timeline." />
                        <views:TimelinePanel x:Name="PlaybackTimelinePane"
                                             Grid.Row="3"
                                             DataContext="{Binding Timeline}" />
                    </Grid>
                </Border>

                <Border x:Name="ExportWorkflowSurface"
                        Grid.ColumnSpan="5"
                        Grid.RowSpan="5"
                        Panel.ZIndex="40"
                        Margin="0"
                        Padding="12"
                        Background="#F0121821"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{Binding IsExportWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TabControl x:Name="ExportTabControl">
                        <TabItem x:Name="ExportFilesTab" Header="Files">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right"
                                            Command="{Binding ApplyExportSelectionCommand}"
                                            Content="Save selection" />
                                    <StackPanel>
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="Choose files to export" />
                                        <TextBlock Margin="0,3,12,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="Select target-specific outputs in one list. A blocked row stays visible with its reason and is never silently skipped."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                                <Border Grid.Row="1"
                                        Margin="0,0,0,8"
                                        Padding="8"
                                        Style="{StaticResource PaneBorderStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="240" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="0,5,8,0"
                                                   Text="Animation pack name" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding AnimationRpackFileName, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Portable output file name. The .rpack extension is added when omitted." />
                                        <Button Grid.Column="2"
                                                Margin="8,0,0,0"
                                                Command="{Binding SelectAnimationRpackAppendSourceCommand}"
                                                Content="Append existing..."
                                                ToolTip="Choose an existing animation RPack whose resources should be preserved and merged into the exported pack." />
                                        <Button Grid.Column="3"
                                                Command="{Binding ClearAnimationRpackAppendSourceCommand}"
                                                Content="Clear append" />
                                        <CheckBox Grid.Column="4"
                                                  Margin="10,4,0,0"
                                                  IsChecked="{Binding ReplaceAnimationRpackConflicts}"
                                                  Content="Replace conflicts"
                                                  ToolTip="When checked, project animation and script resources replace same-name resources from the selected existing pack. Otherwise a collision blocks export." />
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   Grid.ColumnSpan="5"
                                                   Margin="0,5,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding AnimationRpackAppendSummary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding AnimationRpackAppendSummary}" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="2" Style="{StaticResource PaneBorderStyle}">
                                    <DataGrid x:Name="ExportVariantTable"
                                              AlternationCount="2"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserReorderColumns="True"
                                              CanUserResizeColumns="True"
                                              CanUserSortColumns="True"
                                              EnableColumnVirtualization="True"
                                              EnableRowVirtualization="True"
                                              FrozenColumnCount="2"
                                              HorizontalScrollBarVisibility="Auto"
                                              ItemsSource="{Binding ExportVariants}"
                                              SelectedItem="{Binding SelectedExportVariant}"
                                              SelectionMode="Single"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              PreviewMouseRightButtonDown="OnDataGridPreviewMouseRightButtonDown"
                                              Tag="{Binding}">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Command="{Binding ApplyAnimationScriptTargetCommand}" Header="_Apply to SCR" />
                                                <MenuItem Command="{Binding ApplyExportSelectionCommand}" Header="_Save selection" />
                                                <Separator />
                                                <MenuItem Command="{Binding ExportAnimationRPackCommand}" Header="Export animation _RPack..." />
                                                <MenuItem Command="{Binding ExportAnm2FilesCommand}" Header="Export A_NM2 files..." />
                                                <MenuItem Command="{Binding ExportFullProjectCommand}" Header="Export _full project..." />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.RowStyle>
                                            <Style TargetType="{x:Type DataGridRow}"
                                                   BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                        <Setter Property="ToolTip" Value="{Binding Readiness}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="70" Header="Export">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <!-- WPF hides tooltips on disabled controls unless
                                                             asked. A blocked row's checkbox is disabled, so
                                                             without this the reason never reaches the pointer
                                                             and the control reads as simply broken. -->
                                                        <CheckBox HorizontalAlignment="Center"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding IsEnabled}"
                                                                  ToolTip="{Binding Readiness}"
                                                                  ToolTipService.ShowOnDisabled="True" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <!-- Animation, Primary SCR and Output ANM2 are edited in
                                                 place. A rejected value reverts and is reported in
                                                 diagnostics rather than being written and failing
                                                 later at export. -->
                                            <DataGridTextColumn Width="220" MinWidth="150" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Header="Animation" />
                                            <DataGridTextColumn Width="190" MinWidth="130" Binding="{Binding OriginModel}" Header="Origin model / rig" IsReadOnly="True" />
                                            <DataGridTextColumn Width="190" MinWidth="130" Binding="{Binding TargetModel}" Header="Target model" IsReadOnly="True" />
                                            <DataGridTextColumn Width="160" MinWidth="110" Binding="{Binding BindingState}" Header="Binding" IsReadOnly="True" />
                                            <DataGridTextColumn Width="175" MinWidth="120" Binding="{Binding PrimaryScript, UpdateSourceTrigger=LostFocus}" Header="Primary SCR" />
                                            <DataGridTextColumn Width="185" MinWidth="130" Binding="{Binding ScriptMode}" Header="SCR mode" IsReadOnly="True" />
                                            <DataGridTextColumn Width="220" MinWidth="140" Binding="{Binding EffectiveScripts}" Header="Imported SCRs" IsReadOnly="True" />
                                            <DataGridTextColumn Width="180" MinWidth="120" Binding="{Binding OutputName, UpdateSourceTrigger=LostFocus}" Header="Output ANM2" />
                                            <DataGridTextColumn Width="2*" MinWidth="240" Binding="{Binding Readiness}" Header="Readiness / blocked reason" IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                                <Border Grid.Row="3"
                                        Margin="0,8,0,0"
                                        Style="{StaticResource PaneBorderStyle}">
                                    <StackPanel Margin="8">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="Animation script for the selected row" />
                                        <WrapPanel Margin="0,6,0,0">
                                            <TextBlock VerticalAlignment="Center"
                                                       Margin="0,0,6,0"
                                                       Text="Base game script" />
                                            <ComboBox Width="230"
                                                      IsEditable="False"
                                                      ItemsSource="{Binding TargetAnimationScriptOptions}"
                                                      SelectedItem="{Binding SelectedTargetAnimationScript}"
                                                      ToolTip="Stock animation scripts read from the shipped animscript source tree. Which script animates a given model is not recorded in retail data, so the preselection is a suggestion." />
                                            <CheckBox VerticalAlignment="Center"
                                                      Margin="14,0,6,0"
                                                      Content="DLC override"
                                                      IsChecked="{Binding IsDlcOverrideEnabled}"
                                                      ToolTip="Name the project script as a DLC append of the selected stock script. The retail script is left untouched." />
                                            <TextBox Width="230"
                                                     VerticalAlignment="Center"
                                                     MaxLength="128"
                                                     IsEnabled="{Binding IsDlcOverrideEnabled}"
                                                     Text="{Binding DlcOverrideScriptName, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Margin="10,0,0,0"
                                                    Command="{Binding ApplyAnimationScriptTargetCommand}"
                                                    Content="Apply to SCR" />
                                        </WrapPanel>
                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding AnimationScriptTargetSummary}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <DockPanel Grid.Row="4" Margin="0,8,0,0">
                                    <TextBlock VerticalAlignment="Center"
                                               Margin="5,0,12,0"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text="{Binding ExportSelectionSummary}" />
                                    <WrapPanel DockPanel.Dock="Right">
                                        <Button Command="{Binding ExportAnm2FilesCommand}" Content="Export ANM2 files..." />
                                        <Button Command="{Binding ExportAnimationRPackCommand}" Content="Export animation RPack..." />
                                        <Button Command="{Binding ExportCharacterFilesCommand}" Content="Export character files..." />
                                        <Button Command="{Binding ExportFullProjectCommand}" Content="Export full project..." />
                                    </WrapPanel>
                                </DockPanel>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="ExportAnimationScriptTab" Header="Animation script">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="17"
                                           FontWeight="SemiBold"
                                           Text="Edit animation script source" />
                                <TextBlock Grid.Row="1"
                                           Margin="0,3,0,8"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="SeqTrack rows and their event blocks, in the same loose .scr grammar the base game ships. Saving switches the script from generated to authored source. Events reach the Developer Tools and official-compiler outputs; an RPack export cannot carry them and says so."
                                           TextWrapping="Wrap" />
                                <DockPanel Grid.Row="2" Margin="0,0,0,8">
                                    <WrapPanel DockPanel.Dock="Right">
                                        <Button Command="{Binding CommitAnimationScriptTextCommand}"
                                                Content="Save script" />
                                        <Button Command="{Binding RevertAnimationScriptTextCommand}"
                                                Content="Revert to generated" />
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center"
                                                   Margin="0,0,6,0"
                                                   Text="Script" />
                                        <ComboBox Width="320"
                                                  DisplayMemberPath="Label"
                                                  ItemsSource="{Binding AnimationScriptLibraries}"
                                                  SelectedItem="{Binding SelectedScriptLibrary}" />
                                    </StackPanel>
                                </DockPanel>
                                <Border Grid.Row="3" Style="{StaticResource PaneBorderStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox AcceptsReturn="True"
                                                 AcceptsTab="True"
                                                 FontFamily="Consolas, Courier New, monospace"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 VerticalScrollBarVisibility="Auto"
                                                 SpellCheck.IsEnabled="False"
                                                 Text="{Binding AnimationScriptText, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="NoWrap" />
                                        <TextBlock Grid.Row="1"
                                                   Margin="6"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Text="{Binding AnimationScriptStateSummary}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="ExportDeveloperToolsTab" Header="Developer Tools">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Command="{Binding Models.SelectDeveloperToolsProjectCommand}"
                                            Content="Choose project..." />
                                    <StackPanel>
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="Send to Developer Tools" />
                                        <TextBlock Margin="0,3,12,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="Choose what this export should update. Modes differ in what they write and where, so the selected mode states it below."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Grid.Row="1"
                                           Margin="2,8,2,10"
                                           Foreground="{StaticResource AccentBrush}"
                                           Text="{Binding Models.DeveloperToolsProjectStatus}"
                                           TextWrapping="Wrap" />
                                <controls:ResponsiveUniformGrid Grid.Row="2" PreferredColumns="5" Margin="0,0,0,4">
                                    <ToggleButton Padding="12,10"
                                                  Command="{Binding SelectDeveloperToolsExportModeCommand}"
                                                  CommandParameter="AnimationsOnly"
                                                  Content="Animations only"
                                                  IsChecked="{Binding IsDeveloperToolsAnimationsOnlySelected, Mode=OneWay}" />
                                    <ToggleButton Padding="12,10"
                                                  Command="{Binding SelectDeveloperToolsExportModeCommand}"
                                                  CommandParameter="CharactersOnly"
                                                  Content="Characters (source)"
                                                  ToolTip="Stages MSH/CHR/BSCR/ASCR under data/characters for Developer Tools to compile."
                                                  IsChecked="{Binding IsDeveloperToolsCharactersOnlySelected, Mode=OneWay}" />
                                    <ToggleButton Padding="12,10"
                                                  Command="{Binding SelectDeveloperToolsExportModeCommand}"
                                                  CommandParameter="CharacterRpack"
                                                  Content="Characters (prebuilt RPack)"
                                                  ToolTip="Compiles a finished character RPack into out/ReAnimated. Not raw source."
                                                  IsChecked="{Binding IsDeveloperToolsCharacterRpackSelected, Mode=OneWay}" />
                                    <ToggleButton Padding="12,10"
                                                  Command="{Binding SelectDeveloperToolsExportModeCommand}"
                                                  CommandParameter="Anm2Only"
                                                  Content="ANM2 only"
                                                  IsChecked="{Binding IsDeveloperToolsAnm2OnlySelected, Mode=OneWay}" />
                                    <ToggleButton Padding="12,10"
                                                  Command="{Binding SelectDeveloperToolsExportModeCommand}"
                                                  CommandParameter="Full"
                                                  Content="Initial / full export"
                                                  IsChecked="{Binding IsDeveloperToolsFullProjectSelected, Mode=OneWay}" />
                                </controls:ResponsiveUniformGrid>
                                <TextBlock Grid.Row="3"
                                           Margin="2,0,2,10"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="{Binding DeveloperToolsExportModeSummary}"
                                           TextWrapping="Wrap" />
                                <Border Grid.Row="4"
                                        Padding="14"
                                        Style="{StaticResource PaneBorderStyle}">
                                    <StackPanel>
                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Current export" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding ExportSelectionSummary}"
                                                   TextWrapping="Wrap" />
                                        <!-- Characters compile on their own. Without this
                                             list a project with no animation rows had
                                             nothing to select, so "Characters only" could
                                             never run. -->
                                        <StackPanel Margin="0,10,0,0"
                                                    Visibility="{Binding IsCharacterCompilerRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock FontWeight="SemiBold" Text="Characters to compile" />
                                            <TextBlock Margin="0,2,0,4"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="Project-owned custom models. A character does not need an animation to be exported."
                                                       TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding CharacterExportSelections}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Margin="0,2"
                                                                  Content="{Binding ModelName}"
                                                                  IsChecked="{Binding IsSelected}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="This project owns no custom models yet. Import one in Models."
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasCharacterExportSelections}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Margin="0,10,0,2" FontWeight="SemiBold" Text="Latest result" />
                                        <TextBlock Text="{Binding DeveloperToolsExportStatus}"
                                                   TextWrapping="Wrap" />
                                        <Expander Margin="0,12,0,0" Header="Failure details and diagnostics">
                                            <StackPanel Margin="10,6,0,0">
                                                <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding DeveloperToolsExportDetails}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,6,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding Models.AnimationRefreshStatus}"
                                                           TextWrapping="Wrap" />
                                                <WrapPanel Margin="0,7,0,0">
                                                    <Button Command="{Binding Models.OpenDeploymentReceiptCommand}" Content="Open details" />
                                                    <Button Command="{Binding Models.CollectAnimationDiagnosticBundleCommand}" Content="Collect diagnostics..." />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                                <DockPanel Grid.Row="5" Margin="0,10,0,0">
                                    <Button DockPanel.Dock="Right"
                                            Padding="16,8"
                                            FontWeight="SemiBold"
                                            Command="{Binding DeployCurrentSelectionCommand}"
                                            Content="Export to Developer Tools" />
                                    <WrapPanel>
                                        <Button Command="{Binding Models.SelectModelCompilerCommand}"
                                                Content="Choose compiler..."
                                                Visibility="{Binding IsCharacterCompilerRequired, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Button Command="{Binding RollBackDeveloperToolsBatchCommand}" Content="Undo last export" />
                                    </WrapPanel>
                                </DockPanel>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>

                <Border Grid.Column="0" Style="{StaticResource PaneBorderStyle}">
                    <TabControl x:Name="ExplorerTabControl"
                                SelectedIndex="{Binding SelectedExplorerTabIndex}">
                        <TabItem x:Name="ExplorerAssetsTab" Header="Assets">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding AssetBrowser.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Filter by asset name, logical path, provider, or type" />
                                    <Button Grid.Column="1"
                                            Command="{Binding AssetBrowser.ClearSearchCommand}"
                                            Content="×"
                                            ToolTip="Clear filter" />
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="0,4">
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                MinWidth="96"
                                                Command="{Binding AssetBrowser.IndexGameCommand}"
                                                Content="{Binding AssetBrowser.CatalogActionLabel}"
                                                ToolTip="Load or validate the cached Dying Light 1 retail asset catalog. A full scan only runs when the cache is absent or stale." />
                                        <TextBlock VerticalAlignment="Center"
                                                   Margin="0,0,6,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding AssetBrowser.ResultSummary}" />
                                    </DockPanel>
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Command="{Binding PreviewSelectedAssetCommand}"
                                                Content="Preview now"
                                                ToolTip="Mesh selections preview automatically after a short pause. Use this to reload immediately; project and animation state remain unchanged." />
                                        <Button Command="{Binding UseSelectedAssetAsSourceCommand}"
                                                Content="Use as Source"
                                                ToolTip="Use this exact retail model fingerprint as the immutable source." />
                                        <Button Command="{Binding UseSelectedAssetAsTargetCommand}"
                                                Content="Use as Target"
                                                ToolTip="Create or reuse a target-specific variant transactionally." />
                                        <Button Command="{Binding PlaySelectedExplorerAnimationCommand}"
                                                Content="Play Animation"
                                                ToolTip="Decode this type-320 clip against the currently decoded source model, add it once, reset to frame zero, and play." />
                                    </WrapPanel>
                                </StackPanel>
                                <Grid Grid.Row="2" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Margin="0,0,2,0"
                                              ItemsSource="{Binding AssetBrowser.KindFilters}"
                                              SelectedItem="{Binding AssetBrowser.SelectedKindFilter}"
                                              ToolTip="Resource type" />
                                    <ComboBox Grid.Column="1"
                                              Margin="2,0,0,0"
                                              ItemsSource="{Binding AssetBrowser.ProviderFilters}"
                                              SelectedItem="{Binding AssetBrowser.SelectedProviderFilter}"
                                              ToolTip="Base, DLC, or configured provider" />
                                </Grid>
                                <StackPanel Grid.Row="3">
                                    <Border Margin="0,0,0,5"
                                            Padding="6"
                                            Background="#25344A"
                                            BorderBrush="{StaticResource AccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Visibility="{Binding IsExplorerSourceModelPickerActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Right"
                                                    Margin="6,0,0,0"
                                                    Command="{Binding CancelExplorerSourceModelPickerCommand}"
                                                    Content="Cancel" />
                                            <TextBlock VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextBrush}"
                                                       Text="{Binding ExplorerSourceModelPickerPrompt}"
                                                       TextWrapping="Wrap" />
                                        </DockPanel>
                                    </Border>
                                    <Border Margin="0,0,0,5"
                                            Padding="6"
                                            Background="{StaticResource PanelRaisedBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Visibility="{Binding IsExplorerAnimationTimingPickerActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Foreground="{StaticResource TextBrush}"
                                                       Text="{Binding ExplorerAnimationTimingPrompt}"
                                                       TextWrapping="Wrap" />
                                            <ComboBox Margin="0,5,0,4"
                                                      DisplayMemberPath="SelectionLabel"
                                                      ItemsSource="{Binding ExplorerAnimationTimingChoices}"
                                                      SelectedItem="{Binding SelectedExplorerAnimationTiming}" />
                                            <WrapPanel>
                                                <Button Command="{Binding ConfirmExplorerAnimationTimingCommand}"
                                                        Content="Use timing and play" />
                                                <Button Margin="4,0,0,0"
                                                        Command="{Binding CancelExplorerAnimationTimingCommand}"
                                                        Content="Cancel" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <Expander Grid.Row="4"
                                          Margin="0,0,0,4"
                                          Header="Decoded mesh filters"
                                          ToolTip="Family, geometry, perspective, facial, DLC, and variant filters use decoded classification evidence only.">
                                    <StackPanel Margin="0,4,0,0">
                                        <controls:ResponsiveUniformGrid PreferredColumns="2">
                                            <ComboBox Margin="0,0,2,2"
                                                      DisplayMemberPath="Label"
                                                      ItemsSource="{Binding AssetBrowser.GeometryFilters}"
                                                      SelectedItem="{Binding AssetBrowser.SelectedGeometryFilter}"
                                                      ToolTip="Static, skinned, metadata container, or explicit unknown geometry" />
                                            <ComboBox Margin="2,0,0,2"
                                                      DisplayMemberPath="Label"
                                                      ItemsSource="{Binding AssetBrowser.RigFamilyFilters}"
                                                      SelectedItem="{Binding AssetBrowser.SelectedRigFamilyFilter}"
                                                      ToolTip="Evidence-backed DL1 rig family" />
                                            <ComboBox Margin="0,2,2,2"
                                                      DisplayMemberPath="Label"
                                                      ItemsSource="{Binding AssetBrowser.RigSignatureFilters}"
                                                      SelectedItem="{Binding AssetBrowser.SelectedRigSignatureFilter}"
                                                      ToolTip="Exact decoded rig signature" />
                                            <ComboBox Margin="2,2,0,2"
                                                      DisplayMemberPath="Label"
                                                      ItemsSource="{Binding AssetBrowser.PerspectiveFilters}"
                                                      SelectedItem="{Binding AssetBrowser.SelectedPerspectiveFilter}"
                                                      ToolTip="Explicit decoded FPP/TPP evidence" />
                                            <ComboBox Margin="0,2,2,2"
                                                      DisplayMemberPath="Label"
                                                      ItemsSource="{Binding AssetBrowser.FacialFilters}"
                                                      SelectedItem="{Binding AssetBrowser.SelectedFacialFilter}"
                                                      ToolTip="Decoded facial morph support" />
                                            <ComboBox Margin="2,2,0,2"
                                                      DisplayMemberPath="Label"
                                                      ItemsSource="{Binding AssetBrowser.SourceScopeFilters}"
                                                      SelectedItem="{Binding AssetBrowser.SelectedSourceScopeFilter}"
                                                      ToolTip="Base game, DLC, user-added root, or explicit unknown scope" />
                                            <ComboBox Margin="0,2,2,2"
                                                      DisplayMemberPath="Label"
                                                      ItemsSource="{Binding AssetBrowser.DlcFilters}"
                                                      SelectedItem="{Binding AssetBrowser.SelectedDlcFilter}"
                                                      ToolTip="Decoded provider/DLC identity" />
                                            <ComboBox Margin="2,2,0,2"
                                                      DisplayMemberPath="Label"
                                                      ItemsSource="{Binding AssetBrowser.VariantFilters}"
                                                      SelectedItem="{Binding AssetBrowser.SelectedVariantFilter}"
                                                      ToolTip="Decoded variant inventory or a specific variant" />
                                        </controls:ResponsiveUniformGrid>
                                        <WrapPanel>
                                            <Button Command="{Binding AssetBrowser.ClassifyFilteredMeshesCommand}"
                                                    Content="Classify next 128"
                                                    ToolTip="Decode and classify a bounded batch matching the text, type, and provider filters on a cancellable background job." />
                                            <Button Margin="4,0,0,0"
                                                    Command="{Binding AssetBrowser.CancelProfileScanCommand}"
                                                    Content="Cancel" />
                                            <Button Margin="4,0,0,0"
                                                    Command="{Binding AssetBrowser.ResetProfileFiltersCommand}"
                                                    Content="Reset" />
                                        </WrapPanel>
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="10"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding AssetBrowser.ProfileScanStatus}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock FontSize="10"
                                                   Foreground="{StaticResource MutedTextBrush}">
                                            <Run Text="{Binding AssetBrowser.ClassifiedMeshCount, Mode=OneWay}" />
                                            <Run Text=" classified; " />
                                            <Run Text="{Binding AssetBrowser.PendingProfileCount, Mode=OneWay}" />
                                            <Run Text=" filtered mesh rows pending" />
                                        </TextBlock>
                                    </StackPanel>
                                </Expander>
                                <Grid Grid.Row="5" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding AdditionalRpackRoots}"
                                              SelectedItem="{Binding SelectedAdditionalRpackRoot}"
                                              ToolTip="Portable project-relative RPack roots; the first root has highest override precedence" />
                                    <Button Grid.Column="1"
                                            Command="{Binding AddAdditionalRpackRootCommand}"
                                            Content="+"
                                            ToolTip="Add a project-relative RPack folder" />
                                    <Button Grid.Column="2"
                                            Command="{Binding RemoveAdditionalRpackRootCommand}"
                                            Content="−"
                                            ToolTip="Remove the selected RPack folder" />
                                </Grid>
                                <Border Grid.Row="6"
                                        Margin="0,0,0,5"
                                        Padding="6"
                                        Background="#202A3A"
                                        BorderBrush="#40506A"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                    <StackPanel>
                                        <WrapPanel>
                                            <Button Padding="8,3"
                                                    Command="{Binding ExportSelectedMeshToBlenderFbxCommand}"
                                                    Content="Active variant to FBX…"
                                                    ToolTip="Export the active evaluated variant with its exact target mesh, rig, helpers/camera, skinning, shape keys, materials, and embedded textures." />
                                            <Button Margin="4,0,0,0"
                                                    Padding="8,3"
                                                    Command="{Binding ConfigureBlenderCommand}"
                                                    Content="Blender…"
                                                    ToolTip="Configure the optional local blender.exe used only for FBX writing." />
                                        </WrapPanel>
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="10"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding BlenderExportStatus}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="9"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   Text="Local use only — FBX/DDS output contains retail DL1 data and must not be redistributed. Base color only."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Grid Grid.Row="7">
                                    <ListBox x:Name="AssetExplorerList"
                                             ItemsSource="{Binding AssetBrowser.VisibleAssets}"
                                             MouseDoubleClick="OnAssetExplorerDoubleClick"
                                             PreviewMouseRightButtonDown="OnAssetExplorerPreviewMouseRightButtonDown"
                                             SelectedItem="{Binding AssetBrowser.SelectedAsset}"
                                             Tag="{Binding}">
                                        <ListBox.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Command="{Binding PreviewSelectedAssetCommand}"
                                                          Header="Preview selected asset" />
                                                <MenuItem Command="{Binding UseSelectedAssetAsSourceCommand}"
                                                          Header="Use selected mesh as source" />
                                                <MenuItem Command="{Binding UseSelectedAssetAsTargetCommand}"
                                                          Header="Use selected mesh as target" />
                                                <MenuItem Command="{Binding PlaySelectedExplorerAnimationCommand}"
                                                          Header="Play selected animation" />
                                                <Separator />
                                                <MenuItem Command="{Binding ExportSelectedBrowserMeshToFbxCommand}"
                                                          Header="Export to FBX…"
                                                          ToolTip="Create a self-contained FBX for this decoded retail mesh. Skinned meshes include their bind skeleton and weights; each decoded base-color texture is embedded." />
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="3,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                        <TextBlock FontSize="10"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   Text="{Binding LogicalPath}" />
                                                        <TextBlock FontSize="10"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   Text="{Binding Provider}" />
                                                        <TextBlock FontSize="10"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   Text="{Binding ProfileSummary}"
                                                                   ToolTip="{Binding ProfileEvidenceSummary}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1"
                                                            Margin="4"
                                                            Padding="5,2"
                                                            Background="{StaticResource AccentDimBrush}"
                                                            CornerRadius="8">
                                                        <TextBlock FontSize="9" Text="{Binding Kind}" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               MaxWidth="220"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding AssetBrowser.EmptyResultMessage}">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AssetBrowser.HasFilteredAssets}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="AnimationLibraryTab"
                                 Header="Animations">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Margin="4,2,4,6"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="Each clip keeps an immutable source rig. Target variants are grouped below and retain their own mapping, edits, face, IK, and attachments."
                                           TextWrapping="Wrap" />
                                <WrapPanel Grid.Row="1" Margin="0,0,0,5">
                                    <Button Command="{Binding ActivateSelectedAnimationCommand}" Content="Activate" />
                                    <Button Command="{Binding AddAnimationTargetsCommand}"
                                            Content="Add target to selected clip..."
                                            ToolTip="Create target variants only for the selected immutable animation source." />
                                    <Button Command="{Binding RenameSelectedAnimationCommand}" Content="Rename" />
                                    <Button Command="{Binding DuplicateSelectedAnimationCommand}" Content="Duplicate" />
                                    <Button Command="{Binding RebindSelectedAnimationSourceCommand}" Content="Rebind Source" />
                                    <Button Command="{Binding RemoveSelectedAnimationCommand}" Content="Remove" />
                                    <Button Command="{Binding RevealSelectedAnimationSourceCommand}" Content="Reveal source" />
                                    <Button Command="{Binding AttachSelectedAnimationAsFacialCommand}" Content="Attach as facial" />
                                </WrapPanel>
                                <ListBox x:Name="AnimationLibraryList"
                                         Grid.Row="2"
                                         ItemsSource="{Binding AnimationLibrary}"
                                         MouseDoubleClick="OnAnimationLibraryDoubleClick"
                                         PreviewMouseRightButtonDown="OnListBoxPreviewMouseRightButtonDown"
                                         SelectedItem="{Binding SelectedAnimationLibraryItem}"
                                         Tag="{Binding}">
                                    <ListBox.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Command="{Binding OpenSelectedAnimationCommand}" Header="_Open" />
                                            <MenuItem Command="{Binding ActivateSelectedAnimationCommand}" Header="_Activate" />
                                            <Separator />
                                            <MenuItem Command="{Binding AddAnimationTargetsCommand}" Header="Add _target to selected clip..." />
                                            <MenuItem Command="{Binding RenameSelectedAnimationCommand}" Header="_Rename" />
                                            <MenuItem Command="{Binding DuplicateSelectedAnimationCommand}" Header="_Duplicate" />
                                            <MenuItem Command="{Binding RebindSelectedAnimationSourceCommand}" Header="Re_bind source" />
                                            <MenuItem Command="{Binding AttachSelectedAnimationAsFacialCommand}" Header="Attach as _facial" />
                                            <Separator />
                                            <MenuItem Command="{Binding RevealSelectedAnimationSourceCommand}" Header="Re_veal source" />
                                            <MenuItem Command="{Binding RemoveSelectedAnimationCommand}" Header="Re_move" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="2,3"
                                                    Padding="6"
                                                    BorderBrush="#344258"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                <StackPanel>
                                                    <Border Margin="0,2,0,6"
                                                            Padding="7,4"
                                                            Background="#243044"
                                                            BorderBrush="#405574"
                                                            BorderThickness="1"
                                                            CornerRadius="3">
                                                        <Border.Style>
                                                            <Style TargetType="{x:Type Border}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowVariantGroupHeader}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontWeight="SemiBold"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   Text="{Binding VariantGroupLabel, StringFormat=Clip: {0}}" />
                                                    </Border>
                                                    <!-- LostFocus, not PropertyChanged: each commit
                                                         rebuilds the whole library list, so a
                                                         per-keystroke trigger would destroy the row
                                                         mid-edit. Enter commits explicitly. -->
                                                    <TextBox FontWeight="SemiBold"
                                                             MaxLength="128"
                                                             IsReadOnly="{Binding IsSourceOnly}"
                                                             Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                                                    <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Source, StringFormat=Source: {0}}" TextWrapping="Wrap" />
                                                    <TextBlock FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="{Binding SourceModel, StringFormat=Source model: {0}}" TextWrapping="Wrap" />
                                                    <TextBlock FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="{Binding TargetModel, StringFormat=Target: {0}}" TextWrapping="Wrap" />
                                                    <TextBlock FontSize="10" Foreground="{StaticResource MutedTextBrush}">
                                                        <Run Text="{Binding Roles, Mode=OneWay}" />
                                                        <Run Text=" | " />
                                                        <Run Text="{Binding Cadence, Mode=OneWay}" />
                                                        <Run Text=" | " />
                                                        <Run Text="{Binding Duration, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="10" Foreground="{StaticResource AccentBrush}" Text="{Binding MappingState}" />
                                                    <TextBlock FontSize="10" Foreground="{StaticResource WarningBrush}" Text="{Binding Diagnostics}" TextWrapping="Wrap" />
                                                    <TextBlock FontSize="9" FontWeight="Bold" Foreground="#67D5A7" Text="ACTIVE">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="ExplorerSkeletonTab" Header="Skeleton">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Margin="4"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="{Binding SelectedBoneLabel}" />
                                <WrapPanel Grid.Row="1"
                                           Margin="2,0,2,4">
                                    <CheckBox Margin="3,1"
                                              Content="Mesh"
                                              IsChecked="{Binding ShowMeshes}" />
                                    <CheckBox Margin="3,1"
                                              Content="All rig"
                                              IsChecked="{Binding ShowSkeletonOverlay}"
                                              ToolTip="Master visibility for all skeleton categories." />
                                    <CheckBox Margin="3,1"
                                              Content="Bones"
                                              IsChecked="{Binding ShowDeformBones}" />
                                    <CheckBox Margin="3,1"
                                              Content="Helpers"
                                              IsChecked="{Binding ShowHelpers}"
                                              ToolTip="Ordinary non-deforming helpers are yellow." />
                                    <CheckBox Margin="3,1"
                                              Content="Cameras"
                                              IsChecked="{Binding ShowCameraHelpers}"
                                              ToolTip="EyeCamera and RefCamera are classified separately from ordinary helpers." />
                                    <CheckBox Margin="3,1"
                                              Content="Props / pivots"
                                              IsChecked="{Binding ShowPropHelpers}"
                                              ToolTip="Animated prop pivots, such as the slums door rig, are separate from deform bones." />
                                </WrapPanel>
                                <TextBlock Grid.Row="2"
                                           Margin="4,0,4,5"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="9"
                                           Text="Select EyeCamera, PropHolder, or another helper below to highlight it orange in the viewport."
                                           TextWrapping="Wrap" />
                                <Grid Grid.Row="3">
                                    <TreeView ItemsSource="{Binding SkeletonRoots}"
                                              behaviors:TreeViewSelection.IsEnabled="True"
                                              behaviors:TreeViewSelection.SelectedItem="{Binding SelectedBone}">
                                        <TreeView.Resources>
                                            <HierarchicalDataTemplate DataType="{x:Type vm:SkeletonNodeViewModel}"
                                                                      ItemsSource="{Binding Children}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="◇" Foreground="{StaticResource AccentBrush}" />
                                                    <TextBlock Margin="5,0" Text="{Binding Name}" />
                                                    <TextBlock Margin="5,0"
                                                               FontSize="9"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               Text="{Binding Role}" />
                                                    <TextBlock Margin="5,0"
                                                               FontSize="9"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               Text="{Binding Index, StringFormat=№{0}}" />
                                                </StackPanel>
                                            </HierarchicalDataTemplate>
                                        </TreeView.Resources>
                                    </TreeView>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="Load a skinned mesh to inspect its hierarchy.">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SkeletonRoots.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>

                <GridSplitter Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              Background="#2D3541" />

                <Grid x:Name="ViewportRegionGrid"
                      Grid.Row="0"
                      Grid.ColumnSpan="5"
                      Visibility="{Binding IsRetargetWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="ViewportGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <!-- ColumnDefinition does not inherit DataContext. MainWindow owns
                                 these D3D airspace widths explicitly when workspace layout changes. -->
                            <ColumnDefinition x:Name="SourceViewportColumn" Width="*" />
                            <ColumnDefinition x:Name="ViewportSplitterColumn" Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="AnimationContextStrip"
                                Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Margin="0,0,0,5"
                                Padding="8,5"
                                HorizontalAlignment="Stretch"
                                Background="#171D25"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Margin="8,0,0,0"
                                            Padding="8,3"
                                            Click="OnResetRetargetLayoutClick"
                                            Content="Reset layout"
                                            ToolTip="Restore the default dock arrangement for the current workflow." />
                                    <TextBlock VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding ActiveAnimationLabel, Mode=OneWay}" />
                                        <Run Text="  |  " />
                                        <Run Text="{Binding TargetBindingStatusText, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                                <TextBlock FontSize="10"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap">
                                    <Run Text="Source: " />
                                    <Run Text="{Binding ActiveSourceModelLabel, Mode=OneWay}" />
                                    <Run Text="  →  Target: " />
                                    <Run Text="{Binding ActiveTargetModelLabel, Mode=OneWay}" />
                                </TextBlock>
                                <Border Margin="0,5,0,0"
                                        Padding="7,5"
                                        Background="{StaticResource PanelRaisedBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Visibility="{Binding IsTargetPlaybackBlocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DockPanel LastChildFill="True">
                                        <WrapPanel DockPanel.Dock="Right"
                                                   Margin="8,0,0,0">
                                            <Button Command="{Binding SelectWorkspaceCommand}"
                                                    CommandParameter="Retarget/Edit"
                                                    Content="Open retarget setup" />
                                            <Button Command="{Binding AcceptMappingProposalCommand}"
                                                    Content="Accept pending proposal &amp; play"
                                                    Visibility="{Binding HasPendingMappingProposal, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    ToolTip="Explicitly review every visible proposed mapping and required bind fallback, save that decision, then start target playback." />
                                        </WrapPanel>
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextBrush}"
                                                   Text="{Binding TargetPlaybackMessage}"
                                                   TextWrapping="Wrap" />
                                    </DockPanel>
                                </Border>
                                <Border Margin="0,5,0,0"
                                        Padding="7,5"
                                        Background="#25344A"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Visibility="{Binding IsDraftTargetPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                Margin="8,0,0,0"
                                                Command="{Binding SelectWorkspaceCommand}"
                                                CommandParameter="Retarget/Edit"
                                                Content="Review mapping" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Text="{Binding TargetPlaybackMessage}"
                                                   TextWrapping="Wrap" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <views:ViewportPane x:Name="SourceViewportPane"
                                            Grid.Row="1"
                                            DataContext="{Binding SourceViewport}" />
                        <GridSplitter Grid.Row="1"
                                      Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      Panel.ZIndex="100"
                                      Background="#516173"
                                      Cursor="SizeWE"
                                      ResizeBehavior="PreviousAndNext"
                                      ResizeDirection="Columns"
                                      ShowsPreview="False"
                                      ToolTip="Drag to resize the source and target viewports." />
                        <Grid x:Name="RetargetTargetViewportPane"
                              Grid.Row="1"
                              Grid.Column="2">
                            <views:ViewportPane DataContext="{Binding TargetViewport}" />
                            <Border Panel.ZIndex="25"
                                    Width="300"
                                    Padding="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource PanelRaisedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Visibility="{Binding IsTargetPlaybackBlocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               Text="{Binding TargetBindingStatusText}"
                                               TextAlignment="Center" />
                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="{StaticResource TextBrush}"
                                               Text="{Binding TargetPlaybackMessage}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <GridSplitter x:Name="RetargetViewportEditorSplitter"
                              Grid.Row="1"
                              Grid.ColumnSpan="5"
                              Height="6"
                              VerticalAlignment="Stretch"
                              Panel.ZIndex="100"
                              Background="#516173"
                              Cursor="SizeNS"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Rows"
                              ShowsPreview="True"
                              ToolTip="Drag to resize the viewports and retarget editor."
                              Visibility="{Binding IsRetargetWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Border x:Name="RetargetEditorSurface"
                        Grid.Row="2"
                        Grid.ColumnSpan="5"
                        Style="{StaticResource PaneBorderStyle}"
                        Visibility="{Binding IsRetargetWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TabControl x:Name="RetargetInspectorTabControl"
                                SelectedIndex="{Binding SelectedInspectorTabIndex}">
                        <TabItem x:Name="RetargetMappingTab" Header="Mapping"
                                 Visibility="{Binding IsRetargetWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.RowSpan="4"
                                        Panel.ZIndex="50"
                                        Padding="14"
                                        Background="{StaticResource PanelBackgroundBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Visibility="{Binding IsRetargetSetupVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel VerticalAlignment="Top">
                                        <TextBlock FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Text="Retarget setup" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding RetargetSetupSelectionLabel}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,8,0,12"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding RetargetSetupInstructions}"
                                                   TextWrapping="Wrap" />
                                        <Button Command="{Binding PreviewSelectedAssetCommand}"
                                                Content="Preview selected model" />
                                        <Button Command="{Binding UseSelectedAssetAsSourceCommand}"
                                                Content="Use selected model as source" />
                                        <Button Command="{Binding UseSelectedAssetAsTargetCommand}"
                                                Content="Use selected model as target" />
                                        <Button Margin="2,10,2,2"
                                                Command="{Binding ImportAnimationCommand}"
                                                Content="Import FBX / ANM2 animation…" />
                                        <TextBlock Margin="2,12,2,0"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   Text="The mapping table appears after an animation has an immutable source model and a target model. Catalog selection alone never rewrites a project."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <StackPanel>
                                    <WrapPanel>
                                        <Button Command="{Binding AutoMapCommand}" Content="Auto-map" />
                                        <Button Command="{Binding ValidateMappingCommand}"
                                                Content="Validate"
                                                ToolTip="Check deterministic identities, explicit row review, and required target-bind ownership" />
                                        <Button Command="{Binding SaveMappingProfileCommand}"
                                                Content="Save selections"
                                                ToolTip="Persist only the individually checked mapping and required target-bind review rows. This action never accepts every row automatically." />
                                        <Button Command="{Binding AcceptMappingProposalCommand}"
                                                Content="Accept pending proposal &amp; play"
                                                Visibility="{Binding HasPendingMappingProposal, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                ToolTip="Explicitly review every proposed row and required bind fallback, save the mapping, reset to frame zero, and start target playback." />
                                    </WrapPanel>
                                    <Expander Margin="0,6,0,0"
                                              Header="Assisted review and helper overrides"
                                              IsExpanded="False"
                                              ToolTip="Expand deterministic assisted-review controls and helper/camera fan-out authoring.">
                                        <StackPanel>
                                            <Border Padding="6"
                                                    Background="#202A39"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                <StackPanel>
                                                    <WrapPanel>
                                                        <CheckBox Margin="2,1,8,1"
                                                                  Content="Enable assisted review"
                                                                  IsChecked="{Binding IsAssistedReviewEnabled}"
                                                                  ToolTip="Machine-local preference. Checking this never changes a project by itself." />
                                                        <Button Command="{Binding ApplyAssistedReviewCommand}"
                                                                Content="Apply assisted review"
                                                                ToolTip="Explicitly score the current exact rig pair and lock only eligible deterministic rows." />
                                                    </WrapPanel>
                                                    <TextBlock Margin="2,4,2,0"
                                                               FontSize="9"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               Text="{Binding AssistedReviewPolicySummary}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Margin="4,7,4,3"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Text="Helper / camera fan-out" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Margin="0,0,3,0"
                                                          IsTextSearchEnabled="True"
                                                          ItemsSource="{Binding MappingSourceBoneOptions}"
                                                          SelectedItem="{Binding SelectedHelperOverrideSourceBone}"
                                                          ToolTip="One source may keep its ordinary body row and also drive multiple distinct helper targets." />
                                                <TextBlock Grid.Column="1"
                                                           Margin="3,0"
                                                           VerticalAlignment="Center"
                                                           Text="-&gt;" />
                                                <ComboBox Grid.Column="2"
                                                          Margin="3,0"
                                                          IsTextSearchEnabled="True"
                                                          ItemsSource="{Binding MappingHelperTargetOptions}"
                                                          SelectedItem="{Binding SelectedHelperOverrideTargetBone}"
                                                          ToolTip="Validated target helper, camera, or prop node. A target may appear in only one mapping row." />
                                                <Button Grid.Column="3"
                                                        Margin="3,0"
                                                        Command="{Binding AddHelperOverrideCommand}"
                                                        Content="Add helper override"
                                                        ToolTip="Add a rest-relative helper fan-out row without replacing the source's ordinary body mapping." />
                                                <Button Grid.Column="4"
                                                        Margin="3,0,0,0"
                                                        Command="{Binding RemoveHelperOverrideCommand}"
                                                        Content="Remove"
                                                        ToolTip="Remove the selected helper override. Ordinary body rows cannot be removed with this action." />
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                                <DataGrid Grid.Row="1"
                                          Margin="0,5"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          FrozenColumnCount="2"
                                          HorizontalScrollBarVisibility="Auto"
                                          ItemsSource="{Binding BoneMappings}"
                                          SelectedItem="{Binding SelectedBoneMapping}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="150"
                                                            Binding="{Binding SourceBone}"
                                                            Header="Source"
                                                            IsReadOnly="True" />
                                        <DataGridTemplateColumn Width="170"
                                                                Header="DL1 target">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox IsEditable="False"
                                                              IsTextSearchEnabled="True"
                                                              ItemsSource="{Binding TargetBoneOptions}"
                                                              SelectedItem="{Binding TargetBone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              StaysOpenOnEdit="True"
                                                              ToolTip="Choose a valid bone from the active target rig. Typing jumps to matching entries." />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Width="105"
                                                            Binding="{Binding MappingKindLabel}"
                                                            Header="Kind"
                                                            IsReadOnly="True" />
                                        <DataGridTemplateColumn Width="190" MinWidth="150"
                                                                Header="Transfer">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox IsEnabled="{Binding HasTarget}"
                                                              DisplayMemberPath="Label"
                                                              ItemsSource="{Binding TransferPolicyOptions}"
                                                              SelectedItem="{Binding SelectedTransferPolicyOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              ToolTip="{Binding SelectedTransferPolicyOption.Description}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="155" MinWidth="135"
                                                                Header="Components">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <controls:ResponsiveUniformGrid PreferredColumns="3"
                                                                 IsEnabled="{Binding HasTarget}"
                                                                 ToolTip="Choose any combination of Translation, Rotation, and Scale.">
                                                        <CheckBox HorizontalAlignment="Center"
                                                                  Content="T"
                                                                  IsChecked="{Binding IsTranslationEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <CheckBox HorizontalAlignment="Center"
                                                                  Content="R"
                                                                  IsChecked="{Binding IsRotationEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <CheckBox HorizontalAlignment="Center"
                                                                  Content="S"
                                                                  IsChecked="{Binding IsScaleEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </controls:ResponsiveUniformGrid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Width="62"
                                                            Binding="{Binding Confidence, StringFormat={}{0:P0}}"
                                                            Header="Match"
                                                            IsReadOnly="True" />
                                        <DataGridCheckBoxColumn Width="45"
                                                                Binding="{Binding IsLocked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Header="Lock" />
                                        <DataGridCheckBoxColumn Width="55"
                                                                Binding="{Binding IsReviewed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Header="Review" />
                                        <DataGridTextColumn Width="92"
                                                            Binding="{Binding ReviewState}"
                                                            Header="State"
                                                            IsReadOnly="True" />
                                        <DataGridTextColumn Width="125" MinWidth="100"
                                                            Binding="{Binding EvidenceMethod}"
                                                            Header="Method"
                                                            IsReadOnly="True" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border Grid.Row="2"
                                        MinHeight="62"
                                        MaxHeight="110"
                                        Margin="0,2,0,5"
                                        Padding="8"
                                        Background="#151C26"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        DataContext="{Binding SelectedBoneMapping}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,14,0">
                                            <TextBlock FontWeight="SemiBold" Text="Mapping evidence" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       Text="{Binding Confidence, StringFormat={}{0:P0}}" />
                                        </StackPanel>
                                        <ScrollViewer Grid.Column="1"
                                                      VerticalScrollBarVisibility="Auto">
                                            <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                                       Text="{Binding EvidenceSummary, TargetNullValue=Select a mapping row to see its evidence.}"
                                                       TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                                <Expander Grid.Row="3"
                                          Margin="0,2,0,5"
                                          Header="Required target-bind fallbacks"
                                          IsExpanded="False">
                                    <StackPanel>
                                    <TextBlock Margin="4,1,4,3"
                                               FontSize="9"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="Check only target bones you intentionally want to leave at their decoded bind-local transform."
                                               TextWrapping="Wrap" />
                                    <DataGrid Height="108"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              ItemsSource="{Binding RequiredTargetBindReviews}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Width="150"
                                                                Binding="{Binding TargetBone}"
                                                                Header="DL1 target"
                                                                IsReadOnly="True" />
                                            <DataGridTextColumn Width="70"
                                                                Binding="{Binding BoneKind}"
                                                                Header="Kind"
                                                                IsReadOnly="True" />
                                            <DataGridCheckBoxColumn Width="55"
                                                                    Binding="{Binding IsReviewed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    Header="Review" />
                                            <DataGridTextColumn Width="100"
                                                                Binding="{Binding ReviewState}"
                                                                Header="State"
                                                                IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    </StackPanel>
                                </Expander>
                                <Border Grid.Row="4"
                                        Padding="8"
                                        Background="{StaticResource PanelRaisedBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                    <TextBlock Foreground="{StaticResource TextBrush}"
                                               TextWrapping="Wrap"
                                               Text="{Binding MappingReviewStatus}" />
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="RetargetEditTab" Header="Edit"
                                 Visibility="{Binding IsRetargetWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <TextBlock Style="{StaticResource PanelTitleStyle}" Text="Bone transform" />
                                    <TextBlock Margin="8,0,8,8"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding SelectedBoneLabel}" />
                                    <TextBlock Margin="8,4,8,3"
                                               FontWeight="SemiBold"
                                               Text="Viewport transform gizmo" />
                                    <ComboBox Margin="6,0,6,4"
                                              ItemsSource="{Binding BoneEditor.GizmoModes}"
                                              SelectedItem="{Binding BoneEditor.GizmoMode}"
                                              ToolTip="Translate moves along an axis, Rotate authors quaternion keys, and Scale applies a bounded positive local-axis multiplier." />
                                    <ComboBox Margin="6,0,6,4"
                                              IsEnabled="{Binding BoneEditor.IsGizmoSpaceEnabled}"
                                              ItemsSource="{Binding BoneEditor.GizmoSpaces}"
                                              SelectedItem="{Binding BoneEditor.GizmoSpace}"
                                              ToolTip="Local follows the selected bone orientation. Global uses world X/Y/Z axes. Scale is always local." />
                                    <TextBlock Margin="8,0,8,8"
                                               FontSize="10"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="Drag colored handles to stage a transient preview. Mouse-up stores one undoable key in the selected layer; canceled or zero-length drags store nothing." />
                                    <CheckBox Margin="8,2"
                                              Content="Lock bone"
                                              IsChecked="{Binding BoneEditor.Bone.IsLocked}" />

                                    <TextBlock Margin="8,12,8,3"
                                               FontWeight="SemiBold"
                                               Text="Translation" />
                                    <controls:ResponsiveUniformGrid Margin="6,0" PreferredColumns="3">
                                        <StackPanel Margin="2">
                                            <TextBlock FontSize="9" Text="X" />
                                            <TextBox Text="{Binding BoneEditor.Bone.PositionX, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="2">
                                            <TextBlock FontSize="9" Text="Y" />
                                            <TextBox Text="{Binding BoneEditor.Bone.PositionY, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="2">
                                            <TextBlock FontSize="9" Text="Z" />
                                            <TextBox Text="{Binding BoneEditor.Bone.PositionZ, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </controls:ResponsiveUniformGrid>

                                    <TextBlock Margin="8,12,8,3"
                                               FontWeight="SemiBold"
                                               Text="Rotation (degrees)" />
                                    <controls:ResponsiveUniformGrid Margin="6,0" PreferredColumns="3">
                                        <StackPanel Margin="2">
                                            <TextBlock FontSize="9" Text="X" />
                                            <TextBox Text="{Binding BoneEditor.Bone.RotationX, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="2">
                                            <TextBlock FontSize="9" Text="Y" />
                                            <TextBox Text="{Binding BoneEditor.Bone.RotationY, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="2">
                                            <TextBlock FontSize="9" Text="Z" />
                                            <TextBox Text="{Binding BoneEditor.Bone.RotationZ, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </controls:ResponsiveUniformGrid>

                                    <TextBlock Margin="8,12,8,3"
                                               FontWeight="SemiBold"
                                               Text="Scale" />
                                    <controls:ResponsiveUniformGrid Margin="6,0" PreferredColumns="3">
                                        <StackPanel Margin="2">
                                            <TextBlock FontSize="9" Text="X" />
                                            <TextBox Text="{Binding BoneEditor.Bone.ScaleX, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="2">
                                            <TextBlock FontSize="9" Text="Y" />
                                            <TextBox Text="{Binding BoneEditor.Bone.ScaleY, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="2">
                                            <TextBlock FontSize="9" Text="Z" />
                                            <TextBox Text="{Binding BoneEditor.Bone.ScaleZ, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </controls:ResponsiveUniformGrid>

                                    <StackPanel Margin="6,12" Orientation="Horizontal">
                                        <Button Command="{Binding BoneEditor.ApplyCommand}" Content="Apply transform" />
                                        <Button Command="{Binding BoneEditor.ResetCommand}" Content="Reset" />
                                        <Button Command="{Binding Timeline.AddKeyframeCommand}" Content="Keyframe" />
                                    </StackPanel>

                                    <TextBlock Margin="8,8,8,3"
                                               FontWeight="SemiBold"
                                               Text="Non-destructive bone layers" />
                                    <TextBlock Margin="8,0,8,5"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Text="Select a layer, stage its controls, then Apply. Enabled is the persisted, undoable A/B switch; the shown layer scope determines whether it reaches preview only or authored export. There is no hidden enable override that could misrepresent exported results. The decoded rest skeleton is never mutated." />
                                    <ComboBox Margin="6,0,6,4"
                                              DisplayMemberPath="Name"
                                              ItemsSource="{Binding BoneEditLayers}"
                                              SelectedItem="{Binding SelectedBoneEditLayer}"
                                              ToolTip="The selected layer receives numeric and gizmo bone keys" />
                                    <Border Margin="6,0"
                                            Padding="7"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            DataContext="{Binding SelectedBoneEditLayer}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="68" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox VerticalAlignment="Center"
                                                      Content="Enabled"
                                                      IsChecked="{Binding LayerEnabled}"
                                                      ToolTip="Persisted A/B switch evaluated according to the layer's shown scope; Apply commits one undoable project change" />
                                            <StackPanel Grid.Column="1"
                                                        Margin="8,0">
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{Binding Name}" />
                                                <TextBlock FontSize="9"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding Scope}" />
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Command="{Binding ApplyCommand}"
                                                    Content="Apply" />

                                            <TextBlock Grid.Row="1"
                                                       Margin="0,9,8,0"
                                                       VerticalAlignment="Center"
                                                       Text="Blend" />
                                            <ComboBox Grid.Row="1"
                                                      Grid.Column="1"
                                                      Grid.ColumnSpan="2"
                                                      Margin="0,7,0,0"
                                                      ItemsSource="{Binding BlendModes}"
                                                      SelectedItem="{Binding BlendMode}"
                                                      ToolTip="Additive stores local offsets; Override replaces the underlying local transform at the layer weight" />

                                            <TextBlock Grid.Row="2"
                                                       Margin="0,9,8,0"
                                                       VerticalAlignment="Center"
                                                       Text="Key interpolation" />
                                            <ComboBox Grid.Row="2"
                                                      Grid.Column="1"
                                                      Grid.ColumnSpan="2"
                                                      Margin="0,7,0,0"
                                                      IsEnabled="{Binding CanEditSelectedBoneInterpolation}"
                                                      ItemsSource="{Binding InterpolationModes}"
                                                      SelectedItem="{Binding SelectedBoneInterpolation}"
                                                      ToolTip="Interpolation for the selected bone track. Linear uses quaternion-safe slerp; Step holds the complete local transform." />

                                            <TextBlock Grid.Row="3"
                                                       Margin="0,9,8,0"
                                                       VerticalAlignment="Center"
                                                       Text="Layer weight" />
                                            <Slider Grid.Row="3"
                                                    Grid.Column="1"
                                                    Margin="0,7,8,0"
                                                    Minimum="0"
                                                    Maximum="1"
                                                    TickFrequency="0.05"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding Weight}" />
                                            <TextBox Grid.Row="3"
                                                     Grid.Column="2"
                                                     Margin="0,7,0,0"
                                                     HorizontalContentAlignment="Right"
                                                     Text="{Binding Weight, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F2}}"
                                                     ToolTip="Finite value clamped from 0 to 1" />

                                            <CheckBox Grid.Row="4"
                                                      Grid.ColumnSpan="3"
                                                      Margin="0,10,0,2"
                                                      Content="{Binding SelectedBoneLabel, StringFormat={}Use explicit mask for {0}}"
                                                      IsChecked="{Binding HasSelectedBoneMask}"
                                                      IsEnabled="{Binding CanEditSelectedBoneMask}"
                                                      ToolTip="Uncheck to remove this bone from the explicit mask; unlisted bones use 100%" />

                                            <TextBlock Grid.Row="5"
                                                       Margin="0,7,8,0"
                                                       VerticalAlignment="Center"
                                                       Text="Bone mask" />
                                            <Slider Grid.Row="5"
                                                    Grid.Column="1"
                                                    Margin="0,5,8,0"
                                                    Minimum="0"
                                                    Maximum="1"
                                                    TickFrequency="0.05"
                                                    IsSnapToTickEnabled="True"
                                                    IsEnabled="{Binding HasSelectedBoneMask}"
                                                    Value="{Binding SelectedBoneMaskWeight}" />
                                            <TextBox Grid.Row="5"
                                                     Grid.Column="2"
                                                     Margin="0,5,0,0"
                                                     HorizontalContentAlignment="Right"
                                                     IsEnabled="{Binding HasSelectedBoneMask}"
                                                     Text="{Binding SelectedBoneMaskWeight, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F2}}"
                                                     ToolTip="Finite per-bone multiplier clamped from 0 to 1" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Margin="8,4,8,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="9"
                                               TextWrapping="Wrap"
                                               Text="{Binding SelectedBoneEditLayer.ExplicitBoneMaskCount, StringFormat={}{0} explicit per-bone mask entries; unlisted bones use 100%.}" />

                                    <Border Margin="8"
                                            Padding="8"
                                            Background="#3B2228"
                                            BorderBrush="#713A43"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                        <TextBlock Foreground="#F2A1A5"
                                                   TextWrapping="Wrap"
                                                   Text="Bone keys are stored non-destructively in the project and deform decoded DL1 meshes through the GPU skinning preview. Diagnostic materials, unsupported morph layouts, normal deltas, and unvalidated game captures remain visible fidelity limits." />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="RetargetAttachmentsTab" Header="Attachments"
                                 Visibility="{Binding IsRetargetWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <TextBlock Style="{StaticResource PanelTitleStyle}"
                                               Text="DL1 prop / weapon" />
                                    <TextBlock Margin="8,0,8,8"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="One animated target can carry rigid retail props or weapons. Bindings follow the authoritative timeline and store identities and transforms, never retail bytes." />

                                    <TextBlock Margin="8,5,8,3"
                                               FontWeight="SemiBold"
                                               Text="Retail mesh" />
                                    <TextBox Margin="6,0,6,4"
                                             Text="{Binding AttachmentEditor.AssetSearch, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Filter decoded DL1 mesh resources for attachment selection" />
                                    <ComboBox Margin="6,0"
                                              DisplayMemberPath="Name"
                                              IsTextSearchEnabled="True"
                                              ItemsSource="{Binding AttachmentEditor.VisibleCatalogAssets}"
                                              SelectedItem="{Binding AttachmentEditor.SelectedCatalogAsset}"
                                              ToolTip="Retail mesh identity; the resource is decoded only when Add is pressed"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling" />

                                    <TextBlock Margin="8,10,8,3"
                                               FontWeight="SemiBold"
                                               Text="Parent bone / helper" />
                                    <ComboBox Margin="6,0"
                                              DisplayMemberPath="DisplayName"
                                              ItemsSource="{Binding AttachmentEditor.ParentBones}"
                                              SelectedItem="{Binding AttachmentEditor.SelectedParentBone}"
                                              ToolTip="Decoded target bones, helpers, camera nodes, and prop sockets are listed with their roles" />

                                    <TextBlock Margin="8,10,8,3"
                                               FontWeight="SemiBold"
                                               Text="Binding name" />
                                    <TextBox Margin="6,0"
                                             MaxLength="128"
                                             Text="{Binding AttachmentEditor.Name, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Margin="8,8,8,3"
                                              Content="Preview only"
                                              ToolTip="Preview-only bindings are excluded from authoritative export evaluation"
                                              IsChecked="{Binding AttachmentEditor.IsPreviewOnly}" />
                                    <Button Margin="6,8"
                                            Command="{Binding AddAttachmentCommand}"
                                            Content="Add retail attachment" />

                                    <TextBlock Margin="8,12,8,3"
                                               FontWeight="SemiBold"
                                               Text="Document attachments" />
                                    <ListBox Margin="6,0"
                                             MaxHeight="150"
                                             ItemsSource="{Binding AttachmentEditor.Attachments}"
                                             SelectedItem="{Binding AttachmentEditor.SelectedAttachment}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2,3">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{Binding Name}" />
                                                    <TextBlock FontSize="10"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               Text="{Binding AssetLabel}" />
                                                    <TextBlock FontSize="10"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               Text="{Binding ParentLabel}" />
                                                    <TextBlock FontSize="10"
                                                               Foreground="{StaticResource WarningBrush}"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding Status}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Margin="8,12,8,3"
                                               FontWeight="SemiBold"
                                               Text="Local translation" />
                                    <controls:ResponsiveUniformGrid Margin="6,0" PreferredColumns="3">
                                        <TextBox Margin="2" Text="{Binding AttachmentEditor.PositionX, UpdateSourceTrigger=LostFocus}" />
                                        <TextBox Margin="2" Text="{Binding AttachmentEditor.PositionY, UpdateSourceTrigger=LostFocus}" />
                                        <TextBox Margin="2" Text="{Binding AttachmentEditor.PositionZ, UpdateSourceTrigger=LostFocus}" />
                                    </controls:ResponsiveUniformGrid>

                                    <TextBlock Margin="8,10,8,3"
                                               FontWeight="SemiBold"
                                               Text="Local rotation (degrees)" />
                                    <controls:ResponsiveUniformGrid Margin="6,0" PreferredColumns="3">
                                        <TextBox Margin="2" Text="{Binding AttachmentEditor.RotationX, UpdateSourceTrigger=LostFocus}" />
                                        <TextBox Margin="2" Text="{Binding AttachmentEditor.RotationY, UpdateSourceTrigger=LostFocus}" />
                                        <TextBox Margin="2" Text="{Binding AttachmentEditor.RotationZ, UpdateSourceTrigger=LostFocus}" />
                                    </controls:ResponsiveUniformGrid>

                                    <TextBlock Margin="8,10,8,3"
                                               FontWeight="SemiBold"
                                               Text="Local scale" />
                                    <controls:ResponsiveUniformGrid Margin="6,0" PreferredColumns="3">
                                        <TextBox Margin="2" Text="{Binding AttachmentEditor.ScaleX, UpdateSourceTrigger=LostFocus}" />
                                        <TextBox Margin="2" Text="{Binding AttachmentEditor.ScaleY, UpdateSourceTrigger=LostFocus}" />
                                        <TextBox Margin="2" Text="{Binding AttachmentEditor.ScaleZ, UpdateSourceTrigger=LostFocus}" />
                                    </controls:ResponsiveUniformGrid>

                                    <WrapPanel Margin="6,10">
                                        <Button Command="{Binding ApplyAttachmentCommand}"
                                                Content="Apply offset" />
                                        <Button Command="{Binding FrameAttachmentCommand}"
                                                Content="Frame attachment"
                                                ToolTip="Frame only the selected prop or weapon in the target viewport" />
                                        <Button Command="{Binding ResetAttachmentOffsetCommand}"
                                                Content="Reset fields" />
                                        <Button Command="{Binding RemoveAttachmentCommand}"
                                                Content="Remove" />
                                    </WrapPanel>

                                    <Border Margin="8"
                                            Padding="8"
                                            Background="{StaticResource PanelRaisedBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                        <TextBlock Foreground="{StaticResource TextBrush}"
                                                   TextWrapping="Wrap"
                                                   Text="New attachments start at the selected bone/helper with zero local offset, so a prop may initially sit inside the actor. The selected attachment is highlighted and Frame attachment isolates it for inspection. A missing retail fingerprint or changed parent fails visibly and is never substituted." />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="RetargetIkTab" Header="IK"
                                 Visibility="{Binding IsRetargetWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <TextBlock Style="{StaticResource PanelTitleStyle}"
                                               Text="Validated two-bone IK" />
                                    <TextBlock Margin="8,0,8,8"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="Only chains decoded and validated for the selected retail rig are offered. Rigs without a validated chain retain normal FK bone editing." />
                                    <TextBlock Margin="8,5,8,3" Text="Chain" />
                                    <ComboBox Margin="6,0"
                                              ItemsSource="{Binding IkEditor.Chains}"
                                              SelectedItem="{Binding IkEditor.SelectedChain}" />

                                    <TextBlock Margin="8,12,8,3"
                                               FontWeight="SemiBold"
                                               Text="Effector (world)" />
                                    <controls:ResponsiveUniformGrid Margin="6,0" PreferredColumns="3">
                                        <TextBox Margin="2" Text="{Binding IkEditor.EffectorX, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Margin="2" Text="{Binding IkEditor.EffectorY, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Margin="2" Text="{Binding IkEditor.EffectorZ, UpdateSourceTrigger=PropertyChanged}" />
                                    </controls:ResponsiveUniformGrid>

                                    <TextBlock Margin="8,12,8,3"
                                               FontWeight="SemiBold"
                                               Text="Pole target (world)" />
                                    <controls:ResponsiveUniformGrid Margin="6,0" PreferredColumns="3">
                                        <TextBox Margin="2" Text="{Binding IkEditor.PoleX, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Margin="2" Text="{Binding IkEditor.PoleY, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Margin="2" Text="{Binding IkEditor.PoleZ, UpdateSourceTrigger=PropertyChanged}" />
                                    </controls:ResponsiveUniformGrid>

                                    <TextBlock Margin="8,12,8,3"
                                               FontWeight="SemiBold"
                                               Text="Constraint weight" />
                                    <Slider Margin="8,0"
                                            Minimum="0"
                                            Maximum="1"
                                            Value="{Binding IkEditor.Weight}" />

                                    <CheckBox Margin="8,12,8,3"
                                              Content="Author end orientation"
                                              IsChecked="{Binding IkEditor.UseEndOrientation}" />
                                    <controls:ResponsiveUniformGrid Margin="6,0" PreferredColumns="3">
                                        <TextBox Margin="2" Text="{Binding IkEditor.EndRotationX, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Margin="2" Text="{Binding IkEditor.EndRotationY, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Margin="2" Text="{Binding IkEditor.EndRotationZ, UpdateSourceTrigger=PropertyChanged}" />
                                    </controls:ResponsiveUniformGrid>

                                    <Button Margin="6,12"
                                            Command="{Binding KeyIkConstraintCommand}"
                                            Content="Key IK constraint" />
                                    <CheckBox Margin="8,2,8,3"
                                              Content="Mark keyed IK for baking to an authored bone layer"
                                              ToolTip="Baking samples every animation frame, creates ordinary FK override keys, and removes the IK layer in one undoable transaction"
                                              IsChecked="{Binding IkEditor.BakeToEditLayer}" />
                                    <Button Margin="6,6,6,12"
                                            Command="{Binding BakeIkConstraintCommand}"
                                            Content="Bake selected IK to bone layer" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="RetargetFacialFppTab" Header="Facial / FPP"
                                 Visibility="{Binding IsRetargetWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TabControl x:Name="RetargetFacialTabs">
                                <TabItem x:Name="RetargetFacialTab" Header="Facial">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBox Text="{Binding FacialFpp.MimicFilter, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Filter FED mimic presets and morph channels" />
                                         <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5">
                                             <Button Command="{Binding ImportFedCommand}" Content="Load FED..." />
                                             <Button Command="{Binding KeyMorphPoseCommand}" Content="Key facial pose" />
                                             <Button Command="{Binding FacialFpp.ResetMorphsCommand}" Content="Reset morphs" />
                                             <Button Command="{Binding FacialFpp.PreviewBlinkCommand}" Content="Blink" />
                                             <Button Command="{Binding FollowFacialAnimationCommand}" Content="Follow animation" ToolTip="Release the temporary face pose and show evaluated facial keys" />
                                         </StackPanel>
                                         <StackPanel Grid.Row="2" Margin="0,0,0,5">
                                         <Grid>
                                             <Grid.ColumnDefinitions>
                                                 <ColumnDefinition Width="*" />
                                                 <ColumnDefinition Width="Auto" />
                                             </Grid.ColumnDefinitions>
                                             <ComboBox ItemsSource="{Binding FacialFpp.VisibleMimicPresets}"
                                                       SelectedItem="{Binding FacialFpp.SelectedMimicPreset}"
                                                       ToolTip="FED expression preset" />
                                             <Button Grid.Column="1"
                                                     Command="{Binding PreviewFedExpressionCommand}"
                                                     Content="Preview FED" />
                                         </Grid>
                                         <WrapPanel Margin="0,5,0,0">
                                             <ComboBox Width="140" ItemsSource="{Binding FacialFpp.ExpressionPresets}"
                                                       SelectedItem="{Binding FacialFpp.SelectedExpression}" ToolTip="Model expression preset; replaces the current preview" />
                                             <TextBlock Text="Intensity" VerticalAlignment="Center" Margin="6,0" />
                                             <Slider Width="95" Minimum="0" Maximum="1" Value="{Binding FacialFpp.PresetIntensity}" />
                                             <CheckBox Content="Link sides" IsChecked="{Binding FacialFpp.LinkSides}" Margin="8,0" />
                                         </WrapPanel>
                                         <WrapPanel Margin="0,5,0,0">
                                             <TextBox Width="140" Text="{Binding FacialFpp.PresetName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Name for the captured pose" />
                                             <Button Command="{Binding FacialFpp.SaveExpressionCommand}" Content="Save preset" />
                                             <Button Command="{Binding SecondaryMotion.SaveModelCopyCommand}" Content="Save model copy..." ToolTip="Persist preset and secondary-motion changes to a new immutable model asset" />
                                             <Button Command="{Binding ExportFacialPresetsCommand}" Content="Save FED..." />
                                             <ComboBox Width="85" ItemsSource="{Binding FacialFpp.FacialGroups}" SelectedItem="{Binding FacialFpp.SelectedFacialGroup}" ToolTip="Facial control group" />
                                         </WrapPanel>
                                         <TextBlock Text="{Binding FacialFpp.ExpressionStatus}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,4" />
                                         <Expander Header="Speech and matched audio" IsExpanded="False">
                                             <StackPanel Margin="4">
                                                 <WrapPanel>
                                                     <Button Command="{Binding LoadSpeechExchangeCommand}" Content="Load speech..." />
                                                     <Button Command="{Binding LoadSpeechAudioCommand}" Content="Load audio..." />
                                                     <Button Command="{Binding ConfigureSpeechToolCommand}" Content="Configure DyingAudio..." />
                                                 </WrapPanel>
                                                 <ComboBox ItemsSource="{Binding SpeechEntries}" SelectedItem="{Binding SelectedSpeechEntry}" Margin="0,4" />
                                                 <CheckBox Content="Speech preview follows timeline" IsChecked="{Binding EnableSpeechPreview}" />
                                                 <TextBlock Text="{Binding SpeechPreviewStatus}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,4" />
                                             </StackPanel>
                                         </Expander>
                                         </StackPanel>
                                         <Expander Grid.Row="3"
                                                   Margin="0,2,0,7"
                                                   Header="Facial FBX mapping review"
                                                   IsExpanded="True">
                                             <StackPanel Margin="6">
                                                 <TextBlock Margin="0,0,0,6"
                                                            Foreground="{StaticResource MutedTextBrush}"
                                                            TextWrapping="Wrap"
                                                            Text="Choose how raw FBX DeformPercent values are authored. No value-range heuristic is used." />
                                                 <TextBlock Margin="0,0,0,6"
                                                            Foreground="{StaticResource MutedTextBrush}"
                                                            TextWrapping="Wrap"
                                                            Text="The FBX curves are retained on the body timeline for real-mesh preview. After enabled mappings are reviewed and locked, mimic ANM2 is generated through the same authored export pipeline." />
                                                 <Grid Margin="0,0,0,6">
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="*" />
                                                         <ColumnDefinition Width="Auto" />
                                                     </Grid.ColumnDefinitions>
                                                     <ComboBox MinWidth="96"
                                                               ItemsSource="{Binding FacialFpp.FacialSourceValueUnits}"
                                                               SelectedItem="{Binding FacialFpp.SelectedFacialSourceValueUnit}"
                                                               ToolTip="Required explicit source-value interpretation" />
                                                     <Button Grid.Column="1"
                                                             Margin="5,0,0,0"
                                                             Command="{Binding ImportFacialFbxCommand}"
                                                             Content="Import FBX..." />
                                                 </Grid>
                                                 <TextBlock Margin="0,0,0,6"
                                                            Foreground="{StaticResource MutedTextBrush}"
                                                            TextWrapping="Wrap"
                                                            Text="{Binding FacialFpp.FacialMappingReviewStatus}" />
                                                 <ScrollViewer MaxHeight="230"
                                                               VerticalScrollBarVisibility="Auto">
                                                     <ItemsControl ItemsSource="{Binding FacialFpp.FacialMappingReviews}">
                                                         <ItemsControl.ItemTemplate>
                                                             <DataTemplate>
                                                                 <Border Margin="0,0,0,5"
                                                                         Padding="6"
                                                                         Background="{StaticResource PanelRaisedBrush}"
                                                                         BorderBrush="{StaticResource BorderBrush}"
                                                                         BorderThickness="1"
                                                                         CornerRadius="2">
                                                                     <StackPanel>
                                                                         <TextBlock FontWeight="SemiBold"
                                                                                    TextWrapping="Wrap">
                                                                             <Run Text="{Binding SourceChannel, Mode=OneWay}" />
                                                                             <Run Text="  →  " />
                                                                             <Run Text="{Binding TargetMorph, Mode=OneWay}" />
                                                                         </TextBlock>
                                                                         <TextBlock Margin="0,2,0,3"
                                                                                    Foreground="{StaticResource MutedTextBrush}"
                                                                                    TextWrapping="Wrap">
                                                                             <Run Text="{Binding SourceValueUnit, Mode=OneWay}" />
                                                                             <Run Text=" · " />
                                                                             <Run Text="{Binding TargetDescriptor, Mode=OneWay}" />
                                                                             <Run Text=" · " />
                                                                             <Run Text="{Binding ConfidenceLabel, Mode=OneWay}" />
                                                                         </TextBlock>
                                                                         <WrapPanel>
                                                                             <CheckBox Margin="0,0,8,0"
                                                                                       Content="Enabled"
                                                                                       IsChecked="{Binding Enabled}" />
                                                                             <CheckBox Margin="0,0,8,0"
                                                                                       Content="Reviewed"
                                                                                       IsChecked="{Binding IsReviewed}" />
                                                                             <CheckBox Content="Locked"
                                                                                       IsChecked="{Binding IsLocked}"
                                                                                       ToolTip="A row can only be locked after it is reviewed" />
                                                                         </WrapPanel>
                                                                          <TextBlock Margin="0,3,0,0"
                                                                                     Foreground="{StaticResource MutedTextBrush}"
                                                                                     Text="{Binding ReviewState}" />
                                                                          <TextBlock Margin="0,3,0,0"
                                                                                     FontSize="9"
                                                                                     Foreground="{StaticResource MutedTextBrush}"
                                                                                     Text="{Binding EvidenceSummary}"
                                                                                     TextWrapping="Wrap" />
                                                                     </StackPanel>
                                                                 </Border>
                                                             </DataTemplate>
                                                         </ItemsControl.ItemTemplate>
                                                     </ItemsControl>
                                                 </ScrollViewer>
                                                 <WrapPanel Margin="0,2,0,0">
                                                     <Button Command="{Binding ApplyFacialMappingReviewCommand}"
                                                             Content="Apply row changes" />
                                                     <Button Command="{Binding ReviewAndLockAllFacialMappingsCommand}"
                                                             Content="Review + lock all"
                                                             ToolTip="Explicitly accepts every displayed suggestion and stores the locked rows in the project" />
                                                 </WrapPanel>
                                                 <StackPanel Margin="0,6,0,0">
                                                     <TextBlock FontWeight="SemiBold"
                                                                Text="Unmapped animated FBX channels">
                                                         <TextBlock.Style>
                                                             <Style TargetType="{x:Type TextBlock}">
                                                                 <Setter Property="Visibility" Value="Visible" />
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding FacialFpp.UnmappedFacialChannels.Count}" Value="0">
                                                                         <Setter Property="Visibility" Value="Collapsed" />
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </TextBlock.Style>
                                                     </TextBlock>
                                                     <ItemsControl ItemsSource="{Binding FacialFpp.UnmappedFacialChannels}">
                                                         <ItemsControl.ItemTemplate>
                                                             <DataTemplate>
                                                                 <TextBlock Foreground="{StaticResource WarningBrush}"
                                                                            TextWrapping="Wrap">
                                                                     <Run Text="• " />
                                                                     <Run Text="{Binding Mode=OneWay}" />
                                                                 </TextBlock>
                                                             </DataTemplate>
                                                         </ItemsControl.ItemTemplate>
                                                     </ItemsControl>
                                                 </StackPanel>
                                             </StackPanel>
                                         </Expander>
                                         <Grid Grid.Row="4">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding FacialFpp.VisibleMorphs}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="105" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="46" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                                                 <Slider Grid.Column="1"
                                                                         Margin="5,0"
                                                                         Minimum="-4"
                                                                         Maximum="4"
                                                                         Value="{Binding Weight, Mode=TwoWay}" />
                                                                 <TextBox Grid.Column="2"
                                                                          HorizontalContentAlignment="Right"
                                                                          ToolTip="Authored values remain unclamped; DL1 runtime limits apply only in the selected preview profile"
                                                                          Text="{Binding Weight, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F2}}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       MaxWidth="250"
                                                       TextAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="No morph channels match the current filter, or no decoded facial inventory is loaded.">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FacialFpp.VisibleMorphs.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Grid>
                                </TabItem>

                                <TabItem x:Name="RetargetSecondaryMotionTab" Header="Secondary motion">
                                    <views:SecondaryMotionView DataContext="{Binding SecondaryMotion}" />
                                </TabItem>
                                <TabItem x:Name="RetargetFppCameraTab" Header="FPP / camera">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="10">
                                            <Border Margin="4"
                                                    Padding="7"
                                                    Background="#25344A"
                                                    BorderBrush="{StaticResource AccentBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                <TextBlock Text="EyeCamera is always shown in the left FPP viewport. The right viewport remains a free external orbit."
                                                           TextWrapping="Wrap" />
                                            </Border>
                                            <CheckBox Margin="4"
                                                      Content="Request separate DL1 hands projection"
                                                      ToolTip="Requires captured DL1 FOV axis, aspect, and near-plane state; otherwise the stage is visibly unavailable"
                                                      IsChecked="{Binding FacialFpp.ShowHands}" />
                                            <CheckBox Margin="4"
                                                      Content="Show EyeCamera / RefCamera helpers"
                                                      IsChecked="{Binding FacialFpp.ShowCameraRig}" />
                                            <CheckBox Margin="4"
                                                      Content="Apply DL1 HSpine/HSpine1 basis correction"
                                                      ToolTip="Preview-only correction matched to the DL1 decompile; enabled by default, but not game validated"
                                                      IsChecked="{Binding FacialFpp.EnableHSpineBasisCorrection}" />
                                            <CheckBox Margin="4"
                                                      Content="Request full DL1 head-position correction"
                                                      ToolTip="Unavailable without captured movement, look, sprint, edge, landing, controller, and spring state"
                                                      IsChecked="{Binding FacialFpp.EnableHeadPositionCorrection}" />
                                            <CheckBox Margin="4"
                                                      Content="Request DL1 hand inertia"
                                                      ToolTip="The stage stays unavailable without captured player/camera velocities, controller state, and frame history"
                                                      IsChecked="{Binding FacialFpp.EnableHandInertia}" />

                                            <Expander Margin="4,12,4,2"
                                                      Header="User/runtime-capture projection inputs"
                                                      IsExpanded="True">
                                                <StackPanel Margin="8,6,4,4">
                                                    <TextBlock Margin="0,0,0,8"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               TextWrapping="Wrap"
                                                               Text="Enter values from a specific runtime capture. They are project authoring inputs, not proof of game validation. No DL1 numeric defaults are inferred." />
                                                    <CheckBox Margin="0,2,0,8"
                                                              Content="Enable stored capture for FPP preview"
                                                              IsChecked="{Binding FacialFpp.UseProjectionCapture}" />
                                                    <TextBlock Text="Capture label / build note (optional)" />
                                                    <TextBox Margin="0,2,0,10"
                                                             Text="{Binding FacialFpp.ProjectionCaptureLabel, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="Scene camera (captured)" />
                                                    <Grid Margin="0,5,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,5,0">
                                                            <TextBlock Text="Vertical FOV °" />
                                                            <TextBox Text="{Binding FacialFpp.SceneCaptureFieldOfView, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1"
                                                                    Margin="0,0,5,0">
                                                            <TextBlock Text="Aspect" />
                                                            <TextBox Text="{Binding FacialFpp.SceneCaptureAspectRatio, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Near (m)" />
                                                            <TextBox Text="{Binding FacialFpp.SceneCaptureNearPlane, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="Hands (captured, separate projection)" />
                                                    <Grid Margin="0,5,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,5,0">
                                                            <TextBlock Text="FOV °" />
                                                            <TextBox Text="{Binding FacialFpp.HandsCaptureFieldOfView, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="FOV axis" />
                                                            <ComboBox ItemsSource="{Binding FacialFpp.ProjectionFovAxes}"
                                                                      SelectedItem="{Binding FacialFpp.HandsCaptureFieldOfViewAxis}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,5,0">
                                                            <TextBlock Text="Aspect" />
                                                            <TextBox Text="{Binding FacialFpp.HandsCaptureAspectRatio, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="Near (m)" />
                                                            <TextBox Text="{Binding FacialFpp.HandsCaptureNearPlane, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Margin="0,0,0,8"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               Text="Hands far plane: Infinite (fixed DL1 projection contract)" />
                                                    <Button HorizontalAlignment="Left"
                                                            Padding="10,4"
                                                            Command="{Binding StoreFppProjectionCaptureCommand}"
                                                            Content="Store capture inputs in project" />
                                                    <TextBlock Margin="0,8,0,0"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding FacialFpp.ProjectionCaptureStatus}" />
                                                </StackPanel>
                                            </Expander>

                                            <TextBlock Margin="4,14,4,3"
                                                       FontWeight="SemiBold"
                                                       Text="Editor fallback FOV" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="55" />
                                                </Grid.ColumnDefinitions>
                                                <Slider Minimum="30"
                                                        Maximum="120"
                                                        Value="{Binding FacialFpp.FieldOfView, Mode=TwoWay}" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding FacialFpp.FieldOfView, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>

                                            <TextBlock Margin="4,14,4,3"
                                                       FontWeight="SemiBold"
                                                       Text="Editor fallback near clip" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="55" />
                                                </Grid.ColumnDefinitions>
                                                <Slider Minimum="0.001"
                                                        Maximum="0.2"
                                                        Value="{Binding FacialFpp.NearPlane, Mode=TwoWay}" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding FacialFpp.NearPlane, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>

                                            <Border Margin="0,15,0,0"
                                                    Padding="9"
                                                    Background="{StaticResource PanelRaisedBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                <TextBlock Foreground="{StaticResource TextBrush}"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding FacialFpp.PreviewStatus}" />
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <TabItem x:Name="RetargetMovieCameraTab" Header="Movie camera">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="10">
                                            <TextBlock Margin="4,0,4,8"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Text="Enter an explicit external DL1 movie IBaseCamera world transform and lens. A skeleton helper named RefCamera is never used as a substitute. These values are authoring input, not trusted game-validation evidence." />
                                            <CheckBox Margin="4"
                                                      Content="Use external movie reference camera"
                                                      IsChecked="{Binding FacialFpp.UseMovieReferenceCameraCapture}" />
                                            <TextBlock Margin="4,8,4,2"
                                                       Text="Capture label / build note (optional)" />
                                            <TextBox Margin="4,0,4,10"
                                                     Text="{Binding FacialFpp.MovieReferenceCameraCaptureLabel, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Margin="4,2"
                                                       FontWeight="SemiBold"
                                                       Text="World position" />
                                            <controls:ResponsiveUniformGrid Margin="4,2,4,8"
                                                                            PreferredColumns="3">
                                                <StackPanel Margin="0,0,4,0">
                                                    <TextBlock Text="X" />
                                                    <TextBox Text="{Binding FacialFpp.MovieCameraPositionX, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,4,0">
                                                    <TextBlock Text="Y" />
                                                    <TextBox Text="{Binding FacialFpp.MovieCameraPositionY, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="Z" />
                                                    <TextBox Text="{Binding FacialFpp.MovieCameraPositionZ, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                                </StackPanel>
                                            </controls:ResponsiveUniformGrid>

                                            <TextBlock Margin="4,2"
                                                       FontWeight="SemiBold"
                                                       Text="World rotation quaternion (XYZW)" />
                                            <controls:ResponsiveUniformGrid Margin="4,2,4,8"
                                                                            PreferredColumns="4">
                                                <StackPanel Margin="0,0,4,0">
                                                    <TextBlock Text="X" />
                                                    <TextBox Text="{Binding FacialFpp.MovieCameraRotationX, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,4,0">
                                                    <TextBlock Text="Y" />
                                                    <TextBox Text="{Binding FacialFpp.MovieCameraRotationY, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,4,0">
                                                    <TextBlock Text="Z" />
                                                    <TextBox Text="{Binding FacialFpp.MovieCameraRotationZ, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="W" />
                                                    <TextBox Text="{Binding FacialFpp.MovieCameraRotationW, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                                </StackPanel>
                                            </controls:ResponsiveUniformGrid>

                                            <TextBlock Margin="4,2"
                                                       FontWeight="SemiBold"
                                                       Text="Captured lens" />
                                            <controls:ResponsiveUniformGrid Margin="4,2,4,10"
                                                                            PreferredColumns="2">
                                                <StackPanel Margin="0,0,4,5">
                                                    <TextBlock Text="Vertical FOV" />
                                                    <TextBox Text="{Binding FacialFpp.MovieCameraVerticalFieldOfView, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,5">
                                                    <TextBlock Text="Aspect" />
                                                    <TextBox Text="{Binding FacialFpp.MovieCameraAspectRatio, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,4,0">
                                                    <TextBlock Text="Near (m)" />
                                                    <TextBox Text="{Binding FacialFpp.MovieCameraNearPlane, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="Far (m)" />
                                                    <TextBox Text="{Binding FacialFpp.MovieCameraFarPlane, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                                </StackPanel>
                                            </controls:ResponsiveUniformGrid>

                                            <Button Margin="4"
                                                    HorizontalAlignment="Left"
                                                    Padding="10,4"
                                                    Command="{Binding StoreMovieReferenceCameraCaptureCommand}"
                                                    Content="Store movie camera in project" />
                                            <TextBlock Margin="4,8,4,0"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding FacialFpp.MovieReferenceCameraStatus}" />
                                            <Border Margin="4,15,4,0"
                                                    Padding="9"
                                                    Background="{StaticResource PanelRaisedBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                <TextBlock Foreground="{StaticResource TextBrush}"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding FacialFpp.PreviewStatus}" />
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </TabItem>
                    </TabControl>
                </Border>

                <GridSplitter Grid.Row="3"
                              Grid.ColumnSpan="5"
                              Height="6"
                              VerticalAlignment="Stretch"
                              Panel.ZIndex="100"
                              Background="#516173"
                              Cursor="SizeNS"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Rows"
                              ShowsPreview="False"
                              ToolTip="Drag to resize the retarget editor and bottom dock."
                              Visibility="{Binding IsRetargetWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TabControl x:Name="RetargetBottomDock"
                            Grid.Row="4"
                            Grid.ColumnSpan="5"
                            Visibility="{Binding IsRetargetWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TabItem x:Name="RetargetAnimationsTab" Header="Animations">
                        <DataGrid x:Name="RetargetAnimationLibraryTable"
                                  AlternationCount="2"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="True"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="True"
                                  EnableColumnVirtualization="True"
                                  EnableRowVirtualization="True"
                                  ItemsSource="{Binding AnimationLibrary}"
                                  MouseDoubleClick="OnAnimationLibraryDoubleClick"
                                  SelectedItem="{Binding SelectedAnimationLibraryItem}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  PreviewMouseRightButtonDown="OnDataGridPreviewMouseRightButtonDown"
                                  Tag="{Binding}">
                                  <DataGrid.ContextMenu>
                                      <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                          <MenuItem Command="{Binding OpenSelectedAnimationCommand}" Header="_Open" />
                                          <MenuItem Command="{Binding ActivateSelectedAnimationCommand}" Header="_Activate" />
                                          <Separator />
                                          <MenuItem Command="{Binding AddAnimationTargetsCommand}" Header="Add _target to selected clip..." />
                                          <MenuItem Command="{Binding RenameSelectedAnimationCommand}" Header="_Rename" />
                                          <MenuItem Command="{Binding DuplicateSelectedAnimationCommand}" Header="_Duplicate" />
                                          <MenuItem Command="{Binding RebindSelectedAnimationSourceCommand}" Header="Re_bind source" />
                                          <Separator />
                                          <MenuItem Command="{Binding RevealSelectedAnimationSourceCommand}" Header="Re_veal source" />
                                          <MenuItem Command="{Binding RemoveSelectedAnimationCommand}" Header="Re_move" />
                                      </ContextMenu>
                                  </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="220" MinWidth="140" Binding="{Binding Name}" Header="Animation" />
                                <DataGridTextColumn Width="180" MinWidth="120" Binding="{Binding OriginModel}" Header="Origin" IsReadOnly="True" />
                                <DataGridTextColumn Width="180" MinWidth="120" Binding="{Binding TargetModel}" Header="Target" IsReadOnly="True" />
                                <DataGridTextColumn Width="150" MinWidth="110" Binding="{Binding BindingState}" Header="Binding" IsReadOnly="True" />
                                <DataGridTextColumn Width="170" MinWidth="110" Binding="{Binding PrimaryScript}" Header="SCR" IsReadOnly="True" />
                                <DataGridTextColumn Width="*" MinWidth="180" Binding="{Binding Diagnostics}" Header="Status" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem x:Name="RetargetTimelineTab" Header="Timeline / curves">
                        <views:TimelinePanel x:Name="RetargetTimelinePane"
                                             DataContext="{Binding Timeline}" />
                    </TabItem>
                </TabControl>

                <avalonDock:DockingManager x:Name="WorkflowDockManager"
                                           Grid.RowSpan="5"
                                           Grid.ColumnSpan="5"
                                           Panel.ZIndex="500"
                                           AllowMixedOrientation="True"
                                           AutoWindowSizeWhenOpened="True"
                                           Background="{StaticResource WindowBackgroundBrush}"
                                           GridSplitterHeight="6"
                                           GridSplitterWidth="6"
                                           IsVirtualizingAnchorable="True"
                                           IsVirtualizingDocument="True" />
            </Grid>

            <views:ModelsWorkspaceView x:Name="ModelsWorkspaceSurface"
                                       Grid.Row="2"
                                       Margin="8" />

            <Border x:Name="DiagnosticsDrawerPane"
                    Grid.Row="3"
                    Margin="8,0,8,8"
                    MaxHeight="250"
                    Style="{StaticResource PaneBorderStyle}"
                    Visibility="{Binding IsAnimationDiagnosticsDrawerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TabControl x:Name="DiagnosticsTabControl"
                            SelectedIndex="{Binding SelectedDiagnosticsTabIndex}">
                    <TabItem x:Name="JobsTab" Header="Jobs">
                        <Grid Margin="6">
                            <DataGrid AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      ItemsSource="{Binding Jobs}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="2*" Binding="{Binding Name}" Header="Job" />
                                    <DataGridTextColumn Width="*" Binding="{Binding Stage}" Header="Stage" />
                                    <DataGridTemplateColumn Width="2*" Header="Progress">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ProgressBar Height="12"
                                                             Maximum="100"
                                                             Value="{Binding Progress}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Width="*" Binding="{Binding State}" Header="State" />
                                    <DataGridTemplateColumn Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding CancelCommand}" Content="Cancel" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Background import, decode, retarget, and export jobs will appear here.">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Jobs.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </TabItem>

                    <TabItem x:Name="DiagnosticsTab" Header="Diagnostics">
                        <ListBox Margin="5" ItemsSource="{Binding Diagnostics}"
                            Tag="{Binding}">
                            <ListBox.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Command="{Binding CopyDiagnosticsCommand}" Header="_Copy all" />
                                    <MenuItem Command="{Binding ClearDiagnosticsCommand}" Header="C_lear" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="3,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="75" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="10"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding Timestamp, StringFormat={}{0:T}}" />
                                        <TextBlock Grid.Column="1"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Area}" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Message}" />
                                            <TextBlock FontSize="10"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="{Binding Detail}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>

                    <TabItem x:Name="FidelityTab" Header="Fidelity">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl Margin="8" ItemsSource="{Binding FidelityBadges}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                                            <TextBlock Grid.Column="1"
                                                       Foreground="{StaticResource WarningBrush}"
                                                       Text="{Binding State}" />
                                            <TextBlock Grid.Column="2"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="{Binding Detail}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </DockPanel>
</Window>
